# running in formal/bit_stuffer_fd_bmc/src/
# The ghdl Yosys command is provided by the ghdl-yosys-plugin in oss-cad-suite.
# It compiles VHDL with the LLVM-backend GHDL, then exports the netlist to Yosys.
# PSL assertions embedded via '-- psl' comments are picked up automatically.
plugin -i ghdl
ghdl -fpsl --std=08 \
  can_types_pkg.vhd \
  can_protocol_pkg.vhd \
  can_timing_pkg.vhd \
  bit_stuffer_fd.vhd \
  -e bit_stuffer_fd

# Prepare the netlist for the solver (flatten hierarchy, remove unused logic).
prep -top bit_stuffer_fd

hierarchy -smtcheck
rename -witness
write_jny -no-connections ../model/design.json
write_rtlil ../model/design.il
