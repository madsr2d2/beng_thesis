# SymbiYosys Formal Verification Job — bit_stuffer_fd
#
# Requirements verified: REQ-042 (dynamic bit stuffing), REQ-043 (SBC generation)
#
# Prerequisites (oss-cad-suite):
#   wget https://github.com/YosysHQ/oss-cad-suite-build/releases/latest/download/oss-cad-suite-linux-x64-<date>.tgz
#   tar xzf oss-cad-suite-linux-x64-<date>.tgz -C /opt
#   source /opt/oss-cad-suite/environment
#
# Usage (from project root):
#   sby formal/bit_stuffer_fd.sby bmc       # bounded check, fast
#   sby formal/bit_stuffer_fd.sby prove     # k-induction, exhaustive proof
#   sby formal/bit_stuffer_fd.sby           # both tasks

[options]
# BMC: falsification only — finds counterexamples within N cycles.
# Depth 25 covers 5x the stuffing threshold so any plausible run is reachable.

# Prove: k-induction — proves properties hold for ALL possible inputs forever.
# Uses the same depth for the induction base and step.
mode prove
depth 25

[engines]
# smtbmc z3 is available in oss-cad-suite; bitwuzla is faster if installed.
smtbmc z3

[script]
# The ghdl Yosys command is provided by the ghdl-yosys-plugin in oss-cad-suite.
# It compiles VHDL with the LLVM-backend GHDL, then exports the netlist to Yosys.
# PSL assertions embedded via '-- psl' comments are picked up automatically.
plugin -i ghdl
ghdl -fpsl --std=08 \
  can_types_pkg.vhd \
  can_protocol_pkg.vhd \
  can_timing_pkg.vhd \
  bit_stuffer_fd.vhd \
  -e bit_stuffer_fd

# Prepare the netlist for the solver (flatten hierarchy, remove unused logic).
prep -top bit_stuffer_fd

[files]
src/can_types_pkg.vhd
src/can_protocol_pkg.vhd
src/can_timing_pkg.vhd
src/bit_stuffer_fd.vhd
