[[requirement]]
id = "REQ-LLC-001"
source_clause = "ISO 11898-1:2015 §6.4.1"
original_wording = "The LLC sub-layer shall provide the following functions: flow control; recovery management; time-stamping."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is instantiated and operational"
postcondition = "The LLC sub-layer exposes flow control, recovery management, and time-stamping functions"
flags = ["COMPOUND"]
notes = "Three distinct capability claims: (1) flow control, (2) recovery management, (3) time-stamping. Each is elaborated in §6.5.2–6.5.7. Split candidate: one requirement per function. Assigned invariant/node because it constrains the behaviour of a specific controller instance."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-002"
source_clause = "ISO 11898-1:2015 §6.4.1"
original_wording = "The LLC sub-layer shall offer two types of connectionless transmission services to the LLC user, as specified in 6.4.5.2."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is instantiated and operational"
postcondition = "The LLC sub-layer offers both unacknowledged data transfer service and unacknowledged remote data request service"
flags = []
notes = "Capability invariant — the two service types must always be available. Elaborated in §6.4.5.2. No triggering event."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-003"
source_clause = "ISO 11898-1:2015 §6.4.1"
original_wording = "The interface service data sent from or to the user shall be as specified in 6.4.3."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An LLC frame is exchanged between the LLC user and LLC sub-layer"
postcondition = "The interface service data conforms to the LLC frame structure defined in Table 4 (§6.4.3)"
flags = []
notes = "Structural conformance invariant on the LLC service interface. No triggering event — every exchange must conform."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-004"
source_clause = "ISO 11898-1:2015 §6.4.3"
original_wording = "The LLC frame structure shall contain all content needed for all CAN frame formats and types, including the selection of a specific CAN frame format."
shape = "invariant"
scope = "frame"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An LLC frame is presented at the LLC sub-layer interface"
postcondition = "The LLC frame contains all fields defined in Table 4, including ID, Format, FTYP, BRS, ESI, DLC, and LLC data"
flags = []
notes = "Structural frame invariant on the LLC frame schema. Scope is frame because the constraint is on the field structure of the LLC SDU, not on node state. XL-specific fields (SDT, SEC, VCID, AF) are out of scope and ignored."
file = "can_pkg.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-005"
source_clause = "ISO 11898-1:2015 §6.4.3"
original_wording = "In the interaction between the LLC sub-layer and the MAC sublayer, the content of that parts of the LLC frame that are not used for the selected CAN frame format shall be ignored."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An LLC frame is passed from the LLC sub-layer to the MAC sub-layer"
postcondition = "Fields in the LLC frame not applicable to the selected CAN frame format are ignored and do not affect MAC behaviour"
flags = []
notes = "Implementation invariant ensuring unused fields cause no side-effects. For example, BRS and ESI are ignored when format is CB or CE. Verifiable in tx_mac_ser by confirming inapplicable bits do not alter output."
file = "tx_mac_ser.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-006"
source_clause = "ISO 11898-1:2015 §6.4.3"
original_wording = "Only LLC frames with the LLC format specified in Table 4 can be transferred to the LLC sub-layer."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame is presented at the LLC sub-layer input interface"
postcondition = "The LLC sub-layer rejects any frame whose Format field does not encode a valid format (000b=CBFF, 100b=CEFF, 010b=FBFF, 110b=FEFF)"
flags = []
notes = "Input validation invariant. XLFF=011b is out of scope. Other bit values are invalid and must be rejected."
file = "can_pkg.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-007"
source_clause = "ISO 11898-1:2015 §6.4.4"
original_wording = "If an LLC sub-layer is restricted to the use of a sub-range of identifiers (e.g. only 11-bit identifiers), then it shall be limited to LLC DFs and LLC RFs with identifiers of that sub-range (e.g. identifiers with their IDE bit set to logic 0 and their identifier extension is ignored)."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is configured with a restricted identifier sub-range"
postcondition = "The LLC sub-layer only processes LLC DFs and LLC RFs whose identifier falls within the configured sub-range; frames outside the sub-range are not transferred"
flags = []
notes = "Conditional implementation constraint — only applies when an identifier restriction is configured. The assertion must be parameterised by the configuration."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-008"
source_clause = "ISO 11898-1:2015 §6.4.4"
original_wording = "If an LLC sub-layer is restricted to the use of less than the maximum number of data bytes, then it shall be limited to LLC DFs with several data bytes of that restricted range. If the DLC indicates a higher number of data bytes, the data bytes beyond the restricted range shall be replaced in the LLC DF by bytes with the value of CC_HEX (\"padding\") both for received and for transmitted frames."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is configured with a restricted maximum data byte count and the DLC indicates more data bytes than the restricted maximum"
postcondition = "Data bytes beyond the restricted range are replaced with 0xCC padding bytes in both transmitted and received LLC DFs"
flags = ["COMPOUND"]
notes = "Two distinct sub-claims: (1) node is limited to DFs within the restricted byte range; (2) DLC-exceeding bytes are padded with 0xCC. Both TX and RX paths are affected. Split candidate if granular assertions are needed per direction."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-009"
source_clause = "ISO 11898-1:2015 §6.4.5.2"
original_wording = "The LLC sub-layer shall offer two types of connectionless-mode transmission services. Unacknowledged data transfer service — provides means by which LLC users exchange LSDU without establishing a data link connection. Unacknowledged remote data request service — provides means used by an LLC user to request a remote node for an LSDU transmission without establishing a data link connection."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is operational"
postcondition = "Both unacknowledged data transfer service and unacknowledged remote data request service are available at the LLC service access point"
flags = []
notes = "Capability invariant restating §6.4.1 with detail. Remote data request service is relevant to CB and CE (RTR frames). No triggering event."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-010"
source_clause = "ISO 11898-1:2015 §6.4.5.2"
original_wording = "The remote node shall serve the data request in the following two ways: The requested data may be prepared by the remote user for transmission. ; The requested data is transmitted by the remote user upon reception of the remote request frame."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE"
precondition = "A remote request frame addressed to this node has been received"
postcondition = "The node either prepares the requested data for transmission or immediately transmits the requested data upon reception"
flags = ["AMBIGUOUS"]
notes = "AMBIGUOUS: scope is borderline bus/node. Verification of a remote node responding to RTR inherently requires two interacting nodes. Assigned node/receiver as a pragmatic single-node simulation target. Consider reclassifying as bus/reachability. Format limited to CB/CE — RTR is only defined for Classic formats in this project scope."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-011"
source_clause = "ISO 11898-1:2015 §6.4.5.2"
original_wording = "The LLC sub-layer shall notify the successful transmission or reception of a DF or RF to the LLC user."
shape = "triggered"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An LLC DF or RF has been successfully transmitted or received"
event = "MAC sub-layer signals successful frame completion (Transfer_Status = Transmitted or frame reception complete)"
postcondition = "The LLC sub-layer issues an L_Data.Confirm (TX) or L_Data.Indication (RX) notification to the LLC user within 1 clock cycle of receiving the MAC completion signal"
flags = []
notes = "Triggered by MAC completion signal. Elaborated by §6.5.6 and §6.4.5.5.4/5. The MAC completion event is a one-cycle strobe from the MAC sub-layer."
file = ""

[[requirement]]
id = "REQ-LLC-012"
source_clause = "ISO 11898-1:2015 §6.4.5.5.2"
original_wording = "The L_Data.Request service shall be passed from the LLC user to the LLC sub-layer to request that an LLC frame is sent to one or more remote LLC entities."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC user wishes to transmit an LLC frame"
postcondition = "The LLC user passes an L_Data.Request primitive to the LLC sub-layer containing the LLC frame to be transmitted"
flags = []
notes = "Interface definition invariant — specifies the direction and purpose of the L_Data.Request service primitive. No triggering event."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-013"
source_clause = "ISO 11898-1:2015 §6.4.5.5.2"
original_wording = "Receipt of this service shall cause the LLC sub-layer to initiate the transfer of an LLC frame by use of the data transfer service provided by the MAC sub-layer (see 6.6)."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is in a state able to accept a new transmission request"
event = "L_Data.Request is received by the LLC sub-layer from the LLC user"
postcondition = "The LLC sub-layer initiates transfer of the LLC frame via the MAC sub-layer data transfer service"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer data transfer service (§6.6) being available. The event is the reception of the service primitive — a discrete one-cycle occurrence at the interface."
file = "tx_mac_ser.vhd"

[[requirement]]
id = "REQ-LLC-014"
source_clause = "ISO 11898-1:2015 §6.4.5.5.2"
original_wording = "Any L_Data.Request shall be processed not later than the second SOF after the request when there are no EFs present during this time."
shape = "liveness"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.Request has been received and no error frames are present on the bus"
postcondition = "The LLC sub-layer has initiated processing of the L_Data.Request by the time the second SOF following the request occurs"
flags = ["EXTERNAL_DEP"]
notes = "Liveness: the deadline is expressed in bus-event counts (SOFs), not fixed clock cycles. EXTERNAL_DEP: SOF timing and EF presence depend on MAC/bus activity external to the LLC module."
file = ""

[[requirement]]
id = "REQ-LLC-015"
source_clause = "ISO 11898-1:2015 §6.4.5.5.3"
original_wording = "The L_Data.AbortRequest service shall be passed from the LLC user to the LLC sub-layer to abort a previous request of an LLC frame transmission."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC user wishes to abort a previously requested LLC frame transmission"
postcondition = "The LLC user passes an L_Data.AbortRequest primitive to the LLC sub-layer identifying the LLC storage unit to abort"
flags = []
notes = "Interface definition invariant — specifies the direction and purpose of the L_Data.AbortRequest service primitive."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-016"
source_clause = "ISO 11898-1:2015 §6.4.5.5.3"
original_wording = "Receipt of this service shall cause the LLC sub-layer to abort the transfer of an LLC frame in the specified LLC storage unit. Pending transmissions, which are already passed to the MAC sub-layer, shall only be aborted if: an error in the MAC sub-layer during transmission occurs, or arbitration was lost in the MAC sub-layer, which causes the LLC frame to wait for another transmission attempt."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.AbortRequest has been received; the referenced frame is pending in the MAC sub-layer"
event = "A MAC-layer error or arbitration loss occurs, causing the frame to await a retransmission attempt"
postcondition = "The LLC sub-layer aborts the pending transmission and does not retransmit the frame"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: two distinct sub-claims — (1) abort is immediate for frames not yet passed to MAC; (2) abort of MAC-queued frames is deferred until MAC error or arbitration loss. EXTERNAL_DEP: depends on MAC sub-layer signalling error or arbitration-loss conditions."
file = "tx_mac_fsm.vhd"

[[requirement]]
id = "REQ-LLC-017"
source_clause = "ISO 11898-1:2015 §6.4.5.5.3"
original_wording = "This means that an abortion request shall be kept pending in the LLC layer until either one of the above situations occur, or until the transmission was completed."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.AbortRequest has been received and the referenced frame is actively being transmitted by the MAC sub-layer (no error and no arbitration loss has yet occurred)"
postcondition = "The LLC sub-layer retains the abort request in a pending state and does not discard it"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer reporting transmission completion, error, or arbitration-loss events. This invariant must hold for every cycle between AbortRequest reception and the qualifying MAC event."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-018"
source_clause = "ISO 11898-1:2015 §6.4.5.5.3"
original_wording = "Any L_Data.AbortRequest shall be processed prior to the second SOF after the request when there are no EFs present during this time. Any L_Data.AbortRequest shall be processed prior to the third SOF after the request when there are EFs present during this time."
shape = "liveness"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.AbortRequest has been received"
postcondition = "The L_Data.AbortRequest has been processed (abort executed or placed pending) within two SOFs (no EFs) or three SOFs (EFs present)"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: two timing bounds — one for the EF-free case, one for the EF-present case. EXTERNAL_DEP: SOF count and EF presence depend on bus activity. Liveness because the deadline is in bus-event counts, not fixed clock cycles."
file = ""

[[requirement]]
id = "REQ-LLC-019"
source_clause = "ISO 11898-1:2015 §6.4.5.5.4"
original_wording = "The L_Data.Confirm service shall be passed from the local LLC sub-layer to the LLC user to convey the results of the previous L_Data.Request service. This service shall be a local confirmation, i.e. it shall not imply that the remote LLC entity or entities are passing the associated indication service to the corresponding LLC user(s)."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A previous L_Data.Request has been processed (transmission completed, aborted, or disturbed)"
event = "The MAC sub-layer signals the final outcome of the requested frame transmission"
postcondition = "The LLC sub-layer passes an L_Data.Confirm primitive to the LLC user carrying the Transfer_Status of the transaction"
flags = []
notes = "The confirmation is strictly local — it does not imply remote reception. The event is the MAC outcome signal, which is a discrete one-cycle strobe."
file = ""

[[requirement]]
id = "REQ-LLC-020"
source_clause = "ISO 11898-1:2015 §6.4.5.5.4"
original_wording = "The Transfer_Status shall be used to indicate the status of the transaction initiated by the previous L_Data.Request service. Transfer_Status: [Ongoing, Lost Arbitration, Transmitted, Aborted, Disturbed]"
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.Request has been issued and its associated L_Data.Confirm has not yet been delivered"
postcondition = "The Transfer_Status field of the L_Data.Confirm is one of: Ongoing, Lost_Arbitration, Transmitted, Aborted, or Disturbed, matching the actual MAC transaction state"
flags = []
notes = "Invariant on the Transfer_Status encoding — every valid state must be representable and correctly assigned. Elaborated by §6.5.6 (REQ-LLC-032)."
file = "tx_mac_fsm.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-021"
source_clause = "ISO 11898-1:2015 §6.4.5.5.4"
original_wording = "The timestamp is a 64-bit value, captured at one time reference point synchronized to MAC frame transmission. The timestamp is valid when the Transfer_Status is transmitted. Otherwise, the timestamp value is undefined."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.Confirm is issued by the LLC sub-layer"
postcondition = "When Transfer_Status is Transmitted, the timestamp field is a valid 64-bit value captured at the MAC time reference point; when Transfer_Status is not Transmitted, the timestamp value may be any value (undefined)"
flags = ["COMPOUND"]
notes = "COMPOUND: two sub-claims — (1) timestamp is 64-bit and valid when Transfer_Status is Transmitted; (2) timestamp is undefined for non-Transmitted statuses. Split candidate if separate assertions are needed. See also §6.5.7 (REQ-LLC-033–038)."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-022"
source_clause = "ISO 11898-1:2015 §6.4.5.5.5"
original_wording = "The L_Data.Indication service shall be passed from the LLC sub-layer to the LLC user to indicate the arrival of the data of an LLC frame after the reception of a MAC frame."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is operational and monitoring for received MAC frames"
event = "A valid MAC frame reception completes (MAC signals frame received successfully)"
postcondition = "The LLC sub-layer passes an L_Data.Indication primitive to the LLC user containing the received LLC frame data"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer signalling successful frame reception. The event is a discrete one-cycle completion signal from the MAC sub-layer."
file = ""

[[requirement]]
id = "REQ-LLC-023"
source_clause = "ISO 11898-1:2015 §6.5.2"
original_wording = "The transmission of frames losing bus arbitration shall be restarted by the LLC entity unless the transmission of that frame is aborted by the LLC user."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node has lost bus arbitration for a frame and the LLC user has not issued an L_Data.AbortRequest for that frame"
event = "The MAC sub-layer signals arbitration loss for the current frame transmission"
postcondition = "The LLC sub-layer schedules the frame for re-arbitration (resubmits it to the MAC sub-layer at the next available opportunity)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer reporting arbitration loss. The abort exception is handled by REQ-LLC-016. Re-arbitration timing depends on bus availability."
file = "tx_mac_fsm.vhd"

[[requirement]]
id = "REQ-LLC-024"
source_clause = "ISO 11898-1:2015 §6.5.3"
original_wording = "The retransmission of frames that are not aborted by the LLC user shall be attempted for the configured specific number of times. Retransmission attempts shall be counted in the retransmission counter. The node's retransmission counter shall be incremented by one at each retransmission when the node's preceding transmission attempt for the same frame was not successful for any reason except lost bus arbitration."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame transmission has failed for a reason other than lost bus arbitration and the frame has not been aborted by the LLC user"
event = "A retransmission attempt for the same frame is initiated"
postcondition = "The retransmission counter is incremented by one"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) retransmission is attempted up to the configured limit; (2) retransmission counter is incremented per attempt (excluding arbitration-loss); (3) counter reset is covered by REQ-LLC-026. Split recommended for granular assertions on counter increment vs. attempt limit enforcement."
file = "tx_mac_fsm.vhd"

[[requirement]]
id = "REQ-LLC-025"
source_clause = "ISO 11898-1:2015 §6.5.3"
original_wording = "The configured number shall be in the following range: from 0 (no retransmission), to at least 6 (6 retransmission attempts), — and the highest number in this range may allow unlimited retransmission attempts."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer retransmission limit is configured"
postcondition = "The configured retransmission limit is a value in the range [0, ≥6], where the maximum configuration supports unlimited retransmission attempts"
flags = []
notes = "Structural constraint on the configuration parameter range. Verifiable by inspecting the configuration register width and limit-enforcement logic."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-026"
source_clause = "ISO 11898-1:2015 §6.5.3"
original_wording = "The node's retransmission counter shall be reset to zero when a transmission is successful or when the LLC user requests a new transmission."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A retransmission counter is maintained for the current frame"
event = "Transmission completes successfully (Transfer_Status = Transmitted) or LLC user issues a new L_Data.Request"
postcondition = "The retransmission counter is reset to zero within 1 clock cycle"
flags = []
notes = "Two triggering conditions map to the same postcondition. Both are discrete one-cycle events. A single triggered block covers both via a disjunctive event condition."
file = "tx_mac_fsm.vhd"

[[requirement]]
id = "REQ-LLC-027"
source_clause = "ISO 11898-1:2015 §6.5.3"
original_wording = "Nodes that do not support the XL frame format are not required to implement the retransmission counter, but they shall support unlimited retransmissions."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node does not implement the XL frame format (which is the case for this project)"
postcondition = "The node supports unlimited retransmissions (retransmission counter implementation is not required)"
flags = []
notes = "Since this project explicitly excludes XL frames, this requirement mandates unlimited retransmission support without a counter. Counter-based limit requirements (REQ-LLC-024, REQ-LLC-025) apply only if the XL frame counter is optionally implemented."
file = "tx_mac_fsm.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-028"
source_clause = "ISO 11898-1:2015 §6.5.4"
original_wording = "Each receiver should decide by frame acceptance filtering whether the frame is relevant or not. Acceptance filtering is a frame transaction initiated at the LLC sub-layer, it should be a single, self-contained operation independent of previous frame transactions."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A MAC frame has been received"
postcondition = "The LLC sub-layer applies acceptance filtering to determine relevance; the filtering operation is self-contained and independent of prior frame transactions"
flags = ["SHOULD"]
notes = "SHOULD: both normative statements use 'should', not 'shall'. Acceptance filtering is a receiver-side LLC function. 'Self-contained' is an architectural guideline — verifiable by ensuring the filter decision references only the current frame."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-029"
source_clause = "ISO 11898-1:2015 §6.5.5"
original_wording = "The transmission of a OF shall be initiated by the LLC sub-layer if internal conditions of a receiver require delay of the next LLC DF or LLC RF."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is operating as a receiver and has detected internal conditions requiring delay of the next data or remote frame"
event = "Internal receiver condition triggering overload is detected"
postcondition = "The LLC sub-layer initiates transmission of an Overload Frame"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: the internal conditions that trigger an OF are implementation-specific and must be documented per node (see REQ-LLC-030). The event is the detection of the internal condition — a one-cycle recognition signal."
file = "tx_mac_fsm.vhd"

[[requirement]]
id = "REQ-LLC-030"
source_clause = "ISO 11898-1:2015 §6.5.5"
original_wording = "If there are internal conditions of a CAN node that cause a OF to be initiated, these conditions shall be documented for that CAN node."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The CAN node implementation supports overload frame generation"
postcondition = "The internal conditions that can cause an overload frame are documented in the node specification"
flags = []
notes = "Documentation/traceability invariant. Not directly assertable in RTL simulation — this is a design documentation requirement. Noted for completeness and traceability."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-031"
source_clause = "ISO 11898-1:2015 §6.5.5"
original_wording = "In this case, the CAN node shall not generate more than two OFs."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer has initiated at least one overload frame in response to an internal condition"
postcondition = "The total number of consecutive overload frames generated for that internal condition does not exceed two"
flags = []
notes = "Structural limit on OF generation. Verifiable by counting OF transmissions per internal-condition event. The 'in this case' qualifier refers to internal-condition-triggered OFs specifically."
file = "tx_mac_fsm.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-032"
source_clause = "ISO 11898-1:2015 §6.5.6"
original_wording = "The LLC sub-layer's transmission service shall report the Transfer_Status of a requested transmission as Ongoing when the MAC has started that transmission. It shall report the Transfer_Status as Transmitted when that transmission is successfully completed. It shall report the Transfer_Status as Lost_Arbitration when that transmission loses the bus arbitration, until the frame is started again or aborted. It shall report the Transfer_Status as Disturbed when that transmission is disturbed by an error or is not acknowledged, until the frame is started again or aborted. It shall report the Transfer_Status as Aborted when that transmission is not successful and is not retransmitted because the frame is aborted, or its retransmission limit is reached."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.Request has been issued and its associated transmission is in progress"
postcondition = "The Transfer_Status value correctly reflects the current MAC transmission state: Ongoing (MAC transmitting), Transmitted (success), Lost_Arbitration (arbitration lost, pending retry or abort), Disturbed (error or no ACK, pending retry or abort), Aborted (aborted or retransmission limit reached)"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: five distinct Transfer_Status assignments, each with its own condition. Split into five separate triggered requirements if granular FSM-state assertions are needed. EXTERNAL_DEP: each status depends on MAC sub-layer signalling (start, success, arbitration loss, error/no-ACK). This is the central recovery management invariant."
file = "tx_mac_fsm.vhd"
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-033"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "The time-base and time-stamps shall have a length of 64 bit."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "Time-stamping is supported by the LLC sub-layer"
postcondition = "The time-base register and all timestamp fields are exactly 64 bits wide"
flags = []
notes = "Structural width invariant. Straightforwardly verifiable from the signal declaration."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-034"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "When time-stamping is not supported, time-base and time-stamps shall be treated as constants with the value 0."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer does not support time-stamping"
postcondition = "The time-base and all timestamp fields are permanently driven to zero"
flags = []
notes = "Conditional structural invariant for the no-timestamping configuration. Verifiable by asserting timestamp outputs equal zero when timestamping is disabled."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-035"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "The time-base shall be captured at time reference points signalled by the MAC sub-layer (see 6.6.3); the captured values shall be reported as time-stamps by the services L_Data.Confirm and L_Data.Indication."
shape = "triggered"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "Time-stamping is supported; the LLC sub-layer is operational"
event = "The MAC sub-layer signals a time reference point (per §6.6.3)"
postcondition = "The LLC sub-layer captures the current time-base value and reports it as the timestamp in the subsequent L_Data.Confirm or L_Data.Indication primitive"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer time reference point signal (§6.6.3). The event is the MAC time reference strobe — a discrete one-cycle signal."
file = ""

[[requirement]]
id = "REQ-LLC-036"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "It shall be configurable whether the time reference point at the SOF recognition or at the position when the frame gets valid shall be used for capturing."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "Time-stamping is supported by the LLC sub-layer"
postcondition = "A configuration parameter selects between the SOF time reference point and the frame-valid time reference point for timestamp capture"
flags = []
notes = "Configuration capability invariant — the timestamping reference point must be selectable. Verifiable by confirming the configuration register bit exists and controls the mux between the two capture points."
file = ""
label = "test_label_invariant"

[[requirement]]
id = "REQ-LLC-037"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "For the service L_Data.Confirm, a time-stamp shall be captured at the time reference point of the transmission of the MAC frame."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "Time-stamping is supported; a MAC frame transmission is in progress"
event = "The MAC sub-layer signals the time reference point for the transmitted frame"
postcondition = "The LLC sub-layer captures the timestamp at that reference point and includes it in the L_Data.Confirm primitive"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer time reference point signal for TX path. Specialisation of REQ-LLC-035 for the transmit path."
file = ""

[[requirement]]
id = "REQ-LLC-038"
source_clause = "ISO 11898-1:2015 §6.5.7"
original_wording = "For the service L_Data.Indication, a time-stamp shall be captured at the time reference point of the reception of the MAC frame."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "Time-stamping is supported; a MAC frame reception is in progress"
event = "The MAC sub-layer signals the time reference point for the received frame"
postcondition = "The LLC sub-layer captures the timestamp at that reference point and includes it in the L_Data.Indication primitive"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: depends on MAC sub-layer time reference point signal for RX path. Specialisation of REQ-LLC-035 for the receive path."
file = ""
