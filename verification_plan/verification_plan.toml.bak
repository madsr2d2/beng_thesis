[[requirement]]
id = "REQ-036"
source_clause = "§6.4.4"
original_wording = "If the DLC indicates a higher number of data bytes, the data bytes beyond the restricted range shall be replaced in the LLC DF by bytes with the value of CCHEX ('padding') both for received and for transmitted frames."
paraphrase = "An LLC restricted to fewer bytes shall replace excess bytes with 0xCC padding in both TX and RX directions."
group_title = "DLC padding"
layer = "LLC"
side = "both"
format_applicability = "CB, CE, FB, FE"
observability = "black_box"
verification_method = "simulation"
priority = "P3"
status = "not_started"
notes = "Only applicable if the implementation exposes a configurable maximum-data-byte restriction. If not implemented, waive."
coverage_criteria = ""
label = ""
file = ""
[[requirement]]
id = "REQ-037"
source_clause = "§5.2, Figure 2"
original_wording = "Figure 2 shows the DFs and RFs specified in this document."
paraphrase = "1) CBFF DF: SOF (D) → Arbitration (ID[28:18], RTR (D)) → Control (IDE (D), r0 (D), DLC[3:0]) → Data → CRC (CRC_15, delimiter (R)) → ACK (slot, delimiter (R)) → EOF (7×R).\n2) CBFF RF: as CBFF DF but RTR (R) and no data field.\n3) CEFF DF: SOF (D) → Arbitration (ID[28:18], SRR (R), IDE (R), ID[17:0], RTR (D)) → Control (r1 (D), r0 (D), DLC[3:0]) → Data → CRC (CRC_15, delimiter (R)) → ACK (slot, delimiter (R)) → EOF (7×R).\n4) CEFF RF: as CEFF DF but RTR (R) and no data field.\n5) FBFF DF: SOF (D) → Arbitration (ID[28:18], RRS (D)) → Control (IDE (D), FDF (R), res (D), BRS, ESI, DLC[3:0]) → Data (FD rate) → CRC (SBC[3:0], CRC_17/21, delimiter (R)) → ACK (slot, delimiter (R)) → EOF (7×R).\n6) FEFF DF: SOF (D) → Arbitration (ID[28:18], SRR (R), IDE (R), ID[17:0], RRS (D)) → Control (FDF (R), res (D), BRS, ESI, DLC[3:0]) → Data (FD rate) → CRC (SBC[3:0], CRC_17/21, delimiter (R)) → ACK (slot, delimiter (R)) → EOF (7×R)."
group_title = "Frame field sequence"
layer = "MAC"
side = "both"
format_applicability = "CB, CE, FB, FE"
observability = "white_box"
verification_method = "waveform_inspection"
priority = "P1"
status = "complete"
notes = "Notation: (D) = dominant, (R) = recessive. Unannotated bits (ID, DLC, BRS, ESI, CRC value, SBC, ACK slot) are data-dependent or conditional."
coverage_criteria = ""
label = "test_normal"
file = "can_bus_controller_fd/can_mac_pcs_fce/hdl_tb/can_mac_pcs_fce_tb.vhd"
