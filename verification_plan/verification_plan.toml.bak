observability_rationale = "[Rule 1a] The output symbol (level_0/level_1) is a named parameter of the PCS↔PMA primitive; it directly corresponds to the Output_Unit parameter of `PCS_Data.Request(Output_Unit)` at the MAC↔PCS boundary — both are named primitive parameters observable without any internal algorithm"

[[requirement]]
id = "REQ-PCS-035"
source_clause = "§7.4.2.2"
original_wording = "The PCS shall send a bus_off symbol to the PMA sub-layer, when it receives a bus_off_request from the supervisor (see 8.1.3.4)."
shape = "triggered"
