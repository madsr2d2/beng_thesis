format_applicability = "CB, CE, FB, FE"
precondition = "The PCS is operational; a `Bus_off_request` primitive has been issued at the PCS↔FCE boundary (FCE supervisor signalling bus-off condition)"
event = "A bus_off_request is received from the FCE supervisor"
postcondition = "The PCS sends a bus_off symbol to the PMA sub-layer in response to `Bus_off_request`; the bus_off symbol is a named primitive parameter directly observable at the PCS↔PMA boundary without any internal algorithm"
