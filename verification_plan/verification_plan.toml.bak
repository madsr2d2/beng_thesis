# ── §6.5.4 Frame acceptance filtering ──
observability = "derived"
observability_rationale = "Retransmission attempts observable as repeated frame transmissions at MAC↔PCS boundary. Verifying the configured retry limit requires tracking internal retransmission count against retransmission_limit config. [Rule 2]"

[[requirement]]
id = "REQ-LLC-013"
source_clause = "§6.5.4"
original_wording = "Each receiver should decide by frame acceptance filtering whether the frame is relevant or not. ; Acceptance filtering is a frame transaction initiated at the LLC sub-layer, it should be a single, self-contained operation independent of previous frame transactions."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A MAC frame has been received"
postcondition = "The receiver applies frame acceptance filtering as a single, self-contained operation to determine frame relevance"
flags = ["SHOULD"]
notes = "SHOULD: wording uses 'should' (recommendation) not 'shall' (mandatory). Frame acceptance filtering is recommended but not strictly required. All four formats may be subject to filtering."
label = ""
file = ""

# ── §6.5.5 Overload notification ──
observability = "derived"
observability_rationale = "Frame acceptance filtering outcome observable at LLC↔User boundary via presence/absence of L_Data.Indication. Verifying filter independence requires multi-frame protocol knowledge. [Rule 2]"

[[requirement]]
id = "REQ-LLC-014"
source_clause = "§6.5.5"
original_wording = "The transmission of a OF shall be initiated by the LLC sub-layer if internal conditions of a receiver require delay of the next LLC DF or LLC RF."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The receiver's internal conditions require delay of the next LLC DF or LLC RF"
event = "The inter-frame space begins after the current frame"
postcondition = "The LLC sub-layer initiates transmission of an overload frame (OF)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: the overload frame itself is defined in the MAC sub-layer (§6.6.6). The LLC layer decides when to initiate it, but the OF structure and encoding are MAC-layer concerns. All four formats may precede an OF."
label = ""
file = ""

# NOTE: Probably relevant for our implementation, but included here for completeness and traceability to the standard. These are documentation obligations without direct RTL assertions.
# 
# [[requirement]]
# id = "REQ-LLC-026"
# source_clause = "§6.5.5"
# original_wording = "If there are internal conditions of a CAN node that cause a OF to be initiated, these conditions shall be documented for that CAN node."
# shape = "invariant"
# scope = "node"
# layer = "LLC"
# format_applicability = "CB, CE, FB, FE"
# precondition = "The CAN node implementation supports overload frame generation"
# postcondition = "The internal conditions that can cause an overload frame are documented in the node specification"
# flags = ["DOC_ONLY"]
# notes = "Documentation obligation — no RTL signal can be asserted against 'conditions are documented'. Retained for completeness and requirements traceability."
# label = ""
# file = ""
observability = "internal"
observability_rationale = "OF initiation triggered by internal receiver conditions. The precondition (internal conditions require delay) is not observable at any LLC boundary. The OF itself appears on the bus but the trigger decision is internal. [Rule 3 — no boundary effect for precondition]"

[[requirement]]
id = "REQ-LLC-015"
source_clause = "§6.5.6"
original_wording = "The LLC sub-layer's transmission service shall report the Transfer_Status of a requested transmission as Ongoing when the MAC has started that transmission. ; It shall report the Transfer_Status as Transmitted when that transmission is successfully completed. ; It shall report the Transfer_Status as Lost_Arbitration when that transmission loses the bus arbitration, until the frame is started again or aborted. ; It shall report the Transfer_Status as Disturbed when that transmission is disturbed by an error or is not acknowledged, until the frame is started again or aborted. ; It shall report the Transfer_Status as Aborted when that transmission is not successful and is not retransmitted because the frame is aborted, or its retransmission limit is reached."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A transmission has been requested via `L_Data.Request(Frame, Handle)` at LLC↔User boundary; MAC is handling the frame"
postcondition = "`L_Data.Confirm(Transfer_Status, Timestamp, Handle)` is issued at LLC↔User boundary with Transfer_Status set to: `Ongoing` when MAC starts transmission; `Transmitted` when transmission completes successfully; `Lost_Arbitration` when arbitration is lost (until restarted or aborted); `Disturbed` when an error or missing ACK is detected (until restarted or aborted); `Aborted` when the frame is not retransmitted due to abort request or retransmission limit reached"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: five distinct sub-claims, one per Transfer_Status value: (1) Ongoing when MAC starts; (2) Transmitted on success; (3) Lost_Arbitration on arbitration loss; (4) Disturbed on error/no-ACK; (5) Aborted when not retransmitted. Each sub-claim is independently assertable. EXTERNAL_DEP: all trigger conditions originate from the MAC sub-layer. All four formats share the same Transfer_Status reporting."
label = ""
file = ""

# ── §6.5.7 Time stamping ──
# NOTE: The rest of the LLC requirements are related to time stamping. Not supported in this implementation
# 

# [[requirement]]
# id = "REQ-LLC-029"
# source_clause = "§6.5.7"
# original_wording = "The time-base and time-stamps shall have a length of 64 bit."
# shape = "invariant"
# scope = "node"
# side = "both"
# layer = "LLC"
# format_applicability = "CB, CE, FB, FE"
# precondition = "The node implements time-stamping"
# postcondition = "The time-base and all time-stamp values are 64 bits wide"
# flags = []
# notes = "Structural constraint on register width. Assertable by checking signal widths. All four formats use the same time-stamping infrastructure."
# label = ""
# file = ""
#
# [[requirement]]
# id = "REQ-LLC-030"
# source_clause = "§6.5.7"
# original_wording = "When time-stamping is not supported, time-base and time-stamps shall be treated as constants with the value 0."
# shape = "invariant"
# scope = "node"
# side = "both"
# layer = "LLC"
# format_applicability = "CB, CE, FB, FE"
