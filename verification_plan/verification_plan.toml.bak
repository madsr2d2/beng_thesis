# === SECTION SUMMARY: §6.4 + §6.5 — LLC sub-layer ===
# Requirements output: 15
#   triggered:       5  (REQ-LLC-005, REQ-LLC-006, REQ-LLC-008, REQ-LLC-011, REQ-LLC-014)
#   invariant:       8  (REQ-LLC-001, REQ-LLC-002, REQ-LLC-003, REQ-LLC-004, REQ-LLC-009, REQ-LLC-012, REQ-LLC-013, REQ-LLC-015)
#   liveness:        2  (REQ-LLC-007, REQ-LLC-010)
#   reachability:    0
# Flags raised:
#   COMPOUND:        6  (REQ-LLC-001, REQ-LLC-003, REQ-LLC-009, REQ-LLC-010, REQ-LLC-012, REQ-LLC-015)
#   AMBIGUOUS:       1  (REQ-LLC-004)
#   EXTERNAL_DEP:    6  (REQ-LLC-005, REQ-LLC-006, REQ-LLC-009, REQ-LLC-011, REQ-LLC-014, REQ-LLC-015)
#   SHOULD:          1  (REQ-LLC-013)
#   DOC_ONLY:        2  (REQ-LLC-001, REQ-LLC-004)
# ===

# ============================================================
# SECTION: §6.6 — MAC sub-layer

# ============================================================
# === SECTION INVENTORY: §6.6 — MAC sub-layer (layer = MAC) ===
# Subsections covered: §6.6.1, §6.6.2, §6.6.3, §6.6.4.1–6.6.4.4, §6.6.5.1–6.6.5.3,
#   §6.6.6.1–6.6.6.3, §6.6.7.1–6.6.7.5, §6.6.8, §6.6.9, §6.6.10.1–6.6.10.7,
#   §6.6.11.1–6.6.11.7, §6.6.13.1–6.6.13.3.1, §6.6.14, §6.6.15.1–6.6.15.2,
#   §6.6.16, §6.6.17.1–6.6.17.6, §6.6.18, §6.6.19, §6.6.20, §6.6.21.1–6.6.21.3.4
# Skipped: §6.6.12 (XLFF = CAN XL, out of scope), §6.6.13.3.2 (XL data phase),
#   §6.6.15.3 and §6.6.21.4 (error signalling disabled = primarily XL context)
# Requirement count lower bound: 80
# Cross-section dependencies noted:
#   - §6.6.17.2 protocol exception → FCE error counters unchanged
#   - §6.6.19 restricted operation → FCE error counters unchanged
#   - §6.6.21.3.4 error counting → §8.1.4 FCE rules
#   - §6.6.7.5 bus re-integration → bus-off recovery condition (§8.2 FCE)
#   - §6.6.3 time reference points → LLC timestamp capture (§6.4.5.5)
#   - §6.6.11.3 ESI → FCE error state (Error Active/Passive)
# ===

# ── §6.6.1 Functions and rules — no normative "shall" statements (descriptive list) ──

# ── §6.6.2 Services of the MAC sub-layer ──
observability = "external"
observability_rationale = "[Rule 1a] Transfer_Status is a named parameter of `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` at the LLC↔User boundary; all five status values (Ongoing, Transmitted, Lost_Arbitration, Disturbed, Aborted) are enumerated in ISO §6.4.5 and directly inspectable by the testbench at the LLC↔User boundary without requiring knowledge of MAC internals."

[[requirement]]
id = "REQ-MAC-001"
source_clause = "§6.6.4.1"
original_wording = "DFs and RFs shall arbitrate for bus access and shall be separated from preceding frames by an inter-frame space."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received an LLC frame SDU + Handle via the LLC↔MAC boundary; the MAC↔PCS boundary is active"
postcondition = "(1) MAC participates in bus arbitration by issuing `PCS_Data.Request(Output_Unit=dominant/recessive)` per arbitration field bits and reading back `PCS_Data.Indicate` to detect loss; (2) MAC precedes the SOF with an inter-frame space, issuing three recessive `PCS_Data.Request` calls for intermission before any SOF dominant bit"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) arbitrate for bus access; (2) separated by inter-frame space. Both sub-claims are detailed in later subsections (§6.6.17 and §6.6.7). All four in-scope formats participate in arbitration. RF applies only to CB and CE."
label = ""
file = ""

# ── §6.6.4.2 MAC frame transmission — capability list ──
observability = "external"
observability_rationale = "Both sub-claims are directly observable at MAC↔PCS boundary: (1) arbitration — `PCS_Data.Request(Output_Unit)` sequence during arbitration field, combined with `PCS_Data.Indicate` readback to detect loss; (2) IFS — three recessive `PCS_Data.Request` calls before SOF. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-002"
source_clause = "§6.6.4.4"
original_wording = "The first polynomial, CRC_15, shall be used for CC frames."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "A CC frame (CBFF or CEFF) is being assembled and `PCS_Data.Request(Output_Unit)` calls are being issued for the CRC field bits at the MAC↔PCS boundary"
postcondition = "The 15-bit FCRC field appears as a sequence of `PCS_Data.Request(Output_Unit=X)` calls at the MAC↔PCS boundary; correct values require applying the CRC_15 polynomial (generator 0xC599) to the bit stream from SOF through the last data bit (verification requires independent polynomial computation)"
flags = []
notes = "CRC polynomial selection for Classic CAN. Only CB and CE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The 15-bit FCRC field manifests as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying correctness requires applying the CRC_15(0xC599) polynomial to the de-stuffed bit stream — a non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-003"
source_clause = "§6.6.4.4"
original_wording = "The second, CRC_17, shall be used for FD frames with a data field up to 16 byte long."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame with data field ≤16 bytes is being assembled and `PCS_Data.Request(Output_Unit)` calls are being issued for the CRC field bits at the MAC↔PCS boundary"
postcondition = "The 17-bit FCRC field appears as a sequence of `PCS_Data.Request(Output_Unit=X)` calls at the MAC↔PCS boundary; correct values require applying the CRC_17 polynomial (generator 0x3685B) to the FD bit stream including dynamic stuff bits and stuff count (verification requires independent polynomial computation)"
flags = []
notes = "CRC polynomial selection for short FD frames. Only FB and FE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The 17-bit FCRC field manifests as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying correctness requires applying the CRC_17(0x3685B) polynomial to the FD bit stream (including dynamic stuff bits and stuff count) — a non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-004"
source_clause = "§6.6.4.4"
original_wording = "The third, CRC_21, shall be used for FD frames with a data field longer than 16 byte."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame with data field >16 bytes is being assembled and `PCS_Data.Request(Output_Unit)` calls are being issued for the CRC field bits at the MAC↔PCS boundary"
postcondition = "The 21-bit FCRC field appears as a sequence of `PCS_Data.Request(Output_Unit=X)` calls at the MAC↔PCS boundary; correct values require applying the CRC_21 polynomial (generator 0x302899) to the FD bit stream including dynamic stuff bits and stuff count (verification requires independent polynomial computation)"
flags = []
notes = "CRC polynomial selection for long FD frames. Only FB and FE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The 21-bit FCRC field manifests as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying correctness requires applying the CRC_21(0x302899) polynomial to the FD bit stream (including dynamic stuff bits and stuff count) — a non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-005"
source_clause = "§6.6.4.4"
original_wording = "At the SOF, the five specified CRC sequences shall be calculated concurrently by the transmitting nodes and the receiving nodes."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame transmission or reception has begun (SOF detected)"
postcondition = "All applicable CRC sequences are calculated concurrently from SOF onwards by both TX and RX nodes"
flags = []
notes = "The standard specifies five CRC sequences (CRC_13, 15, 17, 21, 32) calculated in parallel. For this project (no XL), CRC_13 and CRC_32 are not needed, but CRC_15, CRC_17, and CRC_21 must run concurrently. All four in-scope formats require concurrent CRC calculation."
label = ""
file = ""
observability = "internal"
observability_rationale = "CRC results are observable at MAC↔PCS boundary (derived), but the postcondition specifically requires concurrent calculation. Concurrency is an internal implementation constraint with no boundary manifestation. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-MAC-006"
source_clause = "§6.6.4.4"
original_wording = "The receivers shall consider only the selected CRC polynomials to check for a CRC-error."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame has been received: all `PCS_Data.Indicate(Input_Unit)` calls for the CRC field have been delivered to the MAC, and the frame format and DLC are known"
postcondition = "The receiver applies the correct polynomial to the `PCS_Data.Indicate(Input_Unit)` bit stream from SOF through CRC field; a CRC mismatch causes `Error(CRC)` to be signalled at the MAC↔FCE boundary (verification requires independently computing the selected polynomial over the received bit stream)"
flags = []
notes = "Selection is determined by format (CC→CRC_15) and for FD by DLC (≤16 bytes→CRC_17, >16→CRC_21). All four in-scope formats are covered."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The CRC check result manifests as `Error(CRC)` at the MAC↔FCE boundary, but verifying that the correct polynomial was selected (based on format and DLC) requires independently computing the polynomial over the `PCS_Data.Indicate(Input_Unit)` stream — non-trivial algorithm"

[[requirement]]
id = "REQ-MAC-007"
source_clause = "§6.6.4.4"
original_wording = "The CRC_INIT_VECTOR shall be (0,...,0) for CRC_15."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "A CC frame (CBFF or CEFF) CRC_15 calculation is being initialized before the first `PCS_Data.Request(Output_Unit)` call for SOF"
postcondition = "The CRC_15 shift register is initialized to all zeros before the first bit of the input stream is processed; this affects the `PCS_Data.Request(Output_Unit)` values in the FCRC field (verification requires independent CRC_15 computation with zero init vector)"
flags = []
notes = "Init vector for Classic CAN CRC. Only CB and CE use CRC_15."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The init vector affects the FCRC bits in `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying the correct init vector was used requires independently computing CRC_15 with a zero init vector and comparing against the observed FCRC — non-trivial algorithm"

[[requirement]]
id = "REQ-MAC-008"
source_clause = "§6.6.4.4"
original_wording = "The CRC_INIT_VECTOR shall be (1,0,...,0) for CRC_17 and for CRC_21; where the single 1 is at the most significant bit position."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame CRC_17 or CRC_21 calculation is being initialized before the first `PCS_Data.Request(Output_Unit)` call for SOF"
postcondition = "The CRC_17 or CRC_21 shift register is initialized with MSB=1 and all other bits zero before the first bit of the input stream is processed; this affects the `PCS_Data.Request(Output_Unit)` values in the FCRC field (verification requires independent CRC computation with this init vector)"
flags = []
notes = "Init vector for FD CRC. Only FB and FE use CRC_17/CRC_21."
label = ""
file = ""

# ── §6.6.5.2 Error flag ──
observability = "derived"
observability_rationale = "[Rule 2] The init vector affects the FCRC bits in `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying the correct init vector (MSB=1, rest=0) was used requires independently computing CRC_17 or CRC_21 with this specific init vector — non-trivial algorithm"

[[requirement]]
id = "REQ-MAC-009"
source_clause = "§6.6.5.2"
original_wording = "The active error flag shall consist of six consecutive dominant bits."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received `Error_active_request` from FCE (node is error-active); MAC is transmitting an error flag"
postcondition = "MAC issues exactly six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls to PCS, forming the active error flag"
flags = []
notes = "Structural definition of active error flag. All four formats share the same error flag structure."
label = ""
file = ""
observability = "external"
observability_rationale = "Six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls at MAC↔PCS boundary are directly countable. Testbench observes all Output_Unit values without any internal knowledge. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-010"
source_clause = "§6.6.5.2"
original_wording = "The passive error flag shall consist of six consecutive recessive bits unless it is overwritten by dominant bits from other nodes."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received `Error_passive_request` from FCE (node is error-passive); MAC is transmitting an error flag"
postcondition = "MAC issues exactly six consecutive `PCS_Data.Request(Output_Unit=recessive)` calls to PCS (passive error flag); the observed bus level may be dominant if other nodes transmit dominant bits"
flags = []
notes = "The 'unless overwritten' clause means the transmitted value is always six recessive bits, but the observed bus value may be dominant. All four formats share the same error flag structure."
label = ""
file = ""
observability = "external"
observability_rationale = "Six consecutive `PCS_Data.Request(Output_Unit=recessive)` calls at MAC↔PCS boundary are directly countable. The transmitted value is always recessive regardless of observed bus level due to wired-AND. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-011"
source_clause = "§6.6.5.2"
original_wording = "An error-active node detecting an error condition shall signal this by sending an active error flag."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received `Error_active_request` from FCE (node is error-active); MAC is in an active frame transmission or reception phase at the MAC↔PCS boundary"
event = "MAC detects an error condition (bit, stuff, CRC, form, or ACK) and signals `Error(type)` to FCE"
postcondition = "MAC issues six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls to PCS (active error flag) and signals `Error/Overload_flag` to FCE"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: Error Active state is owned by the FCE (§8). The error flag itself is a MAC-layer output. All four formats share the same error signalling mechanism."
label = ""
file = ""
observability = "external"
observability_rationale = "Six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls and `Error/Overload_flag` signal at MAC↔FCE boundary are both directly observable at the respective layer boundaries. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-012"
source_clause = "§6.6.5.2"
original_wording = "Consequently, all other nodes shall detect an error condition too and shall start sending an error flag."
shape = "triggered"
scope = "bus"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "One node has issued six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls (active error flag); other nodes are receiving `PCS_Data.Indicate(Input_Unit=dominant)` at positions that violate bit stuffing or fixed-form rules"
event = "Each other node receives `PCS_Data.Indicate(Input_Unit=dominant)` at a position that constitutes a bit stuffing violation or fixed-form field destruction, causing each to detect an error and signal `Error(type)` to its FCE"
postcondition = "Each other node issues its own six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls to PCS and signals `Error/Overload_flag` to its FCE; the combined dominant sequence on the bus spans 6–12 bits depending on detection timing"
flags = ["AMBIGUOUS"]
notes = "AMBIGUOUS scope: assigned bus because verification requires multiple nodes observing the error flag propagation. The total dominant sequence length ranges from 6 to 12 bits depending on detection timing across nodes. All four formats share this behavior."
label = ""
file = ""

# ── §6.6.5.3 Error delimiter ──
observability = "external"
observability_rationale = "Each node's `PCS_Data.Request(Output_Unit=dominant)` sequence and `Error/Overload_flag` at MAC↔FCE boundary are observable per node. Combined dominant span of 6–12 bits is measurable at bus level. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-013"
source_clause = "§6.6.5.3"
original_wording = "The error delimiter shall consist of eight recessive bits. ; After sending an error flag, each node shall monitor the bus until it detects a recessive bit. At this point in time, every node shall finish sending its error flag and all nodes shall start sending seven more recessive bits simultaneously, to complete the 8-bit error delimiter."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed transmission of its error flag (six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls); MAC is now monitoring the bus via `PCS_Data.Indicate`"
event = "MAC receives `PCS_Data.Indicate(Input_Unit=recessive)` — the first recessive bit observed after the error flag"
postcondition = "(1) MAC stops transmitting its error flag; (2) MAC issues seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls to PCS; (3) the total error delimiter is eight recessive bits at the MAC↔PCS boundary"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) error delimiter = 8 recessive bits; (2) monitor for recessive after error flag; (3) complete with 7 more recessive bits. All four formats share the same error delimiter structure."
label = ""
file = ""

# ── §6.6.6.1 OF types ──
observability = "external"
observability_rationale = "Seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls following error flag completion are directly countable at MAC↔PCS boundary. Trigger event is `PCS_Data.Indicate(Input_Unit=recessive)`. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-014"
source_clause = "§6.6.6.1"
original_wording = "Following types of OF shall have the same format. ; The overload flag shall correspond to that of the active error flag. The overload delimiter shall be the same as the error delimiter."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has determined that an overload frame must be sent (LLC-requested or reactive); MAC↔PCS boundary is active"
postcondition = "MAC issues six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls (overload flag, identical to active error flag) followed by eight consecutive `PCS_Data.Request(Output_Unit=recessive)` calls (overload delimiter, identical to error delimiter), regardless of whether the OF is LLC-requested or reactive"
flags = []
notes = "LLC-requested and reactive OFs share the same format. All four in-scope formats may be preceded by an OF."
label = ""
file = ""
observability = "external"
observability_rationale = "Six dominant then eight recessive `PCS_Data.Request` calls at MAC↔PCS boundary are directly countable regardless of whether the OF is LLC-requested or reactive. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-015"
source_clause = "§6.6.6.1"
original_wording = "The transmission of the reactive OF shall be initiated by the MAC sub-layer upon certain error conditions (see 6.6.21.4.3)."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has just completed a frame (DF, RF, EF, or OF) and is monitoring the bus via `PCS_Data.Indicate`; no LLC-requested OF is pending"
event = "MAC receives `PCS_Data.Indicate(Input_Unit=dominant)` during intermission (bits 1–2) or at the last bit of EOF/error delimiter/overload delimiter — a reactive OF trigger condition per §6.6.21.4.3"
postcondition = "MAC initiates transmission of a reactive overload frame by issuing six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls (overload flag) to PCS"
flags = []
notes = "The specific trigger conditions are detailed in §6.6.21.3.2. All four formats may precede an OF."
label = ""
file = ""

# ── §6.6.6.2 Overload flag ──
observability = "external"
observability_rationale = "Reactive OF initiation observable as `PCS_Data.Request(Output_Unit=dominant)` sequence at MAC↔PCS boundary, triggered by `PCS_Data.Indicate(Input_Unit=dominant)` at the specified positions. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-016"
source_clause = "§6.6.6.2"
original_wording = "The overload flag shall consist of six dominant bits. ; Consequently, all other nodes also detect an overload condition and shall start sending an overload flag."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has determined that an overload frame must be sent; MAC↔PCS boundary is active"
postcondition = "MAC issues exactly six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls to PCS, forming the overload flag"
flags = []
notes = "Structural definition. The second sentence about other nodes detecting the overload is a bus-scope consequence but the structural claim is frame-scope. All four formats share the same OF structure."
label = ""
file = ""

# ── §6.6.6.3 Overload delimiter ──
observability = "external"
observability_rationale = "Six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls at MAC↔PCS boundary are directly countable. Structurally identical to active error flag. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-017"
source_clause = "§6.6.6.3"
original_wording = "The overload delimiter shall consist of eight recessive bits. After sending an overload flag, each node shall monitor the bus until it detects a recessive bit. At this point in time, every node shall finish sending its overload flag and all nodes shall start sending seven more recessive bits simultaneously, to complete the 8-bit overload delimiter."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed transmission of its overload flag (six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls); MAC is now monitoring the bus via `PCS_Data.Indicate`"
event = "MAC receives `PCS_Data.Indicate(Input_Unit=recessive)` — the first recessive bit observed after the overload flag"
postcondition = "(1) MAC stops transmitting its overload flag; (2) MAC issues seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls to PCS; (3) the total overload delimiter is eight recessive bits at the MAC↔PCS boundary"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) overload delimiter = 8 recessive bits; (2) monitor for recessive; (3) complete with 7 more. Structurally identical to error delimiter (REQ-MAC-013). All four formats share this structure."
label = ""
file = ""

# ── §6.6.7.1 Separation of frames ──
observability = "external"
observability_rationale = "Seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls following overload flag completion are directly countable at MAC↔PCS boundary. Trigger event is `PCS_Data.Indicate(Input_Unit=recessive)`. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-018"
source_clause = "§6.6.7.1"
original_wording = "DFs and RFs shall be separated from preceding frames, whatever frame type the preceding frames are (DF, RF, EF, OF), by a time period called inter-frame space. ; In contrast to this, EFs and OFs shall not be preceded by inter-frame space, and multiple OFs shall not be separated by inter-frame space."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed a frame transmission or reception; the next frame exchange is pending at the LLC↔MAC boundary"
postcondition = "(1) Before transmitting or accepting a DF/RF SOF, MAC issues three recessive `PCS_Data.Request` calls (intermission) at the MAC↔PCS boundary; (2) MAC issues no intermission before an EF or OF; (3) MAC issues no intermission between consecutive OFs"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) DFs/RFs separated by IFS; (2) EFs/OFs not preceded by IFS; (3) multiple OFs not separated. All four in-scope formats are subject to IFS rules."
label = ""
file = ""
observability = "external"
observability_rationale = "IFS presence/absence before each frame type is directly observable as recessive `PCS_Data.Request` calls (or absence thereof) at MAC↔PCS boundary between end-of-frame and next SOF. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-019"
source_clause = "§6.6.7.1"
original_wording = "Inter-frame space shall contain the bit field intermission and bus idle time. For error-passive nodes, which have been transmitter of the previous frame, inter-frame space shall also contain the node's suspend transmission time."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed a frame transmission; an inter-frame space is in progress at the MAC↔PCS boundary"
postcondition = "IFS at MAC↔PCS boundary consists of: three recessive `PCS_Data.Request` calls (intermission) followed by recessive bus idle; if MAC received `Error_passive_request` from FCE and was the previous transmitter, MAC additionally issues eight recessive `PCS_Data.Request` calls (suspend transmission time) between intermission and bus idle"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: error-passive state is owned by the FCE (§8). All four formats share the same IFS structure."
label = ""
file = ""

# ── §6.6.7.2 Intermission ──
observability = "external"
observability_rationale = "IFS structure observable as `PCS_Data.Request` call sequence at MAC↔PCS boundary: three recessive (intermission) + optional eight recessive (suspend) + bus idle. Suspend presence conditioned on `Error_passive_request` from FCE. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-020"
source_clause = "§6.6.7.2"
original_wording = "The intermission field shall consist of three recessive bits."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed a DF, RF, EF, or OF and is in the inter-frame space phase; MAC↔PCS boundary is active"
postcondition = "MAC issues exactly three consecutive `PCS_Data.Request(Output_Unit=recessive)` calls to PCS, forming the intermission field"
flags = []
notes = "Structural constraint on intermission. All four formats share the same intermission structure."
label = ""
file = ""
observability = "external"
observability_rationale = "Three consecutive `PCS_Data.Request(Output_Unit=recessive)` calls at MAC↔PCS boundary are directly countable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-021"
source_clause = "§6.6.7.2"
original_wording = "During intermission, a node shall not start transmission of DFs or RFs."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is in the intermission phase; MAC has been issuing recessive `PCS_Data.Request` calls for bits 1–3 of intermission; MAC↔PCS boundary is active"
postcondition = "MAC issues no `PCS_Data.Request(Output_Unit=dominant)` for any DF or RF SOF during the three intermission bit times; MAC continues issuing recessive `PCS_Data.Request` calls until intermission completes"
flags = []
notes = "An OF may still be transmitted during intermission (per same paragraph). All four formats are subject to this rule."
label = ""
file = ""
observability = "external"
observability_rationale = "Absence of `PCS_Data.Request(Output_Unit=dominant)` during intermission is directly verifiable at MAC↔PCS boundary by observing all Output_Unit values during the three intermission bit times. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-022"
source_clause = "§6.6.7.2"
original_wording = "The detection of a dominant bit at the third bit of intermission shall be interpreted as SOF (see 6.6.8)."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is in the intermission phase and has issued two recessive `PCS_Data.Request` calls (bits 1–2); MAC is monitoring the bus via `PCS_Data.Indicate`"
event = "MAC receives `PCS_Data.Indicate(Input_Unit=dominant)` at the third intermission bit position"
postcondition = "MAC interprets the dominant `PCS_Data.Indicate` as a Start of Frame (SOF) and transitions to frame reception mode, treating that dominant bit as the SOF bit of an incoming frame"
flags = []
notes = "This links to the SOF specification in §6.6.8. All four formats use the same SOF detection mechanism."
label = ""
file = ""

# ── §6.6.7.3 Bus idle ──
observability = "external"
observability_rationale = "Trigger `PCS_Data.Indicate(Input_Unit=dominant)` and resulting MAC frame reception mode transition are both observable at MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-023"
source_clause = "§6.6.7.3"
original_wording = "The bus shall be recognized to be idle by receivers and by error active transmitters when the third bit of intermission is seen recessive; by error passive transmitters when the eighth bit of suspend transmission time is seen recessive; or when the bus integrating state is left (see 6.6.7.5)."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is in inter-frame space or bus re-integration state; MAC is monitoring the bus via `PCS_Data.Indicate`"
event = "One of: (a) MAC receives `PCS_Data.Indicate(Input_Unit=recessive)` at the third intermission bit (for receivers/error-active TX); (b) MAC receives `PCS_Data.Indicate(Input_Unit=recessive)` at the eighth suspend bit (for error-passive TX); (c) MAC exits bus re-integration state"
postcondition = "MAC recognizes the bus as idle and becomes available to initiate a new `PCS_Data.Request` sequence (transmitter) or accept an incoming SOF via `PCS_Data.Indicate` (receiver)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: Error Active/Passive state is owned by FCE (§8). All four formats share the same bus idle recognition."
label = ""
file = ""
observability = "external"
observability_rationale = "Bus idle recognition observable at MAC↔PCS boundary: MAC transitions from monitoring `PCS_Data.Indicate` to readiness for new `PCS_Data.Request` sequence. Trigger conditions are specific `PCS_Data.Indicate` values at counted bit positions. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-024"
source_clause = "§6.6.7.3"
original_wording = "The detection of a dominant bit on the bus during bus idle time shall be interpreted as SOF."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has recognized the bus as idle; MAC is monitoring the bus via `PCS_Data.Indicate`"
event = "MAC receives `PCS_Data.Indicate(Input_Unit=dominant)` during bus idle"
postcondition = "MAC interprets the dominant `PCS_Data.Indicate` as a Start of Frame (SOF) and transitions to frame reception mode"
flags = []
notes = "Any dominant bit during bus idle starts a new frame. All four formats use the same SOF detection."
label = ""
file = ""

# ── §6.6.7.4 Suspend transmission ──
observability = "external"
observability_rationale = "`PCS_Data.Indicate(Input_Unit=dominant)` during bus idle and resulting MAC frame reception mode transition are directly observable at MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-025"
source_clause = "§6.6.7.4"
original_wording = "An error-passive node, which has been transmitter of the previous frame, shall suspend the start of further frame transmissions for 8 bit times following intermission. ; If another node starts a transmission during that suspend transmission time, the node shall become a receiver of this DF or RF frame."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received `Error_passive_request` from FCE (node is error-passive) and was the transmitter of the previous frame; MAC has completed intermission (three recessive `PCS_Data.Request` calls)"
postcondition = "(1) MAC issues eight consecutive `PCS_Data.Request(Output_Unit=recessive)` calls to PCS (suspend transmission time) before initiating any DF or RF transmission; (2) if MAC receives `PCS_Data.Indicate(Input_Unit=dominant)` during suspend, MAC ceases `PCS_Data.Request` and acts as receiver of that incoming DF or RF"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: (1) suspend for 8 bit times; (2) become receiver if another node starts. EXTERNAL_DEP: error-passive state is owned by FCE (§8). All four formats share the same suspend rules."
label = ""
file = ""

# ── §6.6.7.5 Bus re-integration ──
observability = "external"
observability_rationale = "Eight recessive `PCS_Data.Request` calls (suspend) at MAC↔PCS boundary after intermission are directly countable. Receiver transition on `PCS_Data.Indicate(Input_Unit=dominant)` during suspend is also observable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-026"
source_clause = "§6.6.7.5"
original_wording = "CAN nodes shall start the bus re-integration after starting the protocol operation, during bus-off recovery, or (for nodes that are FD tolerant, FD enabled, or XL enabled) after detecting a protocol exception event."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is starting protocol operation, MAC has received a bus-off indication from FCE (bus-off recovery in progress), or MAC has detected a protocol exception event (for FD-tolerant/FD-enabled nodes)"
event = "Protocol operation start, bus-off recovery initiation signalled by FCE, or protocol exception event detected via `PCS_Data.Indicate`"
postcondition = "MAC enters bus re-integration state: MAC ceases issuing `PCS_Data.Request` and monitors the bus via `PCS_Data.Indicate` until the idle condition is detected"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: bus-off state is owned by FCE (§8). FD-tolerant/enabled nodes enter re-integration on protocol exception. All four formats share the same re-integration trigger."
label = ""
file = ""
observability = "external"
observability_rationale = "Bus re-integration entry observable at MAC↔PCS boundary: MAC ceases `PCS_Data.Request` calls and begins monitoring via `PCS_Data.Indicate` following one of the three trigger conditions. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-027"
source_clause = "§6.6.7.5"
original_wording = "CAN nodes that are not in bus-off state shall finish the bus re-integration when the idle condition (see 3.34) is detected."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is in bus re-integration state; MAC is not bus-off (FCE has not issued an active bus-off indication); MAC is monitoring the bus via `PCS_Data.Indicate`"
event = "MAC receives eleven consecutive `PCS_Data.Indicate(Input_Unit=recessive)` calls (idle condition detected)"
postcondition = "MAC exits bus re-integration state and recognizes the bus as idle; MAC becomes available to initiate a new `PCS_Data.Request` sequence or accept an incoming SOF via `PCS_Data.Indicate`"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: bus-off state is owned by FCE (§8). All four formats share the same re-integration completion."
label = ""
file = ""
observability = "external"
observability_rationale = "Eleven consecutive `PCS_Data.Indicate(Input_Unit=recessive)` calls and resulting MAC idle recognition are directly countable and observable at MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-028"
source_clause = "§6.6.7.5"
original_wording = "There shall be a bit counter that is reset when the bus re-integration state is started or when the CAN bus is detected dominant at the sample point. The bit counter shall be incremented when the CAN bus is detected recessive at the sample point. The idle condition shall be detected when this bit counter reaches the value 11."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is in bus re-integration state"
postcondition = "A bit counter exists: reset on re-integration start or dominant sample, incremented on recessive sample; idle condition detected when counter reaches 11"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) counter reset conditions; (2) counter increment condition; (3) idle detection threshold. All four formats share the same re-integration counter logic."
label = ""
file = ""
observability = "internal"
observability_rationale = "Internal bit counter for bus re-integration state management. Counter value is not a parameter on any MAC boundary primitive. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-MAC-029"
source_clause = "§6.6.7.5"
original_wording = "For nodes that are FD tolerant, FD enabled, or XL enabled, there shall be a third reset condition for the bit counter. It shall be reset when detecting an edge that causes synchronization."
shape = "triggered"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is FD-tolerant or FD-enabled and is in bus re-integration state"
event = "An edge that causes synchronization is detected"
postcondition = "The bit counter for idle detection is reset"
flags = []
notes = "This ensures FD nodes do not mistake shorter data-phase bits as idle during re-integration. All four in-scope formats imply FD capability."
label = ""
file = ""

# ── §6.6.8 SOF ──
side = "both"
observability = "internal"
observability_rationale = "Internal requirement for a third CRC sequence state machine for FD-tolerant nodes. The existence of a separate state machine is an implementation detail; the CRC result itself is covered by other requirements. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-MAC-030"
source_clause = "§6.6.8"
original_wording = "SOF shall mark the beginning of DFs and RFs. It shall be dominant."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has recognized the bus as idle and has received an LLC frame SDU + Handle; MAC is ready to initiate a DF or RF transmission via the MAC↔PCS boundary"
postcondition = "The first `PCS_Data.Request(Output_Unit=dominant)` call issued by MAC to PCS is the SOF bit, marking the start of the DF or RF"
flags = []
notes = "Structural definition of SOF. All four in-scope formats begin with SOF. RF applies only to CB and CE."
label = ""
file = ""
observability = "external"
observability_rationale = "First `PCS_Data.Request(Output_Unit=dominant)` call at MAC↔PCS boundary is the SOF bit — directly observable as the first Output_Unit of the frame. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-031"
source_clause = "§6.6.8"
original_wording = "A node shall send an SOF only when the bus is idle (see 6.6.7.3)."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received an LLC frame SDU + Handle and is ready to transmit; MAC↔PCS boundary is active"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=dominant)` for SOF only after receiving `PCS_Data.Indicate` confirming the idle condition (eleven consecutive recessive bits); MAC does not issue any `PCS_Data.Request(Output_Unit=dominant)` for SOF until bus idle is confirmed"
flags = []
notes = "Links to bus idle recognition in §6.6.7.3. All four formats share the same SOF initiation rule."
label = ""
file = ""
observability = "external"
observability_rationale = "`PCS_Data.Request(Output_Unit=dominant)` for SOF only after `PCS_Data.Indicate` confirms idle: both events are observable at MAC↔PCS boundary. Testbench verifies no dominant SOF request before idle confirmed. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-032"
source_clause = "§6.6.8"
original_wording = "If a node samples a dominant bit at the third bit of intermission, this node shall, if it has a pending transmission and if the node is error active or has been receiver of the previous frame, start transmitting its frame at the next bit with the first bit of its identifier and take part in arbitration, without first transmitting an SOF bit and without becoming receiver."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node has a pending transmission and is error-active (or was receiver of the previous frame); the node is in intermission and has received two recessive bits via `PCS_Data.Indicate(Input_Unit=recessive)` for the first and second intermission bits"
event = "`PCS_Data.Indicate(Input_Unit=dominant)` is received at the third intermission bit position"
postcondition = "The node immediately issues `PCS_Data.Request(Output_Unit)` for the first bit of its identifier (not SOF) on the next bit time, participating in arbitration without first transmitting a SOF; verifying that SOF is absent and identifier starts at the correct bit position requires tracking the MAC protocol state machine across intermission (multi-step tracking)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: error-active state is owned by FCE (§8). This is the 'hard synchronization at third intermission bit' rule. All four formats share this behavior."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The absence of SOF and direct identifier start manifests as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying the correct omission of SOF requires tracking the MAC protocol state machine across the intermission-to-arbitration transition — multi-step protocol state tracking"

[[requirement]]
id = "REQ-MAC-033"
source_clause = "§6.6.8"
original_wording = "All nodes shall synchronize to the leading edge caused by SOF of the first node starting to transmit."
shape = "triggered"
scope = "bus"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The bus is idle (recessive) and at least one node is about to issue `PCS_Data.Request(Output_Unit=dominant)` for SOF"
event = "The leading (recessive-to-dominant) edge of the SOF bit is detected on the bus"
postcondition = "All nodes synchronize their bit timing to the recessive-to-dominant SOF edge; subsequent `PCS_Data.Indicate(Input_Unit)` calls on each node fire at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles after this edge (multi-node alignment requires tracking PCS internal bit timing state on each node)"
flags = []
notes = "Bus-scope because it describes the behavior of all nodes on the bus in response to one node's SOF. All four formats share the same synchronization rule."
label = ""
file = ""

# ── §6.6.9 Elements of the MAC frame ──
observability = "derived"
observability_rationale = "[Rule 2] Post-sync `PCS_Data.Indicate(Input_Unit)` timing at each node manifests at the MAC↔PCS boundary, but verifying that all nodes are synchronized to the same SOF edge requires understanding PCS bit timing internals (segment lengths, synchronization state) across multiple nodes — non-trivial multi-node timing analysis"

[[requirement]]
id = "REQ-MAC-034"
source_clause = "§6.6.9"
original_wording = "On transmission, an LLC frame (see Table 4) shall be converted into a MAC DF or MAC RF. On reception, a MAC DF or MAC RF shall be converted into an LLC frame."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "TX: MAC has received an LLC frame SDU + Handle at the LLC↔MAC boundary. RX: MAC has received a SOF `PCS_Data.Indicate(Input_Unit=dominant)` from PCS"
postcondition = "TX: MAC converts the LLC frame SDU into a sequence of `PCS_Data.Request(Output_Unit=dominant/recessive)` calls forming a MAC DF or RF. RX: MAC reconstructs the LLC frame SDU from the `PCS_Data.Indicate(Input_Unit)` sequence and delivers Transfer_Status + Timestamp + Handle to LLC"
flags = []
notes = "Bidirectional conversion between LLC and MAC frame representations. All four formats require this conversion. RF applies only to CB and CE."
label = ""
file = ""
observability = "external"
observability_rationale = "TX: LLC frame SDU at LLC↔MAC boundary and resulting `PCS_Data.Request` sequence at MAC↔PCS boundary are both observable. RX: `PCS_Data.Indicate` sequence at MAC↔PCS and Transfer_Status+Timestamp+Handle at LLC↔MAC boundary are both observable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-035"
source_clause = "§6.6.9"
original_wording = "MAC DFs (see Figure 8) and MAC RFs (see Figure 9) shall be composed of the following seven different bit fields: SOF; arbitration field; control field; data field; CRC field; ACK field; EOF."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received an LLC frame SDU + Handle (TX) or has received SOF `PCS_Data.Indicate(Input_Unit=dominant)` (RX); MAC↔PCS boundary is active"
postcondition = "The sequence of `PCS_Data.Request` (TX) or `PCS_Data.Indicate` (RX) calls at the MAC↔PCS boundary contains exactly seven ordered bit fields: SOF, arbitration field, control field, data field, CRC field, ACK field, EOF — with no fields omitted or reordered"
flags = []
notes = "Structural definition of MAC frame composition. All four in-scope formats share this seven-field structure (data field may be zero-length for DLC=0 or RF). RF applies only to CB and CE."
label = ""
file = ""

# ── §6.6.10.2 Arbitration field (CC) ──
observability = "external"
observability_rationale = "All seven bit fields observable as `PCS_Data.Request` (TX) or `PCS_Data.Indicate` (RX) call sequences at MAC↔PCS boundary. Field boundaries deterministic from frame format. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-036"
source_clause = "§6.6.10.2"
original_wording = "The values of the identifier bits shall be passed from the ID field of the LLC frame. The values of the SRR and IDE bits shall be passed from the format field of the LLC frame. The value of the RTR bit shall be passed from the FTYP bit of the LLC frame."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "MAC has received the LLC frame SDU (ID field, format field, FTYP bit) and is constructing the CC arbitration field for transmission"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit)` for each arbitration bit in order: identifier bits with values from LLC ID field (MSB first), SRR and IDE bits with values from LLC format field, RTR bit with value from LLC FTYP bit"
flags = []
notes = "Defines the LLC-to-MAC mapping for CC arbitration field bits. Only CB and CE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Each arbitration bit appears as `PCS_Data.Request(Output_Unit)` at the MAC↔PCS boundary. Testbench supplies a known LLC frame SDU and verifies the Output_Unit sequence matches the ID, format, and FTYP fields bit-for-bit. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-037"
source_clause = "§6.6.10.2, §6.6.11.2"
original_wording = "The SRR bit shall be transmitted recessive, but receivers shall accept recessive and dominant SRR bits."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CE, FE"
precondition = "A CE or FE frame arbitration field is being transmitted or received at the MAC↔PCS boundary"
postcondition = "(1) TX: MAC issues `PCS_Data.Request(Output_Unit=recessive)` for the SRR bit position; (2) RX: MAC does not signal `Error(form)` to FCE regardless of whether `PCS_Data.Indicate(Input_Unit)` returns dominant or recessive for the SRR bit"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) TX sends recessive SRR; (2) RX accepts both values. Only CE (CEFF) has the SRR bit. The NOTE clarifies that dominant SRR is not a form error."
label = ""
file = ""

# ── §6.6.10.3 Control field (CC) ──
observability = "external"
observability_rationale = "TX SRR polarity is directly observable as `PCS_Data.Request(Output_Unit=recessive)` at MAC↔PCS boundary. RX acceptance is observable by absence of `Error(form)` at MAC↔FCE boundary when `PCS_Data.Indicate(Input_Unit)` injects either polarity. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-038"
source_clause = "§6.6.10.3"
original_wording = "The first two bits of the control field shall be transmitted dominant, followed by the DLC."
shape = "invariant"
scope = "frame"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "MAC is serialising the control field of a CC frame and issuing `PCS_Data.Request` calls for each bit"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=dominant)` for the first two control bits (IDE/r1 and r0), followed by `PCS_Data.Request(Output_Unit=X)` for each of the 4 DLC bits in MSB-first order"
flags = []
notes = "In CBFF, the first bit is IDE (dominant); in CEFF, the first bit is r1 (dominant). The second bit is r0 (dominant) in both. Only CB and CE apply."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "First two control bits appear as `PCS_Data.Request(Output_Unit=dominant)` and DLC bits as `PCS_Data.Request(Output_Unit=X)` at MAC↔PCS boundary. Testbench verifies exact Output_Unit sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-039"
source_clause = "§6.6.10.3"
original_wording = "A CAN FD tolerant CAN node shall detect a protocol exception event when this bit is received recessive."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB"
precondition = "The node is FD-tolerant and is receiving a CBFF frame"
event = "`PCS_Data.Indicate(Input_Unit=recessive)` is received at the r0 bit position (second bit of control field in CBFF, which corresponds to the FDF position in FBFF)"
postcondition = "The node detects a protocol exception event and subsequently issues only `PCS_Data.Request(Output_Unit=recessive)` calls, entering bus re-integration; verifying the internal protocol exception detection requires tracking the MAC state machine across multiple `PCS_Data.Indicate` events (multi-step protocol state tracking)"
flags = []
notes = "This is how an FD-tolerant node recognizes that what it expected to be a CC frame is actually an FD frame. Only applies to CBFF (r0 position). A similar rule exists for CEFF at the r1 position."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The recessive `PCS_Data.Request(Output_Unit=recessive)` calls during bus re-integration manifest at the MAC↔PCS boundary, but verifying that a protocol exception event was correctly detected (at the specific r0/FDF bit position) requires tracking the MAC state machine across multiple `PCS_Data.Indicate` events — multi-step protocol state tracking"

[[requirement]]
id = "REQ-MAC-040"
source_clause = "§6.6.10.3"
original_wording = "In CEFF, receivers shall accept it with recessive and with dominant state."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CE"
precondition = "The MAC receiver is processing a CEFF frame and `PCS_Data.Indicate(Input_Unit)` delivers the r0 bit value"
postcondition = "MAC does not signal `Error(form)` to FCE for the r0 bit regardless of whether `PCS_Data.Indicate(Input_Unit)` returns dominant or recessive"
flags = []
notes = "In CEFF, r0 does not trigger protocol exception — both values are accepted. Only CE applies."
label = ""
file = ""

# ── §6.6.10.4 Data field (CC) ──
observability = "external"
observability_rationale = "Absence of `Error(form)` at MAC↔FCE boundary when both dominant and recessive `PCS_Data.Indicate(Input_Unit)` values are injected at r0 position. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-041"
source_clause = "§6.6.10.4"
original_wording = "The data field shall consist of the data passed from the LLC frame. ; Each byte shall contain eight bit."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "MAC has received the LLC frame SDU with DLC > 0 and is serialising the data field via `PCS_Data.Request` calls"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=X)` for each data bit sequentially: bytes 0 through DLC-1, each byte transmitted MSB (bit 7) first, matching the corresponding byte of the LLC frame SDU"
flags = []
notes = "No data field exists for DLC=0 or for remote frames. Only CB and CE apply here; FD data field is specified separately in §6.6.11.4."
label = ""
file = ""

# ── §6.6.10.5 CRC field (CC) ──
observability = "external"
observability_rationale = "Data bytes appear as `PCS_Data.Request(Output_Unit)` sequence at MAC↔PCS boundary, MSB first per byte, byte 0 first. Testbench verifies each Output_Unit matches corresponding LLC frame SDU byte bit. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-042"
source_clause = "§6.6.10.5"
original_wording = "The CRC field shall contain the FCRC sequence followed by a recessive CRC delimiter."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "MAC has completed the data field and is serialising the CC CRC field via `PCS_Data.Request` calls"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=X)` for each of the 15 FCRC bits in MSB-first order, followed by `PCS_Data.Request(Output_Unit=recessive)` for the CRC delimiter"
flags = []
notes = "CC CRC field structure: 15-bit FCRC + 1-bit recessive delimiter. Only CB and CE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "CRC field structure (15-bit FCRC then recessive delimiter) appears as `PCS_Data.Request(Output_Unit)` sequence at MAC↔PCS boundary. Field structure and count are externally verifiable; CRC polynomial correctness is derived. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-043"
source_clause = "§6.6.10.5"
original_wording = "In CC frames, stuff bits shall not be included in the relevant bit stream for CRC calculation."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "CRC_15 is being calculated for a CC frame; `PCS_Data.Request(Output_Unit)` calls have been issued for SOF through the last data bit, with dynamic stuff bits interspersed"
postcondition = "Dynamic stuff bits are excluded from the CRC_15 input: the sequence of `PCS_Data.Request(Output_Unit)` values used as CRC input corresponds to the de-stuffed bit stream; the resulting FCRC bits at the MAC↔PCS boundary are correct only when stuff bits are removed before polynomial application (verification requires de-stuffing then applying CRC_15)"
flags = []
notes = "The relevant bit stream is SOF + arbitration + control + data (if present), with stuff bits removed. Only CB and CE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The FCRC field bits manifest as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying that stuff bits were excluded from the CRC input requires de-stuffing the `PCS_Data.Request` stream then applying CRC_15 — the de-stuffing step is a non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-044"
source_clause = "§6.6.10.6"
original_wording = "The ACK field shall contain the ACK slot and the ACK delimiter. ; In the ACK field, the transmitter node shall send recessive bits."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "MAC has completed the CRC delimiter and is serialising the CC ACK field via `PCS_Data.Request` calls"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=recessive)` for both the ACK slot bit and the ACK delimiter bit"
flags = []
notes = "The transmitter's recessive ACK slot is overwritten by receivers sending dominant (see REQ-MAC-046). Only CB and CE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "TX ACK slot and delimiter both appear as `PCS_Data.Request(Output_Unit=recessive)` at MAC↔PCS boundary. Directly countable from Output_Unit sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-045"
source_clause = "§6.6.10.6"
original_wording = "All receivers check the consistency of the received DF or RF and shall acknowledge a consistent frame and shall flag an inconsistent frame by means of an EF (see 6.6.2). A DF or RF that is not acknowledged shall be regarded as corrupted and shall be flagged by the transmitting node with an EF."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "A CC DF or RF has been transmitted and the ACK slot position is reached at the MAC↔PCS boundary"
event = "The ACK slot bit is reached: TX issues `PCS_Data.Request(Output_Unit=recessive)` and samples `PCS_Data.Indicate(Input_Unit)` at the sample point"
postcondition = "(1) RX with matching FCRC: MAC issues `PCS_Data.Request(Output_Unit=dominant)` in ACK slot; (2) RX with inconsistent frame: MAC signals `Error/Overload_flag` to FCE; (3) TX detecting no dominant during ACK slot via `PCS_Data.Indicate`: MAC signals `Error(ACK)` to FCE and transmits error flag"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) receivers ACK consistent frames; (2) receivers flag inconsistent with EF; (3) non-ACK'd frame → corrupted → TX EF. Only CB and CE apply here; FD ACK is in §6.6.11.6."
label = ""
file = ""
observability = "external"
observability_rationale = "RX ACK (`PCS_Data.Request(Output_Unit=dominant)` in ACK slot), RX error flag (`Error/Overload_flag` to FCE), and TX ACK error (`Error(ACK)` to FCE) are all observable at MAC layer boundaries. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-046"
source_clause = "§6.6.10.6"
original_wording = "All nodes that receive the matching FCRC sequence shall send an ACK within the ACK slot by overwriting the recessive bit of the transmitter with a dominant bit (they send ACK)."
shape = "triggered"
scope = "bus"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "A CC frame has been received via `PCS_Data.Indicate` calls and the receiver's calculated FCRC matches the received FCRC"
event = "The ACK slot position is reached and the receiver's FCRC comparison passed; MAC issues `PCS_Data.Request(Output_Unit=dominant)` for the ACK slot bit"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=dominant)` in the ACK slot, overwriting the transmitter's recessive `PCS_Data.Request` on the shared bus"
flags = []
notes = "Bus-scope because the receiver's dominant bit overwrites the transmitter's recessive bit on the shared bus. Only CB and CE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Receiver's `PCS_Data.Request(Output_Unit=dominant)` in ACK slot is directly observable at MAC↔PCS boundary when a valid frame is delivered via `PCS_Data.Indicate`. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-047"
source_clause = "§6.6.10.6"
original_wording = "The ACK delimiter, being the last bit of the ACK field, shall be a recessive bit."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is serialising the ACK delimiter bit of a CC or FD frame via `PCS_Data.Request`"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=recessive)` for the ACK delimiter bit"
flags = []
notes = "The ACK slot is surrounded by recessive bits (CRC delimiter and ACK delimiter). Only CB and CE apply."
label = ""
file = ""

# ── §6.6.10.7 EOF (CC) ──
observability = "external"
observability_rationale = "ACK delimiter appears as `PCS_Data.Request(Output_Unit=recessive)` at MAC↔PCS boundary. Trivially verifiable from Output_Unit sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-048"
source_clause = "§6.6.10.7"
original_wording = "DFs and RFs shall be delimited by a flag sequence consisting of seven recessive bits forming the EOF."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has completed the ACK delimiter of a CC DF or RF and is serialising the EOF field via `PCS_Data.Request` calls"
postcondition = "MAC issues exactly seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls for the EOF field"
flags = []
notes = "CC EOF structure. Only CB and CE apply; FD EOF is specified in §6.6.11.7."
label = ""
file = ""

# ── §6.6.11.2 Arbitration field (FD) ──
observability = "external"
observability_rationale = "Seven consecutive `PCS_Data.Request(Output_Unit=recessive)` calls are directly countable at MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-049"
source_clause = "§6.6.11.2"
original_wording = "The values of the identifier bits shall be passed from the ID field of the LLC frame. The values of the SRR, IDE and RRS bits shall be defined by the format field of the LLC frame."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC has received the LLC frame SDU (ID field, format field including SRR, IDE, RRS) and is constructing the FD arbitration field for transmission"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit)` for each arbitration bit: identifier bits with values from LLC ID field (MSB first), SRR, IDE, and RRS bits with values from LLC format field"
flags = []
notes = "Defines LLC-to-MAC mapping for FD arbitration field bits. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Each FD arbitration bit appears as `PCS_Data.Request(Output_Unit)` at MAC↔PCS boundary. Testbench supplies known LLC frame SDU and verifies Output_Unit sequence matches ID, format field bits. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-050"
source_clause = "§6.6.11.2"
original_wording = "The RRS bit shall be transmitted dominant, but receivers shall accept recessive and dominant RRS bits."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame arbitration field is being transmitted or received at the MAC↔PCS boundary and the RRS bit position is reached"
postcondition = "(1) TX: MAC issues `PCS_Data.Request(Output_Unit=dominant)` for the RRS bit; (2) RX: MAC does not signal `Error(form)` to FCE regardless of whether `PCS_Data.Indicate(Input_Unit)` returns dominant or recessive for the RRS bit"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) TX sends dominant; (2) RX accepts both. The NOTE clarifies recessive RRS is not a form error. Only FB and FE apply."
label = ""
file = ""

# ── §6.6.11.3 Control field (FD) ──
observability = "external"
observability_rationale = "TX RRS polarity is directly observable as `PCS_Data.Request(Output_Unit=dominant)` at MAC↔PCS boundary. RX acceptance is observable by absence of `Error(form)` at MAC↔FCE boundary when `PCS_Data.Indicate(Input_Unit)` injects either polarity. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-051"
source_clause = "§6.6.11.3"
original_wording = "In FD frames, the FDF bit shall be followed by the dominant res bit. ; When an FD enabled receiver detects the res bit to be recessive instead of the expected dominant it shall, when protocol exception handling is enabled, detect a protocol exception event; when protocol exception handling is disabled, it shall treat this as a form error."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is processing an FD frame control field at the MAC↔PCS boundary and has just issued or received the FDF bit; the res bit position follows"
postcondition = "(1) TX: MAC issues `PCS_Data.Request(Output_Unit=dominant)` for the res bit; (2) RX receiving recessive res via `PCS_Data.Indicate(Input_Unit=recessive)`: if `protocol_exception_enable=true` MAC triggers a protocol exception event; if `protocol_exception_enable=false` MAC signals `Error(form)` to FCE"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) res bit is dominant; (2) recessive res → protocol exception or form error depending on configuration. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "TX res bit appears as `PCS_Data.Request(Output_Unit=dominant)` at MAC↔PCS boundary. RX response to recessive res is observable as either protocol exception event or `Error(form)` at MAC↔FCE boundary, depending on `protocol_exception_enable` config. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-052"
source_clause = "§6.6.11.3"
original_wording = "If the bit is detected recessive, the bit rate shall be switched from the nominal bit rate of the arbitration phase to the preconfigured FD data bit rate of the data phase."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is processing an FD frame and `PCS_Data.Indicate(Input_Unit)` delivers the BRS bit value at the BRS bit position"
event = "`PCS_Data.Indicate(Input_Unit=recessive)` is received at the BRS bit position (BRS sampled as recessive)"
postcondition = "MAC issues `PCS_Status.Transmitter(D_Transmit=active)` to PCS, signalling a switch from nominal arbitration bit rate to the preconfigured FD data bit rate for subsequent `PCS_Data.Request` calls"
flags = []
notes = "BRS=recessive triggers the bit rate switch. BRS=dominant means no switch. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "`PCS_Status.Transmitter(D_Transmit=active)` at MAC↔PCS boundary signals the bit-rate switch after recessive BRS. Subsequent `PCS_Data.Request` timing reflects data bit rate. Both are observable at MAC↔PCS boundary. [Rule 1b]"

[[requirement]]
id = "REQ-MAC-053"
source_clause = "§6.6.11.3"
original_wording = "When the ESI bit of the LLC frame is set, then this flag shall be transmitted recessive, else this flag shall be transmitted dominant by error active nodes and shall be transmitted recessive by error passive nodes."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is serialising the ESI bit of an FD frame; LLC ESI flag value and FCE error state (`Error_passive_request` received or not) are known"
postcondition = "If LLC ESI=1: MAC issues `PCS_Data.Request(Output_Unit=recessive)`; if LLC ESI=0 and node is error-active (no `Error_passive_request` from FCE): MAC issues `PCS_Data.Request(Output_Unit=dominant)`; if LLC ESI=0 and node is error-passive (`Error_passive_request` received from FCE): MAC issues `PCS_Data.Request(Output_Unit=recessive)`"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: three sub-claims depending on LLC ESI value and FCE error state. EXTERNAL_DEP: Error Active/Passive state is owned by FCE (§8). Only FB and FE apply."
label = ""
file = ""

# ── §6.6.11.4 Data field (FD) ──
observability = "external"
observability_rationale = "ESI bit appears as `PCS_Data.Request(Output_Unit)` at MAC↔PCS boundary. ESI polarity is directly observable; the three sub-cases (LLC ESI=1, error-active, error-passive) map to recessive, dominant, and recessive Output_Unit respectively. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-054"
source_clause = "§6.6.11.4"
original_wording = "The data field shall consist of the data passed from the LLC frame, the number of bytes given by frame format and DLC. The data bytes are transmitted sequentially starting with byte 0, each byte shall contain eight bit."
shape = "invariant"
scope = "frame"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC has received the LLC frame SDU with DLC > 0 for an FD frame and is serialising the data field via `PCS_Data.Request` calls; byte count is determined by format and DLC per Table 5"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=X)` for each data bit sequentially: bytes 0 through (DLC-to-byte-count per Table 5)-1, each byte transmitted MSB (bit 7) first, matching the corresponding byte of the LLC frame SDU"
flags = []
notes = "Substantively similar to REQ-MAC-041 (CC data field) but the DLC-to-byte mapping differs for FD frames (DLC 9–15 map to 12–64 bytes per Table 5). Only FB and FE apply."
label = ""
file = ""

# ── §6.6.11.5 CRC field (FD) ──
side = "both"
observability = "external"
observability_rationale = "FD data bytes appear as `PCS_Data.Request(Output_Unit)` sequence at MAC↔PCS boundary, MSB first per byte, byte 0 first, with Table 5 DLC-to-byte-count mapping. Testbench verifies Output_Unit sequence matches LLC frame SDU. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-055"
source_clause = "§6.6.11.5"
original_wording = "The CRC field shall contain the stuff count and the FCRC sequence followed by a recessive CRC delimiter."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC has completed the FD data field and is serialising the CRC field via `PCS_Data.Request` calls"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=X)` for the stuff count (SBC) bits, then `PCS_Data.Request(Output_Unit=X)` for each FCRC bit in MSB-first order, then `PCS_Data.Request(Output_Unit=recessive)` for the CRC delimiter"
flags = []
notes = "FD CRC field structure differs from CC by including the stuff count (SBC) before the FCRC. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "FD CRC field structure (SBC, FCRC, recessive delimiter) appears as `PCS_Data.Request(Output_Unit)` sequence at MAC↔PCS boundary. Field structure and ordering are externally verifiable; SBC value and CRC polynomial correctness are derived. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-056"
source_clause = "§6.6.11.5"
original_wording = "In FD frames, the stuff count shall be at the beginning of the CRC field. It shall represent a number in the range from 0 to 7d (Gray-coded in SBC3, SBC2, and SBC1; followed by the parity bit SBC0) as specified in Table 8."
shape = "invariant"
scope = "frame"
side ="both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "The CRC field of an FD frame is being constructed; `PCS_Data.Request(Output_Unit)` calls are about to be issued for the stuff count and FCRC bits at the MAC↔PCS boundary"
postcondition = "The first four `PCS_Data.Request(Output_Unit)` calls of the CRC field carry the stuff count (SBC3, SBC2, SBC1 Gray-coded, SBC0 parity), encoding the number of dynamic stuff bits modulo 8; verifying the SBC value requires independently counting dynamic stuff bits using the 5-consecutive-bit stuffing algorithm (non-trivial)"
flags = []
notes = "The Gray coding and parity are specified in Table 8. Only FB and FE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The stuff count field manifests as four `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying the Gray-coded value and parity requires independently counting dynamic stuff bits over the entire bit stream using the 5-consecutive-bit stuffing algorithm — non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-057"
source_clause = "§6.6.11.5"
original_wording = "Both transmitter and receivers of a frame shall count the number of stuff bits before the first fixed stuff bit in the frame. The transmitter shall transmit its stuff bit count, coded as stuff count, at the beginning of the CRC field, before the FCRC sequence. Receivers shall check whether the received stuff count matches with the value calculated from their own stuff bit count."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame is being transmitted or received"
postcondition = "TX node: the SBC Gray-coded count appears as four `PCS_Data.Request(Output_Unit)` calls at the start of the CRC field, encoding the number of dynamic stuff bits modulo 8; RX node: if the received SBC (from `PCS_Data.Indicate(Input_Unit)`) does not match the independently computed count, `Error(form)` is signalled to FCE; verifying correctness requires counting dynamic stuff bits over the entire frame using the stuffing algorithm (non-trivial)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) both TX/RX count stuff bits; (2) TX transmits SBC; (3) RX checks SBC match. Only FB and FE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The SBC value manifests as `PCS_Data.Request(Output_Unit)` calls (TX) and RX mismatch as `Error(form)` at MAC↔FCE, but verifying correctness requires independently counting dynamic stuff bits before the first fixed stuff bit using the stuffing algorithm — non-trivial algorithm beyond reading config generics"

[[requirement]]
id = "REQ-MAC-058"
source_clause = "§6.6.11.5"
original_wording = "The relevant bit stream for the CRC calculation shall be the bit stream consisting of SOF, arbitration field, control field, and (if present) data field. The stuff count and the dynamic stuff bits, but not the fixed stuff bits, shall be included in the relevant bit stream for CRC calculation of FD frames."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "CRC_17 or CRC_21 is being calculated for an FD frame; `PCS_Data.Request(Output_Unit)` calls have been issued for SOF through the last data bit, with dynamic stuff bits and stuff count included"
postcondition = "The FCRC field appears as `PCS_Data.Request(Output_Unit=X)` calls at the MAC↔PCS boundary; correct values require applying CRC_17 or CRC_21 to the bit stream: SOF + arbitration + control + data + stuff count + dynamic stuff bits, with fixed stuff bits excluded (verification requires de-stuffing and independent polynomial computation)"
flags = []
notes = "Key difference from CC CRC (REQ-MAC-043): FD CRC includes dynamic stuff bits and stuff count. Only FB and FE apply."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The FCRC field bits manifest as `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying that the CRC input stream correctly includes dynamic stuff bits and stuff count while excluding fixed stuff bits requires de-stuffing the stream and applying CRC_17/CRC_21 — a non-trivial two-step algorithm"

[[requirement]]
id = "REQ-MAC-059"
source_clause = "§6.6.11.5"
original_wording = "The CRC delimiter shall follow the FCRC sequence. In FD frames, the CRC delimiter may consist of one or two recessive bits. A transmitter shall send one recessive bit as CRC delimiter, but it shall accept two recessive bits before the edge from recessive to dominant that starts the acknowledge slot."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC transmitter has completed the FCRC sequence of an FD frame and is serialising the CRC delimiter position via `PCS_Data.Request`"
postcondition = "(1) TX issues exactly one `PCS_Data.Request(Output_Unit=recessive)` as CRC delimiter; (2) TX accepts up to two consecutive recessive `PCS_Data.Indicate(Input_Unit=recessive)` values before the dominant edge that starts the ACK slot"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) TX sends 1 recessive; (2) accepts 2 recessive before ACK edge. This allows phase compensation between TX and RX bit timing. Only FB and FE apply."
label = ""
file = ""

# ── §6.6.11.6 ACK field (FD) ──
observability = "external"
observability_rationale = "`PCS_Data.Request(Output_Unit=recessive)` for the CRC delimiter is directly observable at MAC↔PCS boundary. TX acceptance of two recessive bits is verifiable by injecting a second recessive via `PCS_Data.Indicate` and confirming no error signal at MAC↔FCE boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-060"
source_clause = "§6.6.11.6"
original_wording = "The ACK field shall contain the ACK slot and the ACK delimiter. ; In the ACK field, the transmitter node shall send recessive bits. All receivers check the consistency of the received DF and shall acknowledge a consistent frame and shall flag an inconsistent frame by means of an EF. A DF that is not acknowledged shall be regarded as corrupted and shall be flagged by the transmitting node with an EF."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is processing an FD frame ACK field at the MAC↔PCS boundary"
postcondition = "(1) TX: MAC issues `PCS_Data.Request(Output_Unit=recessive)` for both ACK slot and ACK delimiter; (2) RX with matching FCRC: MAC issues `PCS_Data.Request(Output_Unit=dominant)` in ACK slot; (3) RX with inconsistent frame: MAC signals `Error/Overload_flag` to FCE; (4) TX detecting no dominant in ACK slot via `PCS_Data.Indicate`: MAC signals `Error(ACK)` to FCE"
flags = ["COMPOUND"]
notes = "COMPOUND: multiple sub-claims. Substantively similar to REQ-MAC-044/051 for CC but applies only to DFs (no FD remote frames). Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "TX ACK field Output_Unit values, RX `PCS_Data.Request(Output_Unit=dominant)` in ACK slot, and error signals (`Error/Overload_flag`, `Error(ACK)`) at MAC↔FCE boundary are all observable at MAC layer boundaries. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-061"
source_clause = "§6.6.11.6"
original_wording = "Nodes that receive the matching FCRC sequence and the matching stuff count shall send an ACK within the ACK slot by overwriting the recessive bit of the transmitter with a dominant bit (they send ACK). ; In FD frames, all nodes shall accept an up to two bit long dominant phase of overlapping ACK slot bits as a valid ACK, to compensate for phase shifts between the receivers."
shape = "triggered"
scope = "bus"
side = "receiver"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "An FD frame has been received via `PCS_Data.Indicate` calls with matching FCRC and matching stuff count; the ACK slot position is reached"
event = "The ACK slot position is reached; receiver's FCRC and SBC comparisons passed; MAC issues `PCS_Data.Request(Output_Unit=dominant)` for the ACK slot bit"
postcondition = "(1) Receiver MAC issues `PCS_Data.Request(Output_Unit=dominant)` in the ACK slot; (2) all nodes accept up to a 2-bit-long dominant phase in the ACK slot as a valid ACK (no `Error(ACK)` signalled for 1- or 2-bit dominant ACK duration)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) receivers with matching FCRC+SBC send dominant ACK; (2) all nodes accept up to 2-bit dominant as valid ACK. The 2-bit tolerance compensates for phase shifts. Bus-scope because the receiver's dominant overwrites the TX's recessive. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Receiver's `PCS_Data.Request(Output_Unit=dominant)` in ACK slot is observable at MAC↔PCS boundary. Acceptance of 2-bit dominant phase is verifiable by confirming absence of `Error(ACK)` at MAC↔FCE boundary when a 2-bit dominant ACK is injected via `PCS_Data.Indicate`. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-062"
source_clause = "§6.6.13.2"
original_wording = "Dynamic bit stuffing shall be used in CC frames from the SOF up to and including the FCRC sequence. ; Dynamic bit stuffing shall be used in FD frames from the SOF up to and including the data field."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is serialising or receiving a frame region subject to dynamic bit stuffing via `PCS_Data.Request` or `PCS_Data.Indicate` calls"
postcondition = "For CC frames: dynamic stuffing applies to `PCS_Data.Request` calls from SOF through and including the FCRC sequence. For FD frames: dynamic stuffing applies from SOF through and including the data field. Bit stuffing is not applied outside these regions"
flags = []
notes = "The dynamic stuffing range differs between CC and FD. In FD frames, the CRC field uses fixed stuffing instead. All four in-scope formats use dynamic stuffing."
label = ""
file = ""
observability = "external"
observability_rationale = "Dynamic stuff bit insertions appear as additional `PCS_Data.Request(Output_Unit)` calls at MAC↔PCS boundary. Testbench verifies stuff bits are present in correct regions and absent outside them by counting Output_Unit calls. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-063"
source_clause = "§6.6.13.2"
original_wording = "Whenever a transmitter detects five consecutive bits (including dynamic stuff bits) of the identical value in the bit stream to be transmitted, it shall insert a complementary bit (called dynamic stuff bit) into the actual transmitted bit stream."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC transmitter is in a frame region subject to dynamic bit stuffing and is issuing `PCS_Data.Request` calls"
event = "Five consecutive `PCS_Data.Request(Output_Unit=X)` calls with identical Output_Unit value have been issued"
postcondition = "MAC issues an additional `PCS_Data.Request(Output_Unit=Y)` where Y is the complement of X (the dynamic stuff bit), before resuming normal frame bits"
flags = []
notes = "The stuff bit is the inverse of the preceding five bits. All four in-scope formats use this rule in their dynamic stuffing regions."
label = ""
file = ""
observability = "external"
observability_rationale = "Complementary stuff bit appears as `PCS_Data.Request(Output_Unit=Y)` (complement of preceding five) at MAC↔PCS boundary. Directly countable and verifiable from Output_Unit sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-064"
source_clause = "§6.6.13.2"
original_wording = "The receiver shall recognize a sequence of five consecutive bits of identical value and shall discard the following dynamic stuff bit."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC receiver is in a frame region subject to dynamic bit stuffing and is receiving `PCS_Data.Indicate(Input_Unit)` calls"
event = "Five consecutive `PCS_Data.Indicate(Input_Unit=X)` calls with identical Input_Unit value have been received"
postcondition = "MAC receiver discards the next `PCS_Data.Indicate(Input_Unit)` call (the dynamic stuff bit) and does not pass it to the de-serialised frame data delivered to LLC"
flags = []
notes = "Mirror of REQ-MAC-064 for the receiver side. All four in-scope formats use this rule."
label = ""
file = ""

# ── §6.6.13.3.1 Fixed bit stuffing (FD CRC field) ──
observability = "external"
observability_rationale = "Correct de-stuffing verifiable by comparing LLC frame SDU at LLC↔MAC boundary with original LLC data: one fewer bit per five-run means stuff bits are correctly discarded. Stuff bit positions are determined by trivial counting of `PCS_Data.Indicate` calls. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-065"
source_clause = "§6.6.13.3.1"
original_wording = "In the CRC field of FD frames, the stuff bits shall be inserted at fixed positions; they are called fixed stuff bits. There shall be a fixed stuff bit before the first bit of the stuff count, even if the last bits of the preceding field are not a sequence of five consecutive bits of identical value."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC has completed the FD data field (or control field if DLC=0) and is now serialising the CRC field via `PCS_Data.Request` calls"
postcondition = "MAC inserts a fixed stuff bit (one `PCS_Data.Request(Output_Unit)` call with value = complement of last bit before CRC field) before the first bit of the stuff count, regardless of the preceding bit pattern"
flags = []
notes = "This is the start of fixed stuffing in FD CRC. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Fixed stuff bit before the first SBC bit appears as `PCS_Data.Request(Output_Unit)` at MAC↔PCS boundary at a fixed, known position (immediately before first SBC bit). Testbench verifies Output_Unit polarity and position. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-066"
source_clause = "§6.6.13.3.1"
original_wording = "If the last bits of the preceding field are a sequence of five consecutive bits of identical value, there shall be only the fixed stuff bit, there shall not be two consecutive stuff bits."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is at the boundary between the data field and CRC field of an FD frame and the last five bits of the preceding field were all identical (five consecutive same-value bits ending the data/control field)"
postcondition = "MAC inserts exactly one fixed stuff bit (`PCS_Data.Request(Output_Unit)` = complement of last bit) at the CRC field boundary; no additional dynamic stuff bit is inserted, so only one stuff bit appears between the data/control field and the SBC"
flags = []
notes = "Prevents double-stuffing at the dynamic-to-fixed stuffing boundary. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Only one `PCS_Data.Request(Output_Unit)` stuff bit appears at the data-to-CRC boundary, not two. Testbench verifies Output_Unit count is one, not two, when data field ends with five identical bits. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-067"
source_clause = "§6.6.13.3.1"
original_wording = "A further fixed stuff bit shall be inserted after each fourth bit of the CRC field."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is serialising the FD CRC field via `PCS_Data.Request` calls and the initial fixed stuff bit before the SBC has already been issued"
postcondition = "MAC inserts one additional `PCS_Data.Request(Output_Unit)` fixed stuff bit call after every 4 CRC field data bits throughout the remainder of the CRC field"
flags = []
notes = "The fixed stuffing period is 4 data bits per stuff bit in the FD CRC field. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Fixed stuff bits appear as `PCS_Data.Request(Output_Unit)` calls at fixed positions (every 4th CRC bit) in the Output_Unit sequence at MAC↔PCS boundary. Positions are deterministic and directly countable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-068"
source_clause = "§6.6.13.3.1"
original_wording = "The value of such a fixed stuff bit shall be the inverse value of the bit preceding the fixed stuff bit."
shape = "invariant"
scope = "frame"
side = "both"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "MAC is at a fixed stuff bit position in the FD CRC field and is about to issue `PCS_Data.Request` for that stuff bit"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=Y)` for the fixed stuff bit, where Y is the complement of the Output_Unit value from the immediately preceding `PCS_Data.Request` call"
flags = []
notes = "Unlike dynamic stuffing (triggered by 5 identical bits), fixed stuff bits always alternate from the preceding bit. Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Fixed stuff bit `PCS_Data.Request(Output_Unit=Y)` value is directly verifiable as complement of the preceding Output_Unit in the sequence at MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-069"
source_clause = "§6.6.13.3.1"
original_wording = "A receiver shall discard the fixed stuff bits from the bit stream for the CRC check. It shall detect a form error if the fixed stuff bit has the same value as its preceding bit."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "The receiver is processing the CRC field of an FD frame"
event = "A fixed stuff bit position is reached in the `PCS_Data.Indicate(Input_Unit)` stream during CRC field reception"
postcondition = "The fixed stuff bit is excluded from the CRC input stream; if the fixed stuff bit `PCS_Data.Indicate(Input_Unit)` value equals its predecessor, `Error(form)` is signalled at the MAC↔FCE boundary; verifying fixed stuff bit positions and the CRC exclusion requires tracking the FD frame structure and applying the stuffing position algorithm (non-trivial)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) discard fixed stuff bits for CRC; (2) form error on wrong value. Only FB and FE apply."
label = ""
file = ""

# ── §6.6.13.3.2 CAN XL data phase — out of scope, skipped ──

# ── §6.6.14 Data frame acknowledgement ──
observability = "derived"
observability_rationale = "[Rule 2] Fixed stuff bit violations manifest as `Error(form)` at the MAC↔FCE boundary, but verifying correct discard from the CRC stream requires identifying fixed stuff bit positions (determined by the stuffing algorithm applied to the FD frame structure) and confirming their exclusion from the CRC input — non-trivial multi-step tracking"

[[requirement]]
id = "REQ-MAC-070"
source_clause = "§6.6.14"
original_wording = "All receivers shall check the consistency of all received DFs and RFs and they shall acknowledge all consistent DFs and RFs."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A DF or RF has been received via `PCS_Data.Indicate` calls and the ACK slot position is reached"
postcondition = "For a consistent frame: MAC issues `PCS_Data.Request(Output_Unit=dominant)` in the ACK slot. For an inconsistent frame: MAC does not issue dominant ACK and signals `Error/Overload_flag` to FCE"
flags = []
notes = "General acknowledgement obligation for all frame types. RF applies only to CB and CE. All four in-scope formats share this rule."
label = ""
file = ""
observability = "external"
observability_rationale = "ACK (`PCS_Data.Request(Output_Unit=dominant)`) or withheld ACK is directly observable at MAC↔PCS boundary. Error signal (`Error/Overload_flag`) for inconsistent frames is observable at MAC↔FCE boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-071"
source_clause = "§6.6.14"
original_wording = "Acknowledgement shall not depend on the frame's identifier."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A receiver is in the ACK slot of a consistent frame received via `PCS_Data.Indicate` calls; the frame identifier value varies across test cases"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=dominant)` in the ACK slot for all consistent frames regardless of the identifier value delivered by `PCS_Data.Indicate` during the arbitration field"
flags = []
notes = "Ensures all receivers ACK all consistent frames regardless of ID (acceptance filtering is an LLC function). All four formats share this rule."
label = ""
file = ""

# ── §6.6.15.2 Frame validation (error signalling enabled) ──
observability = "external"
observability_rationale = "`PCS_Data.Request(Output_Unit=dominant)` in ACK slot is observable at MAC↔PCS boundary for all injected identifier values. Testbench sweeps identifier values and verifies dominant ACK for each consistent frame. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-072"
source_clause = "§6.6.15.2"
original_wording = "The frame shall be valid for receivers if there is no error until the last but one bit of EOF. ; The value of the last bit of EOF shall not inhibit frame validation and a dominant value shall not lead to a form error. ; A receiver that detects a dominant bit at the last bit of EOF shall respond with an OF (see 6.6.21)."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; a frame is being received via `PCS_Data.Indicate` calls"
postcondition = "(1) Frame is valid for RX if no error detected through the 6th EOF bit (i.e., MAC delivers `Transfer_Status=successful` to LLC); (2) dominant `PCS_Data.Indicate(Input_Unit=dominant)` at 7th (last) EOF bit does not inhibit frame validation; (3) dominant at last EOF bit triggers MAC to transmit an overload frame (not signal `Error(form)` to FCE)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) valid if no error through 6th EOF bit; (2) 7th EOF bit does not inhibit validation; (3) dominant at 7th EOF → OF. All four formats share this validation rule."
label = ""
file = ""
observability = "external"
observability_rationale = "`Transfer_Status` at LLC↔MAC boundary is observable for validation. OF transmission appears as dominant `PCS_Data.Request` calls at MAC↔PCS boundary. Absence of `Error(form)` at MAC↔FCE boundary for dominant last EOF bit is verifiable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-073"
source_clause = "§6.6.15.2"
original_wording = "The frame shall be valid for a transmitter if there is no error until the end of EOF."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; a frame is being transmitted via `PCS_Data.Request` calls"
postcondition = "Frame is valid for TX only if no error detected through all 7 EOF bits; MAC delivers `Transfer_Status=successful` to LLC (via `Successful_transfer` at MAC↔FCE) only after successful completion of the full EOF without error"
flags = []
notes = "TX validation is stricter than RX: TX must see all 7 EOF bits without error. All four formats share this rule."
label = ""
file = ""

# ── §6.6.16 Order of bit transmission ──
observability = "external"
observability_rationale = "`Transfer_Status` at LLC↔MAC boundary is observable. `Successful_transfer` to FCE is observable at MAC↔FCE boundary. Error flag `PCS_Data.Request` calls indicate TX detected an error before EOF completion. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-074"
source_clause = "§6.6.16"
original_wording = "Within a field, the MSB is transmitted first. Within the data field, the bytes are transferred from byte 0 to the last byte (indicated by the DLC). Within each byte, the bits are transferred from bit(7) down to bit(0)."
shape = "invariant"
scope = "frame"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC has received the LLC frame SDU and is serialising frame fields via `PCS_Data.Request` calls"
postcondition = "Within each field, `PCS_Data.Request(Output_Unit)` calls are issued with MSB first. Within the data field, `PCS_Data.Request` calls sequence bytes from byte 0 to the last byte (per DLC). Within each byte, bits are issued from bit(7) down to bit(0)"
flags = []
notes = "Defines the bit ordering for all frame fields. All four in-scope formats use the same MSB-first ordering."
label = ""
file = ""

# ── §6.6.17.1 Bus access ──
side = "both"
observability = "external"
observability_rationale = "Bit ordering is verifiable by comparing the `PCS_Data.Request(Output_Unit)` sequence at MAC↔PCS boundary against the known LLC frame SDU, confirming MSB-first ordering within each field. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-075"
source_clause = "§6.6.17.1"
original_wording = "The mechanism to resolve the resulting bus access conflict shall be identifier-based arbitration."
shape = "invariant"
scope = "bus"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "Multiple nodes simultaneously issue `PCS_Data.Request(Output_Unit)` calls for the start of a frame; at least two nodes are competing for bus access"
postcondition = "The node that loses arbitration stops issuing `PCS_Data.Request(Output_Unit)` calls when it detects a mismatch between its `PCS_Data.Request` value and the `PCS_Data.Indicate(Input_Unit)` value (dominant overrides recessive); the node with the lower identifier wins and continues transmitting"
flags = []
notes = "Bus-scope because arbitration is inherently a multi-node interaction. All four formats use the same arbitration mechanism."
label = ""
file = ""

# ── §6.6.17.2 Protocol exception event ──
side = "both"
observability = "external"
observability_rationale = "Arbitration loss observable when a node's `PCS_Data.Request(Output_Unit=recessive)` is overridden by a dominant `PCS_Data.Indicate(Input_Unit=dominant)` from the bus. Winning node continues `PCS_Data.Request` calls. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-076"
source_clause = "§6.6.17.2"
original_wording = "As a reaction to the protocol exception event, the error counters shall not be changed, the hard synchronization shall be enabled, the node shall send recessive bits and shall enter the bus re-integration state (see 6.6.7.5)."
shape = "triggered"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A protocol exception event has happened in the node"
event = "The protocol exception event is detected (r0 bit received recessive in CBFF or equivalent FDF mismatch)"
postcondition = "The node issues only `PCS_Data.Request(Output_Unit=recessive)` calls and enables hard synchronization; FCE error counters are not incremented (EXTERNAL_DEP); verifying that error counters are unchanged requires observing the FCE boundary — multi-step protocol state tracking across MAC and FCE layers"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: four distinct sub-claims. EXTERNAL_DEP: error counters are owned by FCE (§8). All four formats share the same protocol exception response."
label = ""
file = ""

# ── §6.6.17.4 Identifier based arbitration ──
side = "both"
observability = "derived"
observability_rationale = "[Rule 2] Recessive `PCS_Data.Request(Output_Unit=recessive)` calls manifest at the MAC↔PCS boundary, but verifying that error counters were not incremented requires observing the FCE boundary (EXTERNAL_DEP) and tracking protocol state across the protocol exception event — multi-step cross-layer tracking"

[[requirement]]
id = "REQ-MAC-077"
source_clause = "§6.6.17.4"
original_wording = "During arbitration, every transmitter shall compare the level of the bit transmitted with the level monitored on the bus. If these levels are equal, the transmitter may continue to send. When a CAN node sends a recessive level and monitors a dominant level, the CAN node loses arbitration and shall withdraw from transmitting any more bits, and it shall become receiver of this frame."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is transmitting during the arbitration phase; it has issued `PCS_Data.Request(Output_Unit=recessive)` for a bit and is monitoring the bus via `PCS_Data.Indicate(Input_Unit)` at the corresponding sample point"
event = "`PCS_Data.Request(Output_Unit=recessive)` was issued and `PCS_Data.Indicate(Input_Unit=dominant)` is received at the corresponding sample point"
postcondition = "The node ceases issuing `PCS_Data.Request(Output_Unit)` calls for the frame and switches to monitoring `PCS_Data.Indicate(Input_Unit)` as a receiver; verifying arbitration loss requires correlating each `PCS_Data.Request` with the subsequent `PCS_Data.Indicate` at the sample point — requiring tracking of the Output_Unit/Input_Unit correspondence over multiple bit times (non-trivial)"
flags = []
notes = "General arbitration rule applicable to all formats. The specific arbitration range depends on format (see REQ-MAC-041 for CC, REQ-MAC-056 for FD). All four in-scope formats share this fundamental arbitration behavior."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] Arbitration loss manifests as cessation of `PCS_Data.Request(Output_Unit)` calls at the MAC↔PCS boundary, but verifying the trigger (recessive sent, dominant monitored) requires correlating each `PCS_Data.Request` with its corresponding `PCS_Data.Indicate` at the sample point — tracking the Output_Unit/Input_Unit correspondence over multiple bit times"

[[requirement]]
id = "REQ-MAC-078"
source_clause = "§6.6.17.4"
original_wording = "When a dominant level is sent and a recessive level is monitored, the node shall detect a bit error."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is transmitting; it has issued `PCS_Data.Request(Output_Unit=dominant)` for a bit and is monitoring the bus via `PCS_Data.Indicate(Input_Unit)` at the corresponding sample point"
event = "`PCS_Data.Request(Output_Unit=dominant)` was issued and `PCS_Data.Indicate(Input_Unit=recessive)` is received at the corresponding sample point"
postcondition = "A bit error is detected and `Error(bit)` is signalled at the MAC↔FCE boundary; verifying requires correlating the `PCS_Data.Request(Output_Unit=dominant)` with the `PCS_Data.Indicate(Input_Unit=recessive)` at the sample point — matching Output_Unit to Input_Unit at the correct bit time (non-trivial correlation across boundary)"
flags = []
notes = "Dominant-sent-recessive-monitored during arbitration is always a bit error (the bus should be at least as dominant as what the node sent). All four formats share this rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The bit error triggers `Error(bit)` at the MAC↔FCE boundary, but verifying the specific condition (dominant sent, recessive monitored) requires correlating `PCS_Data.Request(Output_Unit=dominant)` with `PCS_Data.Indicate(Input_Unit=recessive)` at the corresponding sample point — non-trivial pairing across boundary primitives"

[[requirement]]
id = "REQ-MAC-079"
source_clause = "§6.6.17.4"
original_wording = "Identifier based arbitration shall be performed in CBFF from the first bit of the identifier up to the IDE bit, in CEFF from the first bit of the identifier up to the RTR bit, and in FBFF, FEFF from the first bit of the identifier up to the bit following the FDF bit."
shape = "invariant"
scope = "frame"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "Arbitration is in progress; MAC is comparing `PCS_Data.Request(Output_Unit)` with `PCS_Data.Indicate(Input_Unit)` for each bit in the arbitration range"
postcondition = "The Output_Unit vs Input_Unit comparison is performed for: CBFF from ID bit(28) through IDE bit; CEFF from ID bit(28) through RTR bit; FBFF and FEFF from ID bit(28) through the bit following FDF. No comparison for bits outside these ranges"
flags = []
notes = "Defines format-specific arbitration endpoints. All four in-scope formats are covered."
label = ""
file = ""

# ── §6.6.18 MAC data consistency ──
observability = "external"
observability_rationale = "Arbitration range is verifiable by injecting a dominant `PCS_Data.Indicate` at each bit position and observing whether MAC signals arbitration loss: only bits within the format-specific range trigger loss. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-080"
source_clause = "§6.6.18"
original_wording = "Data consistency of transmitted MAC frames from a shared memory shall be ensured by at least one of two methods. The MAC entity shall store the whole frame content to be transmitted in a temporary buffer that is filled before the transmission is started. ; The LLC entity shall check for data errors while the frame content to be transmitted is transferred to the MAC entity."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC frames are to be transmitted from shared memory; `PCS_Data.Request(Output_Unit)` calls will be issued sequentially for each frame bit"
postcondition = "The `PCS_Data.Request(Output_Unit)` sequence faithfully represents a consistent snapshot of the LLC frame SDU (no torn reads); verifying data consistency requires comparing the LLC-supplied data against the complete `PCS_Data.Request` sequence — the specific buffering/locking mechanism ensuring consistency is internal to MAC (non-trivial)"
flags = ["COMPOUND"]
notes = "COMPOUND: two alternative methods. Either method satisfies the requirement. All four formats share the same data consistency obligation."
label = ""
file = ""

# ── §6.6.19 Restricted operation ──
observability = "derived"
observability_rationale = "[Rule 2] Data consistency manifests in the `PCS_Data.Request(Output_Unit)` sequence matching the LLC-supplied frame content, but verifying no torn reads occurred requires comparing the complete `PCS_Data.Request` sequence against the LLC input — the internal buffering/locking mechanism is not observable at the boundary"

[[requirement]]
id = "REQ-MAC-081"
source_clause = "§6.6.19"
original_wording = "CAN nodes shall support the restricted operation mode, in which they shall be able to receive DFs and RFs and shall acknowledge valid frames by means of transmitting a dominant bit in the ACK slot. But CAN nodes in restricted operation mode shall not transmit DFs and RFs. ; In case of an error condition or an overload condition, CAN nodes shall not send dominant bits. Instead they shall treat this as a protocol exception event and shall enter the bus re-integration state (see 6.6.7.5). ; The error counters shall neither be incremented nor decremented while the CAN node is in restricted operation mode. ; Nodes that do not support the XL frame format are not required to implement the restricted operation mode."
shape = "invariant"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The CAN node is configured in restricted operation mode; `error_signalling_enable` may be true"
postcondition = "(1) MAC accepts `PCS_Data.Indicate` calls (receives DFs/RFs) and issues `PCS_Data.Request(Output_Unit=dominant)` for ACK of valid frames; (2) MAC does not initiate frame transmission (no `PCS_Data.Request` calls for DFs/RFs); (3) on error or overload condition MAC issues no dominant `PCS_Data.Request` and instead triggers a protocol exception event; (4) FCE error counters receive neither increment nor decrement signals from MAC while in restricted mode"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: (1) receive and ACK; (2) no TX; (3) no dominant on error/overload → protocol exception; (4) error counters frozen; (5) non-XL nodes not required to implement. EXTERNAL_DEP: error counters owned by FCE. All four formats may be received in restricted mode."
label = ""
file = ""

# ── §6.6.20 Bus monitoring ──
observability = "external"
observability_rationale = "(1) Dominant ACK `PCS_Data.Request` is observable at MAC↔PCS boundary; (2) absence of TX frame `PCS_Data.Request` sequences is observable; (3) no dominant `PCS_Data.Request` on error is observable; (4) absence of error counter signals at MAC↔FCE boundary is verifiable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-082"
source_clause = "§6.6.20"
original_wording = "CAN nodes may provide the bus monitoring mode, where they shall be able to receive valid DFs and valid RFs, but the bus monitoring mode sends only recessive bits on the CAN bus and does not start a transmission. If the MAC sub-layer is required to send a dominant bit (ACK bit, overload flag, active error flag), the bit shall be rerouted internally so that the MAC sub-layer monitors this dominant bit, although the CAN bus can remain in recessive state."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The CAN node is configured in bus monitoring mode"
postcondition = "(1) MAC accepts `PCS_Data.Indicate` calls (receives valid DFs/RFs); (2) MAC issues only `PCS_Data.Request(Output_Unit=recessive)` calls — no dominant bits are sent to the bus; (3) when MAC logic would require a dominant bit (ACK, overload flag, active error flag), the dominant bit is rerouted internally (MAC observes it internally but `PCS_Data.Request` remains recessive)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) receive valid frames; (2) send only recessive; (3) dominant bits rerouted internally. All four formats may be monitored. This is an optional mode ('may provide')."
label = ""
file = ""

# ── §6.6.21.1 Control of error signalling ──
observability = "external"
observability_rationale = "Only `PCS_Data.Request(Output_Unit=recessive)` calls appear at MAC↔PCS boundary in bus monitoring mode. Absence of dominant Output_Unit calls is directly verifiable. Internal rerouting effect is confirmed by the bus remaining recessive during ACK and error flag positions. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-083"
source_clause = "§6.6.21.2"
original_wording = "A node sending a bit on the bus shall also monitor the bus. A bit error shall be detected at that bit time, when the bit value that is monitored differs from the bit value sent. ; Exception 1: A monitored dominant bit shall not lead to a bit error when a recessive bit, which is not a dynamic stuff bit, is sent during arbitration, or a recessive bit is sent during ACK slot. ; Exception 2: A node sending a passive error flag and detecting a dominant bit shall not interpret this as a bit error."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "The node is transmitting a bit via `PCS_Data.Request(Output_Unit=X)` and is also monitoring the bus via `PCS_Data.Indicate(Input_Unit)` at the corresponding sample point"
event = "`PCS_Data.Indicate(Input_Unit=Y)` is received where Y ≠ X (monitored value differs from transmitted value)"
postcondition = "`Error(bit)` is signalled at the MAC↔FCE boundary, EXCEPT: (1) dominant monitored while recessive non-stuff-bit was sent during arbitration or ACK slot; (2) dominant detected during passive error flag; verifying exception applicability requires tracking MAC protocol state (arbitration phase, stuff bit status, error-passive flag state) across multiple bit times — multi-step protocol tracking (non-trivial)"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) bit error on mismatch; (2) exception for arbitration/ACK; (3) exception for passive error flag. All four formats share the same bit error detection rules."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] Bit error detection manifests as `Error(bit)` at the MAC↔FCE boundary, but verifying the three exception conditions (arbitration recessive non-stuff, ACK slot, passive error flag) requires tracking MAC protocol state (phase, stuff bit history, error mode) across multiple `PCS_Data.Request`/`PCS_Data.Indicate` pairs — multi-step protocol state tracking"

[[requirement]]
id = "REQ-MAC-084"
source_clause = "§6.6.21.2"
original_wording = "A stuff error shall be detected at the bit time of the sixth consecutive equal bit level in a field that is coded by the method of dynamic bit stuffing."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is receiving `PCS_Data.Indicate(Input_Unit)` calls in a frame region coded by dynamic bit stuffing"
event = "Six consecutive `PCS_Data.Indicate(Input_Unit=X)` calls with identical Input_Unit value are received"
postcondition = "MAC signals `Error(stuff)` to FCE at the bit time of the sixth consecutive equal bit"
flags = []
notes = "Stuff errors apply only in dynamically-stuffed regions (SOF through FCRC for CC, SOF through data for FD). All four formats have dynamically-stuffed regions."
label = ""
file = ""
observability = "external"
observability_rationale = "`Error(stuff)` at MAC↔FCE boundary is directly observable. Testbench injects six consecutive identical `PCS_Data.Indicate(Input_Unit)` values and verifies `Error(stuff)` is signalled on the sixth. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-085"
source_clause = "§6.6.21.2"
original_wording = "The receivers shall calculate the CRC in the same way as the transmitter. ; A receiver shall detect an FCRC error when the calculated frame FCRC sequence does not equal the received one, or when the SBC of an FD frame does not match to the number of the received dynamic stuff bits, or when the SBC parity does not match."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame has been received via `PCS_Data.Indicate` calls and the CRC comparison point is reached (CRC delimiter sample point)"
event = "CRC comparison is performed after receiving the CRC field via `PCS_Data.Indicate` calls"
postcondition = "MAC signals `Error(CRC)` to FCE if: (1) calculated FCRC does not equal the received FCRC bits from `PCS_Data.Indicate`; or (2) for FD frames, SBC from `PCS_Data.Indicate` does not match count of received dynamic stuff bits; or (3) SBC parity does not match"
flags = ["COMPOUND"]
notes = "COMPOUND: three FCRC error conditions. SBC-related conditions apply only to FD frames (FB, FE). CRC calculation method is specified in §6.6.4.4. All four formats have FCRC checking."
label = ""
file = ""
observability = "external"
observability_rationale = "`Error(CRC)` at MAC↔FCE boundary is observable when corrupted CRC or SBC bits are injected via `PCS_Data.Indicate`. Testbench corrupts individual CRC/SBC bits and verifies `Error(CRC)` for each error condition. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-086"
source_clause = "§6.6.21.2"
original_wording = "A form error shall be detected in the following cases: when a fixed form bit field contains one or more unexpected bit values, or when a fixed stuff bit in an FD frame is not at its expected value. ; Exception 1: A receiver detecting a dominant bit at the last bit of EOF, or a node detecting a dominant bit at the last bit of the error delimiter or of the overload delimiter, shall not treat this as a form error."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC is receiving `PCS_Data.Indicate(Input_Unit)` calls at a fixed-form bit field position (CRC delimiter, ACK delimiter, EOF) or a fixed stuff bit position in an FD frame"
event = "`PCS_Data.Indicate(Input_Unit)` delivers an unexpected polarity at a fixed-form bit position, or a fixed stuff bit in an FD frame has the wrong polarity"
postcondition = "MAC signals `Error(form)` to FCE, EXCEPT: (1) dominant `PCS_Data.Indicate(Input_Unit=dominant)` at the last (7th) EOF bit for a receiver triggers an overload frame response, not `Error(form)`; (2) dominant at the last bit of error or overload delimiter for any node does not trigger `Error(form)`"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) form error on unexpected fixed-form value; (2) form error on wrong fixed stuff bit (FD); (3) exception for last EOF bit (RX); (4) exception for last delimiter bit. All four formats have fixed-form fields."
label = ""
file = ""
observability = "external"
observability_rationale = "`Error(form)` at MAC↔FCE boundary is observable when unexpected `PCS_Data.Indicate` values are injected at fixed-form positions. Absence of `Error(form)` for last EOF/delimiter bits (exception cases) is verifiable by injecting dominant at those positions. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-087"
source_clause = "§6.6.21.2"
original_wording = "A transmitter shall detect an ACK error whenever it does not detect a dominant bit during the ACK slot."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "MAC transmitter has issued `PCS_Data.Request(Output_Unit=recessive)` for the ACK slot bit and is sampling the bus via `PCS_Data.Indicate` at the sample point"
event = "`PCS_Data.Indicate(Input_Unit=recessive)` is received at the ACK slot sample point (no receiver sent dominant)"
postcondition = "MAC signals `Error(ACK)` to FCE"
flags = []
notes = "ACK error means no receiver acknowledged the frame. All four formats have an ACK slot and share this detection rule."
label = ""
file = ""

# ── §6.6.21.3.1 Error handling (error signalling enabled) ──
observability = "external"
observability_rationale = "`Error(ACK)` at MAC↔FCE boundary is directly observable. Testbench withholds dominant `PCS_Data.Indicate` during ACK slot and verifies `Error(ACK)` is signalled. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-088"
source_clause = "§6.6.21.3.1"
original_wording = "Whenever a bit error, a stuff error, a form error, a PCRC error, or an ACK error is detected by a node, the LLC sub-layer shall be informed, and the node shall start an error flag at the following bit."
shape = "triggered"
scope = "node"
side = "both"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; MAC is processing a frame via `PCS_Data.Request` or `PCS_Data.Indicate` calls"
event = "MAC signals `Error(bit)`, `Error(stuff)`, `Error(form)`, `Error(CRC)`, or `Error(ACK)` to FCE"
postcondition = "MAC informs LLC (delivers error `Transfer_Status`) and begins issuing `PCS_Data.Request(Output_Unit=dominant)` calls for the error flag starting at the next bit time after detection"
flags = []
notes = "This is the primary error response rule. The error flag type (active or passive) depends on FCE state. All four formats share this error handling rule."
label = ""
file = ""
observability = "external"
observability_rationale = "Error `Transfer_Status` at LLC↔MAC boundary and dominant `PCS_Data.Request(Output_Unit=dominant)` calls for the error flag at MAC↔PCS boundary are both directly observable. Timing (starts at next bit after detection) is verifiable. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-089"
source_clause = "§6.6.21.3.1"
original_wording = "When a receiver detects an FCRC error, it shall not send a dominant bit in the ACK slot of the received frame."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; MAC receiver has detected an FCRC error and signalled `Error(CRC)` to FCE; the ACK slot position is reached"
event = "`Error(CRC)` is signalled to FCE before the ACK slot; the ACK slot position is now reached"
postcondition = "MAC issues `PCS_Data.Request(Output_Unit=recessive)` (not dominant) in the ACK slot — the receiver withholds acknowledgement"
flags = []
notes = "The receiver withholds ACK on CRC error, then sends an EF (see REQ-MAC-091/105). All four formats share this rule."
label = ""
file = ""
observability = "external"
observability_rationale = "Recessive `PCS_Data.Request(Output_Unit=recessive)` in ACK slot (absence of dominant) is directly observable at MAC↔PCS boundary when `Error(CRC)` has been signalled. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-090"
source_clause = "§6.6.21.3.1"
original_wording = "A receiver receiving a CC frame and detecting an FCRC error shall send an EF starting with the first bit of EOF."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "CB, CE"
precondition = "`error_signalling_enable=true`; MAC receiver has detected an FCRC error in a CC frame and signalled `Error(CRC)` to FCE; the ACK slot and ACK delimiter have passed without dominant ACK"
event = "The first bit of EOF is reached via `PCS_Data.Indicate`"
postcondition = "MAC begins issuing six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls (active error flag) or six `PCS_Data.Request(Output_Unit=recessive)` calls (passive error flag) starting at the first EOF bit position"
flags = []
notes = "CC-specific FCRC error response timing. Only CB and CE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Error flag `PCS_Data.Request` calls starting at the first EOF bit position are directly observable at MAC↔PCS boundary. Testbench injects corrupted CC CRC and verifies the error flag begins at the correct bit position. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-091"
source_clause = "§6.6.21.3.1"
original_wording = "A receiver receiving an FD frame and detecting an FCRC error shall send an EF after three bit-times following the CRC delimiter."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "MAC"
format_applicability = "FB, FE"
precondition = "`error_signalling_enable=true`; MAC receiver has detected an FCRC error in an FD frame and signalled `Error(CRC)` to FCE; the CRC delimiter has been received"
event = "Three bit-times have elapsed after the CRC delimiter `PCS_Data.Indicate` call"
postcondition = "MAC begins issuing six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls (active error flag) or six `PCS_Data.Request(Output_Unit=recessive)` calls (passive error flag) three bit-times after the CRC delimiter"
flags = []
notes = "FD-specific FCRC error response timing — delayed by 3 bit-times after CRC delimiter (covering ACK slot and ACK delimiter). Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "Error flag `PCS_Data.Request` calls at MAC↔PCS boundary are timed to begin 3 bit-times after the CRC delimiter `PCS_Data.Indicate`. Timing is directly measurable at the MAC↔PCS boundary. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-092"
source_clause = "§6.6.21.3.1"
original_wording = "When error signalling is enabled and a node detects an error during the arbitration phase, the node shall send an EF. ; When a node detects an error while the data phase bit rate is used, the node shall switch from the data bit time back into the nominal bit time of the arbitration phase before it starts the error flag."
shape = "triggered"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; an error has been detected during frame processing via `PCS_Data.Request` or `PCS_Data.Indicate`"
event = "An error is detected either (a) during the arbitration phase, or (b) during the data phase (while `PCS_Status.Transmitter(D_Transmit=active)` is active and FD data bit rate is in use)"
postcondition = "(1) Arbitration-phase error: MAC immediately begins issuing `PCS_Data.Request(Output_Unit=dominant)` calls for the error flag at the next bit; (2) data-phase error: MAC first issues `PCS_Status.Transmitter(D_Transmit=passive)` to PCS to switch back to nominal bit rate, then begins the error flag `PCS_Data.Request` calls"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) EF on arbitration phase error; (2) bit rate switch before EF on data phase error. The bit rate switch applies only to FD frames with BRS=recessive. All four formats share the arbitration-phase rule; data-phase rule applies to FB and FE with BRS."
label = ""
file = ""

# ── §6.6.21.3.2 Overload signalling ──
side = "transmitter"
observability = "external"
observability_rationale = "Error flag `PCS_Data.Request(Output_Unit=dominant)` calls and `PCS_Status.Transmitter(D_Transmit=passive)` bit-rate-switch call are both observable at MAC↔PCS boundary. Ordering (switch before flag for data-phase error) is verifiable from the Output_Unit sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-093"
source_clause = "§6.6.21.3.2"
original_wording = "The following conditions shall lead to the transmission of an OF. a) LLC-requested OF: An LLC may cause an OF transmission, when internal conditions of the receiver need a delay of the next MAC DF or MAC RF. b) Reactive OF: Detection of a dominant bit during either of the first two bits of intermission, detection of one dominant bit at the last bit of EOF by a receiver, or detection of one dominant bit by any node at the last bit of error delimiter or overload delimiter shall cause an OF transmission."
shape = "triggered"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true`; the MAC is in intermission or at the last bit of EOF/error delimiter/overload delimiter as appropriate for each trigger condition"
event = "(a) LLC signals an OF request to MAC; or (b) `PCS_Data.Indicate(Input_Unit=dominant)` is received at the first or second bit of intermission, or at the last bit of EOF (receiver), or at the last bit of error/overload delimiter"
postcondition = "MAC transmits an overload frame: begins issuing six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls for the overload flag, followed by the overload delimiter"
flags = ["COMPOUND"]
notes = "COMPOUND: (a) LLC-requested OF trigger; (b) four reactive OF trigger conditions. All four formats share the same OF trigger conditions."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "Overload frame `PCS_Data.Request(Output_Unit=dominant)` calls for the overload flag are directly observable at MAC↔PCS boundary for each trigger condition. Testbench injects each trigger and verifies the OF `PCS_Data.Request` sequence. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-094"
source_clause = "§6.6.21.3.2"
original_wording = "An LLC-requested OF shall only be started at the first bit of an expected intermission."
shape = "invariant"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "LLC has signalled an OF request to MAC and the MAC is approaching an intermission period"
postcondition = "MAC begins the LLC-requested overload frame (issues `PCS_Data.Request(Output_Unit=dominant)` for the overload flag) at the first bit of the expected intermission, not before"
flags = []
notes = "Reactive OFs start one bit after detection (§6.6.21.3.2), but LLC-requested OFs are synchronized to intermission start. All four formats share this timing rule."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "First dominant `PCS_Data.Request(Output_Unit=dominant)` call of the OF appears at the first intermission bit position. Timing is directly verifiable at MAC↔PCS boundary by counting bit positions after the preceding frame's EOF. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-095"
source_clause = "§6.6.21.3.2"
original_wording = "At most, two LLC requested OFs shall be generated to delay the next MAC DF or MAC RF."
shape = "invariant"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "LLC has requested overload frame generation; one LLC-requested OF has already been transmitted"
postcondition = "MAC generates at most two LLC-requested OF sequences (each six consecutive `PCS_Data.Request(Output_Unit=dominant)` calls for the flag plus delimiter); it does not generate a third LLC-requested OF"
flags = []
notes = "Substantively duplicates REQ-LLC-027 from §6.5.5 — same two-OF limit stated in both LLC and MAC sections. This version uses 'LLC requested OFs' wording whereas §6.5.5 says 'the CAN node shall not generate more than two OFs'."
label = ""
file = ""

# ── §6.6.21.3.3 Restricted operation precedence ──
side = "both"
observability = "external"
observability_rationale = "Number of LLC-requested OF `PCS_Data.Request` sequences is countable at MAC↔PCS boundary. Testbench requests three OFs and verifies only two overload flag sequences are issued. [Rule 1a]"

[[requirement]]
id = "REQ-MAC-096"
source_clause = "§6.6.21.3.3"
original_wording = "When both, error signalling and restricted operation mode, are enabled, the restricted operation mode shall take precedence."
shape = "invariant"
scope = "node"
layer = "MAC"
format_applicability = "CB, CE, FB, FE"
precondition = "`error_signalling_enable=true` and restricted operation mode is enabled; an error or overload condition is detected"
postcondition = "MAC issues no dominant `PCS_Data.Request(Output_Unit=dominant)` calls for error flags or overload frames; restricted operation mode behaviour (no dominant on error/overload) takes effect instead of error-signalling behaviour"
flags = []
notes = "Priority resolution between two operational modes. All four formats share this precedence rule."
label = ""
file = ""

# ── §6.6.21.3.4 Error counting ──
side = "both"
observability = "external"
observability_rationale = "Absence of dominant `PCS_Data.Request(Output_Unit=dominant)` error flag calls is directly observable at MAC↔PCS boundary when both modes are enabled and an error is injected. [Rule 1a]"

[[requirement]]
id = "REQ-PCS-001"
source_clause = "§7.2.5"
original_wording = "The D_Transmit parameter shall take on one of the two values: active and passive. ; In transmitted FD frames, D_Transmit shall be set to active at the beginning of the FD data phase and it shall be set to passive at the end of the FD data phase or when that frame is disturbed."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "An FD frame is being transmitted; the MAC↔PCS interface is active and `PCS_Status.Transmitter(D_Transmit)` calls are used to signal data phase transitions"
event = "The FD data phase begins (BRS sampled recessive at `PCS_Data.Indicate`) or the FD data phase ends (CRC delimiter sample point reached or error detected)"
postcondition = "`PCS_Status.Transmitter(D_Transmit=active)` is called at FD data phase start; `PCS_Status.Transmitter(D_Transmit=passive)` is called at FD data phase end or on disturbance; D_Transmit values are named parameters of the `PCS_Status.Transmitter` primitive and directly observable at the MAC↔PCS boundary"
flags = []
notes = "XL-related wording removed. D_Transmit controls transceiver mode switching (if supported). Only FB and FE have an FD data phase."
label = ""
file = ""

# ── §7.2.6 PCS_Status.Receiver ──
observability = "external"
observability_rationale = "[Rule 1a] D_Transmit is a named parameter of `PCS_Status.Transmitter(D_Transmit)` at the MAC↔PCS boundary; active/passive values are directly observable at the boundary when the FD data phase starts and ends — no internal algorithm required"

[[requirement]]
id = "REQ-PCS-002"
source_clause = "§7.2.6"
original_wording = "The D_Receive parameter shall take on one of the two values: active and passive. ; In received FD frames, D_Receive shall be set to active at the beginning of the FD data phase and it shall be set to passive at the end of the FD data phase or when that frame is disturbed."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "An FD frame is being received; the MAC↔PCS interface is active and `PCS_Status.Receiver(D_Receive)` calls are used to signal data phase transitions"
event = "The FD data phase begins (BRS sampled recessive at `PCS_Data.Indicate`) or the FD data phase ends (CRC delimiter sample point reached or error detected)"
postcondition = "`PCS_Status.Receiver(D_Receive=active)` is called at FD data phase start; `PCS_Status.Receiver(D_Receive=passive)` is called at FD data phase end or on disturbance; D_Receive values are named parameters of the `PCS_Status.Receiver` primitive and directly observable at the MAC↔PCS boundary"
flags = []
notes = "XL-related wording removed. D_Receive controls transceiver mode switching (if supported). Only FB and FE have an FD data phase."
label = ""
file = ""

# ── §7.3.2 Bit time ──
observability = "external"
observability_rationale = "[Rule 1a] D_Receive is a named parameter of `PCS_Status.Receiver(D_Receive)` at the MAC↔PCS boundary; active/passive values are directly observable at the boundary when the FD data phase starts and ends — no internal algorithm required"

[[requirement]]
id = "REQ-PCS-003"
source_clause = "§7.3.2"
original_wording = "CAN nodes shall support three different bit rates, the nominal bit rate, the FD data bit rate and the XL data bit rate. There shall be separate configuration register sets for the definition of these bit rates."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The PCS is configured with separate bit timing register sets for nominal and FD data bit rates (config generics: m_nom, prop_seg_nom, phase_seg1_nom, phase_seg2_nom and m_data, prop_seg_data, phase_seg1_data, phase_seg2_data)"
postcondition = "The `PCS_Data.Indicate(Input_Unit)` and `PCS_Data.Request(Output_Unit)` primitives operate at the nominal bit rate during arbitration/control/CRC/ACK phases, and at the FD data bit rate during the FD data phase; each rate is independently configurable via its own register set observable at the MAC↔PCS boundary"
flags = []
notes = "XL data bit rate excluded (out of scope). Non-FD-capable nodes need only the nominal bit rate. For this project (FD-enabled), both nominal and FD data bit rates are required."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1a] Separate bit rate configurations manifest as distinct `PCS_Data.Indicate(Input_Unit)` and `PCS_Data.Request(Output_Unit)` timing during nominal vs FD data phases; each rate is independently configurable via its own config generic set and directly observable at the MAC↔PCS boundary"

[[requirement]]
id = "REQ-PCS-004"
source_clause = "§7.3.2"
original_wording = "The FD data bit time shall only be used inside the FD data phase of an FD frame. Nodes that do not support the FD frame format do not include configuration registers for the FD data bit rate."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "The node supports FD frame format; PCS is configured with both nominal bit timing (m_nom, prop_seg_nom, phase_seg1_nom, phase_seg2_nom) and FD data bit timing (m_data, prop_seg_data, phase_seg1_data, phase_seg2_data) generics"
postcondition = "The interval between consecutive `PCS_Data.Indicate(Input_Unit)` calls equals `m_data × (1 + prop_seg_data + phase_seg1_data + phase_seg2_data)` clock cycles only during the FD data phase; all bits outside the FD data phase use `m_nom × (1 + prop_seg_nom + phase_seg1_nom + phase_seg2_nom)` clock cycle intervals; timing is fully predictable from config generics alone"
flags = []
notes = "Defines the scope of FD data bit rate usage. Only FB and FE have an FD data phase."
label = ""
file = ""

# ── §7.3.2 Time quantum ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] The FD data bit time boundary (BRS position) is fixed by the frame structure; `PCS_Data.Indicate(Input_Unit)` timing switches from nominal formula to FD data formula at exactly that point; both formulas are computed from config generics alone, fully predictable at the MAC↔PCS boundary"

[[requirement]]
id = "REQ-PCS-005"
source_clause = "§7.3.2"
original_wording = "The time quantum (t_q) shall be a fixed unit of time derived from the node clock period. There shall exist a programmable prescaler, with integer values. The minimum time quantum (t_q,min) shall be one node clock period long. The length of t_q shall be an integer multiple m of the minimum time quantum t_q,min with m as the value of the prescaler."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The PCS bit timing logic is configured with prescaler m (m_nom for nominal, m_data for data phase); node clock period is t_q_min"
postcondition = "All `PCS_Data.Indicate(Input_Unit)` timing is built in integer multiples of t_q = m × t_q_min; testbench can verify by measuring the `PCS_Data.Indicate` period and confirming it equals m × (sync_seg + prop_seg + phase_seg1 + phase_seg2) × t_q_min clock cycles — fully deterministic from config generics"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) t_q is fixed unit from clock; (2) programmable prescaler exists; (3) t_q,min = one clock period; (4) t_q = m × t_q,min. Fundamental to all bit timing. All four formats share the same time quantum definition."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] t_q = m × t_q_min is the fundamental unit underlying all `PCS_Data.Indicate(Input_Unit)` timing; prescaler m is a config generic; testbench can verify by measuring `PCS_Data.Indicate` intervals in clock cycles and confirming they are integer multiples of m — fully determined by config generics without internal state knowledge"

[[requirement]]
id = "REQ-PCS-006"
source_clause = "§7.3.2"
original_wording = "The frequencies of the node clock oscillators in the different CAN nodes shall be coordinated to provide a network-wide specified time quantum for the nominal bit time and, for FD or XL enabled nodes, for the data bit time."
shape = "invariant"
scope = "bus"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A CAN network is being configured"
postcondition = "Node clock oscillator frequencies are coordinated to achieve a consistent time quantum across the network for nominal and (for FD-enabled nodes) data bit times"
flags = []
notes = "Bus-scope because coordination is across all nodes in the network. All four formats share the same clock coordination requirement."
label = ""
file = ""

# ── §7.3.2 Bit times — segments ──
side = "both"
observability = "internal"
observability_rationale = "Oscillator frequency tolerance is a physical/manufacturing constraint. In simulation the clock is ideal. No manifestation at any layer boundary in a simulation environment. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-PCS-007"
source_clause = "§7.3.2"
original_wording = "All three bit times shall consist of separate non-overlapping time segments. The segments shall form the bit times as shown in Figure 32."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Bit timing is configured"
postcondition = "Each bit time consists of non-overlapping segments: Sync_Seg, Prop_Seg, Phase_Seg1, Phase_Seg2"
flags = []
notes = "The four segments are: Sync_Seg, Prop_Seg, Phase_Seg1, Phase_Seg2 per Figure 32. All four formats share the same bit time segment structure."
label = ""
file = ""

# ── §7.3.2 Sample point ──
side = "both"
observability = "internal"
observability_rationale = "Structural definition of bit time segments — names and describes the four segments with no behavioral output at any layer boundary. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-PCS-008"
source_clause = "§7.3.2"
original_wording = "The sample point shall be the point in time at which the bus level is read and interpreted as the value of that respective bit. Its location shall be at the end of Phase_Seg1."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "PCS is operating with bit timing config generics m_nom (or m_data), prop_seg_nom (or prop_seg_data), phase_seg1_nom (or phase_seg1_data); sync_seg is fixed at 1 t_q"
postcondition = "`PCS_Data.Indicate(Input_Unit)` fires at `m × (1 + prop_seg + phase_seg1)` clock cycles after the start of the bit time (end of Phase_Seg1); the timing is fully determined by config generics and directly measurable as the moment the `PCS_Data.Indicate` primitive is called at the MAC↔PCS boundary"
flags = []
notes = "Fundamental timing definition. All four formats share the same sample point location."
label = ""
file = ""

# ── §7.3.2 Information processing time ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] The timing of `PCS_Data.Indicate(Input_Unit)` (sample point) equals `m × (1 + prop_seg + phase_seg1)` clock cycles after bit start — fully determined by config generics m, prop_seg, phase_seg1; testbench can predict and verify the exact cycle without any internal state knowledge"

[[requirement]]
id = "REQ-PCS-009"
source_clause = "§7.3.2"
original_wording = "The information processing time shall be the number of time quanta required for the calculation of the subsequent bit level. This calculation begins at the sample point and shall be less than or equal to Phase_Seg2."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A bit has been sampled and the subsequent bit level is being calculated"
postcondition = "The information processing time (IPT) starts at the sample point and is ≤ Phase_Seg2 in duration"
flags = []
notes = "IPT must fit within Phase_Seg2. Additional restrictions on IPT ≤ 2 t_q are in §7.3.3. All four formats share the same IPT constraint."
label = ""
file = ""

# ── §7.3.2 Internal delay time and propagation ──
side = "both"
observability = "internal"
observability_rationale = "Defines the concept of information processing time (IPT) as a number of tq. This is a naming/definition with no behavioral output. The testable constraint is in REQ-PCS-013. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-PCS-010"
source_clause = "§7.3.2"
original_wording = "The internal delay time of a CAN node, t_node, shall be the sum of all asynchronous delays that occur along the transmission and reception path, relative to the bit timing logic unit of the CAN node. ; For proper arbitration, the following conditions given by Formula (2) shall be met: t_prop_seg ≥ t_nodeA + t_nodeB + 2 × t_busline."
shape = "invariant"
scope = "bus"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Two CAN nodes A and B are communicating on a bus"
postcondition = "t_node = t_output + t_input; and Prop_Seg duration ≥ sum of both nodes' internal delays plus twice the bus line propagation delay"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) t_node definition; (2) propagation constraint for proper arbitration. Bus-scope because it relates two nodes' delays plus bus line delay. All four formats require proper arbitration timing."
label = ""
file = ""

# ── §7.3.3 Configuration of the bit time parameters ──
side = "both"
observability = "internal"
observability_rationale = "Defines t_node as sum of internal async delays (oscillator tolerance, bus driver, receiver, comparator). These are physical characteristics, not config generics. No boundary manifestation. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-PCS-011"
source_clause = "§7.3.3"
original_wording = "There shall be one prescaler m for the three sets of bit time configurations. ; Except for the synchronization segment, which shall be exactly one t_q long, CAN nodes may allow time segments that exceed the minimum required configuration ranges specified in the tables."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Bit timing is being configured"
postcondition = "A single prescaler m is used for all bit time configurations (separate prescalers are allowed but should be equal); Sync_Seg is exactly 1 t_q"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) one prescaler m; (2) Sync_Seg = 1 t_q exactly. The table notes allow separate prescalers but recommends same values. All four formats share the same prescaler and Sync_Seg rules."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Internal hardware architecture decision — one prescaler for three bit time configs. No observable effect at any layer boundary. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-PCS-012"
source_clause = "§7.3.3"
original_wording = "When the bit time configuration of a CAN node is not programmable, its fixed bit time configuration shall meet the restrictions for this configuration as specified in this subclause."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The CAN node uses a fixed (non-programmable) bit time configuration"
postcondition = "The fixed configuration meets all restrictions specified in §7.3.3"
flags = []
notes = "Ensures fixed-configuration nodes still comply with timing constraints. All four formats share this rule."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Applies to non-programmable nodes with fixed bit timing. This implementation is programmable (config generics), so this is a config input constraint for a non-applicable case. [Rule 3 — config input constraint]"

[[requirement]]
id = "REQ-PCS-013"
source_clause = "§7.3.3"
original_wording = "The information processing time shall be less than or equal to 2 t_q long."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "PCS is operating; `PCS_Data.Indicate(Input_Unit)` fires at the sample point (end of Phase_Seg1); the MAC then issues `PCS_Data.Request(Output_Unit)` for the next bit"
postcondition = "The delta between `PCS_Data.Indicate(Input_Unit)` firing and the subsequent `PCS_Data.Request(Output_Unit)` for the next bit is ≤ 2 t_q; both events are named primitives at the MAC↔PCS boundary and directly measurable without any internal state knowledge"
flags = []
notes = "Tighter constraint than §7.3.2 (which says IPT ≤ Phase_Seg2). All four formats share this limit."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1a] IPT is the delta between `PCS_Data.Indicate(Input_Unit)` firing (sample point) and the subsequent `PCS_Data.Request(Output_Unit)` for the next bit; both are named primitives at the MAC↔PCS boundary, making IPT directly measurable as a time delta between two observable events — no internal state knowledge required"

[[requirement]]
id = "REQ-PCS-014"
source_clause = "§7.3.3"
original_wording = "In data bit time, Phase_Seg2 shall be greater than or equal to these two items: SJW and the maximum information processing time. ; In nominal bit time, Phase_Seg2 shall be greater than or equal to the maximum of these two items: SJW and the information processing time."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Bit timing parameters are being configured"
postcondition = "Phase_Seg2 ≥ max(SJW, IPT) for both nominal and data bit times"
flags = []
notes = "Ensures Phase_Seg2 is large enough for both resynchronization jumps and information processing. All four formats share these constraints."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Constrains valid Phase_Seg2 values (≥ IPT and ≥ SJW). This is a constraint on valid configuration inputs, not on observable output behaviour for a given valid configuration. [Rule 3 — config input constraint]"

[[requirement]]
id = "REQ-PCS-015"
source_clause = "§7.3.3"
original_wording = "In nominal bit time and in data bit time, SJW shall be less than or equal to the minimum of these two items: Phase_Seg1 and Phase_Seg2."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Bit timing parameters are being configured"
postcondition = "SJW ≤ min(Phase_Seg1, Phase_Seg2) for both nominal and data bit times"
flags = []
notes = "Prevents SJW from exceeding either phase segment. All four formats share this constraint."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Constrains valid SJW values (≤ min(Phase_Seg1, Phase_Seg2)). This is a constraint on valid configuration inputs, not on observable output behaviour. [Rule 3 — config input constraint]"

[[requirement]]
id = "REQ-PCS-016"
source_clause = "§7.3.3"
original_wording = "In a CAN node, Prop_Seg and Phase_Seg1 do not need to be programmable separately; it shall be sufficient to program the sum of Prop_Seg and Phase_Seg1. ; The total number of time quanta in a nominal bit time shall be programmable at least from 8 to 25 for nodes that are not FD enabled. For nodes that are FD enabled, the total number of time quanta in a data bit time shall be programmable at least from 5 to 25 and in a nominal bit time at least from 8 to 80."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "Bit timing is being configured for an FD-enabled node"
postcondition = "Prop_Seg + Phase_Seg1 may be programmed as a single sum; nominal bit time is programmable from 8 to at least 80 t_q; FD data bit time is programmable from 5 to at least 25 t_q"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) Prop_Seg + Phase_Seg1 combined programming allowed; (2) nominal range 8–80; (3) data range 5–25. XL range (5–385/5–641) excluded. For this project (FD-enabled, non-XL), the FD ranges apply."
label = ""
file = ""

# ── §7.3.4 Transmitter delay compensation ──
side = "both"
observability = "internal"
observability_rationale = "Internal programmability flexibility — whether Prop_Seg and Phase_Seg1 are separately programmable or combined is an implementation choice with no effect at any layer boundary. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-PCS-017"
source_clause = "§7.3.4"
original_wording = "Nodes that support the FD frame format and nodes that support the XL frame format shall support a transmitter delay compensation mechanism."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "The node supports FD frame format; tdc_enable and ssp_offset are configurable generics at the PCS layer"
postcondition = "When tdc_enable is set, `PCS_Data.Indicate(Input_Unit)` timing during the FD data phase is based on measured TX delay + ssp_offset rather than the nominal segment formula; the capability is verifiable by enabling tdc_enable and observing that `PCS_Data.Indicate` timing shifts to SSP-based values at the MAC↔PCS boundary"
flags = []
notes = "Mandatory for FD-capable nodes. Only FB and FE benefit from TDC (during FD data phase)."
label = ""
file = ""
side = "transmitter"
observability = "external"
observability_rationale = "[Rule 1b] TDC capability is verifiable by setting tdc_enable=1 and observing that `PCS_Data.Indicate(Input_Unit)` timing during FD data phase equals (measured_delay + ssp_offset) rather than the segment formula; ssp_offset and tdc_enable are config generics fully determining the expected timing at the MAC↔PCS boundary"

[[requirement]]
id = "REQ-PCS-018"
source_clause = "§7.3.4"
original_wording = "Transmitters shall only use this mechanism in the FD data phase of FD frames if the BRS bit is recessive. It shall be programmable whether the mechanism is used. When this mechanism is used, the value of the prescaler m shall be one or two."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "The node supports FD frame format; TDC is configured via tdc_enable (programmable) and prescaler m_data ∈ {1, 2}; an FD frame is being transmitted with BRS recessive"
postcondition = "When tdc_enable=1 and BRS was received recessive (FD data phase active, D_Transmit=active via `PCS_Status.Transmitter`), `PCS_Data.Indicate(Input_Unit)` fires at (measured TX delay + ssp_offset) clock cycles; when tdc_enable=0 the normal segment formula applies; m_data is constrained to 1 or 2 when TDC is active; all verifiable at MAC↔PCS boundary from config generics"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) TDC scope limited to FD data phase with BRS recessive; (2) programmable enable; (3) prescaler m = 1 or 2. XL data phase usage excluded (out of scope). Only FB and FE apply."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1b] TDC activation scope and prescaler constraint are verifiable from config generics tdc_enable, m_data, and from `PCS_Status.Transmitter(D_Transmit)` at the MAC↔PCS boundary; `PCS_Data.Indicate(Input_Unit)` timing in FD data phase shifts predictably to SSP-based values when all conditions are met"

[[requirement]]
id = "REQ-PCS-019"
source_clause = "§7.3.4"
original_wording = "The node shall be able to compensate transmitter delays of at least 95 t_q,min. The position of the SSP shall be configurable separately for XL frames and for FD frames."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "TDC is implemented"
postcondition = "The node compensates transmitter delays of at least 95 t_q,min; the SSP position is separately configurable for FD frames"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) minimum compensation range 95 t_q,min; (2) SSP separately configurable. Non-XL nodes may limit to 63 t_q,min per the standard. Only FB and FE apply."
label = ""
file = ""
side = "transmitter"
observability = "internal"
observability_rationale = "Capability constraint on the TDC compensation range (≥ 95 tq_min for XL, ≥ 63 tq_min for FD-only per Table 12). Constrains the supported config space, not the output behaviour for a given valid config. [Rule 3 — config input constraint]"

[[requirement]]
id = "REQ-PCS-020"
source_clause = "§7.3.4"
original_wording = "Bit error detection shall be disabled for those bits at the end of the FD data phase in which the SSPs of the bits are in the following arbitration phase."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "TDC is active and the end of the FD data phase is being processed"
postcondition = "Bit error detection via SSP is disabled for bits whose SSP would fall in the subsequent arbitration phase"
flags = []
notes = "Prevents false bit errors from SSPs that extend beyond the data phase. Only FB and FE apply."
label = ""
file = ""
observability = "internal"
observability_rationale = "Bit error detection disabling at end of FD data phase is a MAC-level comparison (Output_Unit vs Input_Unit). From PCS perspective, PCS simply delivers Input_Unit; whether MAC uses it for error detection is not observable at the PCS boundary. [Rule 3 — no PCS boundary effect]"

[[requirement]]
id = "REQ-PCS-021"
source_clause = "§7.3.4"
original_wording = "When it is used, the transmitter shall ignore bit errors detected at the sample point. The received bit value shall be compared, at the SSP, with the (delayed) transmitted bit value. If a bit error is detected at the SSP, the transmitter shall react to this bit error at the subsequent following sample point."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "TDC is active during the FD data phase"
event = "A bit is sampled at the sample point and at the SSP"
postcondition = "Bit errors at SP are ignored; the received bit at SSP is compared with the delayed transmitted bit; if SSP detects a mismatch, the error is reported at the next SP"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) SP bit errors ignored; (2) SSP comparison; (3) SSP error reported at next SP. This is the core TDC bit error detection mechanism. Only FB and FE apply."
label = ""
file = ""
observability = "internal"
observability_rationale = "Ignoring SP bit errors when TDC enabled is a MAC-level decision (compare at SSP instead of SP). PCS delivers Input_Unit at both SP and SSP timing; whether MAC ignores the SP comparison is not observable at PCS boundary. [Rule 3 — no PCS boundary effect]"

[[requirement]]
id = "REQ-PCS-022"
source_clause = "§7.3.4"
original_wording = "The position of the SSP is specified by its distance from the start of the bit time. The SSP position shall be set to a value derived from a measurement of the actual transmitter delay. ; The measurement of the transmitter delay shall be done in each transmitted frame at the recessive to dominant edge from the FDF bit to the res bit in FD frames. ; A counter shall be started when the transmitter starts to transmit the dominant res bit at the transmit output. The counter shall be incremented by one each minimum time quantum until the dominant signal is detected at the receive input; then the counter shall be stopped. The counter value is the measured transmitter delay time. The SSP position shall be the sum of the measured transmitter delay value and the configured SSP offset."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "TDC is active (tdc_enable=1, m_data ∈ {1,2}); an FD frame is being transmitted; a TDC measurement counter is ready at the start of the FD data phase"
event = "The recessive-to-dominant edge from FDF to res bit occurs"
postcondition = "`PCS_Data.Indicate(Input_Unit)` fires at (measured_delay + ssp_offset) t_q_min clock cycles from the start of the bit time during FD data phase bits, where measured_delay = number of t_q_min cycles from TX dominant res until RX dominant detected; ssp_offset is a config generic (1–63 t_q_min); the SSP timing is fully predictable from the measurement result and ssp_offset, verifiable at the MAC↔PCS boundary"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) SSP position from measurement; (2) measurement at FDF-to-res edge; (3) counter mechanism; (4) SSP = measured + offset. This is the TDC measurement procedure. Only FB and FE apply."
label = ""
file = ""

# ── §7.3.5.1 Synchronization description ──
observability = "external"
observability_rationale = "[Rule 1b] SSP position = measured_delay + ssp_offset; ssp_offset is a config generic (1–63 t_q_min); measured_delay is observable at the MAC↔PCS boundary (time from TX dominant res bit to RX dominant detected); the resulting `PCS_Data.Indicate(Input_Unit)` timing is fully predictable and verifiable without internal algorithm"

[[requirement]]
id = "REQ-PCS-023"
source_clause = "§7.3.5.1"
original_wording = "The state machine synchronizing the operation of the CAN node to the PCS_Data.Indicate shall operate in time steps of one t_q. ; At each time quantum, it shall be analysed whether the bus state is recessive or dominant. The bus state detected at the sample point of a bit shall be regarded as the value of that bit."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The synchronization state machine is operational"
postcondition = "The state machine operates in t_q steps; bus state is analyzed each t_q; the bus state at the sample point is the bit value"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) t_q time steps; (2) bus state analyzed each t_q; (3) sample point determines bit value. All four formats share the same synchronization state machine."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Defines the synchronization state machine structure (two states: synchronizing and idle). Structural definition of internal state machine architecture with no direct boundary output. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-PCS-024"
source_clause = "§7.3.5.1"
original_wording = "Only one synchronization within one bit time (between two sample points) shall be allowed. After an edge is detected, synchronizations shall be disabled until the next time the bus state detected at the sample point is recessive."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "PCS is processing bit edges; synchronization state machine is configured with sjw_nom (or sjw_data); previous sample point result is known"
postcondition = "`PCS_Data.Indicate(Input_Unit)` timing adjusts at most once per bit time in response to an edge; after an edge is used for synchronization, subsequent edges in the same bit time cause no additional timing change to `PCS_Data.Indicate`; verifiable by presenting two edges per bit time and measuring that `PCS_Data.Indicate` shifts only once"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) one sync per bit time; (2) sync disabled after edge until recessive SP. Rule (a) of synchronization rules. All four formats share this rule."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] The one-sync-per-bit constraint is verifiable by presenting two edges per bit time and confirming `PCS_Data.Indicate(Input_Unit)` shifts only once; no-sync-until-recessive-SP is verifiable by measuring that `PCS_Data.Indicate` timing remains unchanged after successive edges until a recessive sample point occurs — both determined by config generics and stimulus"

[[requirement]]
id = "REQ-PCS-025"
source_clause = "§7.3.5.1"
original_wording = "An edge shall cause synchronization only if the bus state detected at the previous sample point (previous read bus state) was recessive. ; An edge with a positive phase error shall not cause synchronization in a node sending a dominant bit."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "An edge is detected on the bus between two consecutive `PCS_Data.Indicate(Input_Unit)` calls; the previous `PCS_Data.Indicate` result and the current transmit direction are known"
postcondition = "An edge causes a `PCS_Data.Indicate(Input_Unit)` timing adjustment only if the previous `PCS_Data.Indicate` result was recessive; a positive-phase-error edge causes no timing shift when the node is currently issuing `PCS_Data.Request(Output_Unit=dominant)`; both conditions verifiable by measuring `PCS_Data.Indicate` timing relative to edge position and config generics"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) previous SP must be recessive; (2) positive phase error edges suppressed when sending dominant. Rule (b) of synchronization rules. All four formats share this rule."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] Edge sync conditions are verifiable by measuring `PCS_Data.Indicate(Input_Unit)` timing shift: only edges preceded by a recessive `PCS_Data.Indicate` result cause shifts; positive-phase-error edges during `PCS_Data.Request(Output_Unit=dominant)` cause no shift — both conditions determined by config generics and stimulus, no internal state knowledge needed"

[[requirement]]
id = "REQ-PCS-026"
source_clause = "§7.3.5.1"
original_wording = "Hard synchronization shall be performed: on edges during inter-frame space (with the exception of the first bit of intermission); when a node is in bus-integration state; at the edge between the FDF bit and the following dominant res bit inside an FD frame."
shape = "triggered"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The PCS is in inter-frame space, bus-integration state, or processing the FDF-to-res boundary; bit timing config generics (m_nom, prop_seg_nom, phase_seg1_nom, phase_seg2_nom) are known"
event = "A recessive-to-dominant edge occurs during IFS (except first intermission bit), or during bus integration, or at FDF-to-res boundary in an FD frame"
postcondition = "Hard synchronization is performed: the bit time is restarted with sync_seg complete at the triggering edge; subsequent `PCS_Data.Indicate(Input_Unit)` fires at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles from the edge; the timing shift is computable from edge position (stimulus) and segment config generics (Rule 1b)"
flags = ["COMPOUND"]
notes = "COMPOUND: three trigger conditions for hard sync. XL-specific conditions (XLF-to-resXL, DH-to-DL, DAH-to-AL edges) excluded. Rule (c) of synchronization rules. The FDF-to-res edge applies only to FB and FE; the IFS and bus-integration conditions apply to all four formats."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] Hard sync timing shift at `PCS_Data.Indicate(Input_Unit)` is fully computable from edge position (stimulus) and segment config generics (m_nom, prop_seg_nom, phase_seg1_nom); testbench can predict the exact `PCS_Data.Indicate` firing cycle for each of the three hard sync trigger conditions"

[[requirement]]
id = "REQ-PCS-027"
source_clause = "§7.3.5.1"
original_wording = "All other recessive to dominant edges fulfilling rules a) and b) shall be used for resynchronization with one exception: A node transmitting an FD frame shall not synchronize while it transmits the data phase of that frame."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A recessive-to-dominant edge meeting rules (a) and (b) is detected; PCS is configured with sjw_nom; the node is not transmitting the FD data phase"
postcondition = "Resynchronization adjusts `PCS_Data.Indicate(Input_Unit)` timing by the phase error (capped at sjw_nom); a node transmitting the FD data phase does not adjust `PCS_Data.Indicate` timing in response to such edges; timing shift computable from edge phase error (stimulus) and sjw_nom (config generic)"
flags = []
notes = "Rule (d) of synchronization rules. The FD data phase exception prevents the transmitter from resynchronizing to its own delayed bits during high-speed data phase. XL exception excluded. All four formats use resynchronization."
label = ""
file = ""

# ── §7.3.5.3 Hard synchronization ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] Resync timing shift at `PCS_Data.Indicate(Input_Unit)` is computable from edge phase error (stimulus) and sjw_nom (config generic); FD data phase no-sync exception is verifiable by observing no `PCS_Data.Indicate` shift during transmitter data phase — determined by config generics and stimulus"

[[requirement]]
id = "REQ-PCS-028"
source_clause = "§7.3.5.3"
original_wording = "After a hard synchronization, the bit time shall be restarted by each bit-timing logic unit with Sync_Seg completed. Thus, hard synchronization shall force the edge which has caused the hard synchronization to lie within the synchronization segment of the restarted bit time. The function of hard synchronization shall not be limited by the synchronization jump width."
shape = "triggered"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A hard synchronization has been triggered"
event = "The edge causing hard synchronization is detected"
postcondition = "The bit time is restarted with sync_seg completed at the triggering edge; `PCS_Data.Indicate(Input_Unit)` fires at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles from the edge, unconstrained by sjw_nom; the timing is fully predictable from config generics and the edge position in the stimulus"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) bit time restart with Sync_Seg completed; (2) edge within Sync_Seg; (3) not limited by SJW. All four formats share the same hard sync behavior."
label = ""
file = ""

# ── §7.3.5.4 Bit resynchronization ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] Hard sync bit time restart manifests as `PCS_Data.Indicate(Input_Unit)` firing at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles from the triggering edge, unconstrained by sjw_nom; timing is fully predictable from config generics and the edge position in the stimulus"

[[requirement]]
id = "REQ-PCS-029"
source_clause = "§7.3.5.4"
original_wording = "When the magnitude of the phase error of the edge which causes resynchronization is less than or equal to the programmed value of the synchronization jump width, the effect of a resynchronization shall be the same as a hard synchronization."
shape = "triggered"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A resynchronization edge is detected; the phase error magnitude |e| ≤ sjw_nom; PCS bit timing config generics (m_nom, prop_seg_nom, phase_seg1_nom) are known"
event = "A resynchronization edge is detected with |e| ≤ SJW"
postcondition = "`PCS_Data.Indicate(Input_Unit)` fires at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles from the edge (same as hard sync effect); the timing shift fully corrects the phase error and is predictable from |e| ≤ sjw_nom and config generics"
flags = []
notes = "Small phase errors are fully corrected, same as hard sync. All four formats share this behavior."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] When |e| ≤ sjw_nom, `PCS_Data.Indicate(Input_Unit)` fires at `m_nom × (1 + prop_seg_nom + phase_seg1_nom)` clock cycles from the edge; timing is predictable from the phase error (stimulus) and config generics — equivalent to hard sync, verifiable at MAC↔PCS boundary"

[[requirement]]
id = "REQ-PCS-030"
source_clause = "§7.3.5.4"
original_wording = "When the magnitude of the phase error is larger than the programmed value of the synchronization jump width, and if the phase error e is positive, Phase_Seg1 shall be lengthened by an amount equal to the synchronization jump width; and if the phase error e is negative, then Phase_Seg2 shall be shortened by an amount equal to the synchronization jump width."
shape = "triggered"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "A resynchronization edge is detected; the phase error magnitude |e| > sjw_nom; PCS bit timing config generics (m_nom, prop_seg_nom, phase_seg1_nom, phase_seg2_nom, sjw_nom) are known"
event = "A resynchronization edge is detected with |e| > SJW"
postcondition = "If e > 0: Phase_Seg1 is extended by sjw_nom, so `PCS_Data.Indicate(Input_Unit)` fires sjw_nom t_q later than the unadjusted sample point; if e < 0: Phase_Seg2 is shortened by sjw_nom, so the next bit time starts sjw_nom t_q earlier; both adjustments are predictable from sjw_nom (config generic) and the edge phase error (stimulus), verifiable at the MAC↔PCS boundary"
flags = ["COMPOUND"]
notes = "COMPOUND: two sub-claims for positive and negative phase errors. Large phase errors are only partially corrected (by SJW). All four formats share this behavior."
label = ""
file = ""
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] SJW-limited Phase_Seg1/Phase_Seg2 adjustment is directly measurable as a shift in `PCS_Data.Indicate(Input_Unit)` timing; the magnitude (sjw_nom) is a config generic and the direction (e > 0 vs e < 0) is determined by the edge stimulus position — fully predictable at MAC↔PCS boundary"

[[requirement]]
id = "REQ-PCS-031"
source_clause = "§7.3.5.4"
original_wording = "Neither receiver nor transmitter shall perform a synchronization at an edge after the sample point of the ADH bit and before the sample point of the DH1 bit."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "FB, FE"
precondition = "An FD frame is being processed; bit timing config generics for the FD data phase are known; ADH and DH1 bit positions are determined by the frame structure"
postcondition = "No `PCS_Data.Indicate(Input_Unit)` timing adjustment occurs in response to edges between the sample point of ADH and the sample point of DH1; verifiable by presenting edges in this window and measuring that `PCS_Data.Indicate` timing remains unchanged"
flags = ["AMBIGUOUS"]
notes = "AMBIGUOUS: The ADH and DH1 bits are XL-specific (ADS sequence). However, the standard may also apply this to FD frame transitions. For this project (non-XL), this may not be directly applicable, but included for completeness."
label = ""
file = ""

# ── §7.3.6 Tolerance range of the oscillator frequencies ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1b] No-sync-after-SP constraint is verifiable by measuring that `PCS_Data.Indicate(Input_Unit)` timing does not shift in response to edges in the ADH-to-DH1 window; the window boundaries are determined by frame structure and config generics — no internal state knowledge required beyond segment lengths"

[[requirement]]
id = "REQ-PCS-032"
source_clause = "§7.3.6"
original_wording = "The tolerance of a node clock oscillator frequency f_osc around the nominal frequency f_nom shall be given by the range (1-df)×f_nom ≤ f_osc ≤ (1+df)×f_nom."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The node clock oscillator is being specified"
postcondition = "The oscillator frequency tolerance df defines the acceptable range: f_osc ∈ [(1-df)×f_nom, (1+df)×f_nom]"
flags = []
notes = "The tolerance df is constrained by Formulae (3)–(7). All four formats share this oscillator tolerance definition."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Oscillator frequency tolerance (df) is a physical/manufacturing constraint. In simulation the clock is ideal; df has no manifestation at any layer boundary. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-PCS-033"
source_clause = "§7.3.6"
original_wording = "The conditions given in Formulae (3) and (4) shall be met for CC frames. ; All conditions of Formulae (3) to (7) shall be met for FD frames."
shape = "invariant"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The oscillator tolerance df is being verified"
postcondition = "For CC frames: df satisfies Formulae (3) and (4). For FD frames: df satisfies Formulae (3) through (7)"
flags = []
notes = "CC frames use two tolerance conditions; FD frames add three more (5, 6, 7) related to the data phase. The formulae involve SJW, Phase_Seg1/2, and bit times for both nominal and data phases. All four formats are covered."
label = ""
file = ""
side = "both"
observability = "internal"
observability_rationale = "Oscillator tolerance formula conditions (Formulae 3-8) are physical constraints on oscillator selection. Not testable in simulation where clocks are ideal. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-PCS-034"
source_clause = "§7.4.2.1"
original_wording = "The PCS shall send an output symbol to the PMA sub-layer when it receives an Output_Unit from the MAC sub-layer."
shape = "triggered"
scope = "node"
layer = "PCS"
format_applicability = "CB, CE, FB, FE"
precondition = "The PCS is operational; the MAC sub-layer issues `PCS_Data.Request(Output_Unit)` with Output_Unit = dominant or recessive"
event = "An Output_Unit (dominant or recessive) is received from the MAC sub-layer via PCS_Data.Request"
postcondition = "For each `PCS_Data.Request(Output_Unit=dominant)` call, the PCS sends a level_0 output symbol to the PMA sub-layer; for each `PCS_Data.Request(Output_Unit=recessive)` call, the PCS sends a level_1 output symbol; the mapping is a named parameter correspondence directly observable at both the MAC↔PCS and PCS↔PMA boundaries"
flags = []
notes = "Maps MAC-level dominant/recessive to PMA-level voltage symbols. All four formats share this PCS-to-PMA path."
label = ""
file = ""

