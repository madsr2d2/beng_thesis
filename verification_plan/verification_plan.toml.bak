# ── §8.1.1 Objectives ──
side = "both"
observability = "external"
observability_rationale = "[Rule 1a] The bus_off_release symbol is a named parameter of the PCS↔PMA primitive, directly triggered by `Bus_off_release_request` at the PCS↔FCE boundary; both trigger and response are named primitives at layer boundaries — directly observable without internal algorithm"

[[requirement]]
id = "REQ-FCE-001"
source_clause = "§8.1.1"
original_wording = "Fault confinement shall be enabled only when error signalling is enabled."
shape = "invariant"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "The CAN node is operational; error signalling configuration is known to the testbench as a static config generic"
postcondition = "When error signalling is enabled, FCE issues `Error_passive_request` or `Bus_off_request` at FCE→MAC / FCE→PCS boundaries in response to error sequences; when error signalling is disabled, neither primitive is ever issued — verifying requires injecting error sequences and confirming no `Error_passive_request` appears at FCE→MAC boundary"
flags = []
notes = "Gate condition for the entire FCE: when error signalling is disabled, fault confinement is inactive. All four formats share the same FCE enable condition."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] FCE activation/deactivation is internal state. Its effect is derived by observing whether `Error_passive_request` or `Bus_off_request` appear at FCE→MAC / FCE→PCS boundaries when error signalling configuration is toggled; absence of these primitives under sustained `Error(type)` signals from MAC confirms fault confinement is inactive — non-trivial multi-step tracking required."

[[requirement]]
id = "REQ-FCE-002"
source_clause = "§8.1.1"
original_wording = "When error signalling is disabled within a network, the node shall never enter error passive state or bus-off state as specified in 8.1.4."
shape = "invariant"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Error signalling is disabled (protocol_exception_enable = 0 or equivalent config generic); FCE is in its initial state"
postcondition = "FCE never issues `Error_passive_request` or `Bus_off_request` at the FCE→MAC or FCE→PCS boundaries, even under sustained `Error(type)` signals from MAC; node remains in error-active (or equivalent) state throughout"
flags = []
notes = "Prohibition: with error signalling disabled, the FCE state machine must remain in error-active (or equivalent initial state). All four formats share the same FCE."
label = ""
file = ""

# ── §8.1.2 Strategies ──
observability = "derived"
observability_rationale = "[Rule 2] Error-passive and bus-off states are internal FCE states. Their absence must be derived from the node's continued error-active behavior — absence of `Error_passive_request` at FCE→MAC and absence of `Bus_off_request` at FCE→PCS — even under sustained `Error(type)` signals injected at MAC↔FCE boundary. Multi-step error sequence required to confirm absence."

[[requirement]]
id = "REQ-FCE-003"
source_clause = "§8.1.2"
original_wording = "When frames are sent or received correctly, the counters shall be decremented. ; When frames are sent or received with errors, the counters shall be incremented more than they are decremented in the absence of errors."
shape = "invariant"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Fault confinement is active; the FCE is receiving `Successful_transfer` or `Error(type)` signals from MAC at the MAC↔FCE boundary"
postcondition = "After each `Successful_transfer` from MAC, TEC or REC decrements per §8.1.4.2 rules, eventually causing FCE to issue `Error_active_response` at FCE→MAC if recovering; after each `Error(type)` from MAC, TEC or REC increments more than decremented in the absence of errors, eventually triggering `Error_passive_request` at FCE→MAC — verifying requires constructing controlled error/success sequences and correlating with state transitions at FCE→MAC boundary"
flags = ["COMPOUND"]
notes = "COMPOUND: two sub-claims: (1) successful frames decrement counters, (2) error frames cause net increment. Specific increment/decrement values are defined in §8.1.4.2. All four formats share the same counting strategy."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] TEC/REC counter values are internal to the FCE. The counter trend must be derived by injecting controlled error sequences (MAC issues `Error(type)` to FCE) and success sequences (MAC issues `Successful_transfer` to FCE) and observing the direction of state transitions — `Error_passive_request` at FCE→MAC boundary for net increment, `Error_active_response` for net decrement — per §8.1.4.2 counting rules."

[[requirement]]
id = "REQ-FCE-004"
source_clause = "§8.1.3.2, Table 14"
original_wording = "Normal_mode_request: Resets FCE to initial state (the values of the transmit error counter and the receive error counter are set to zero when the FCE passes into its initial state)."
shape = "triggered"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "The FCE is operational; LLC sub-layer issues `Normal_mode_request` at the LLC↔FCE boundary"
event = "`Normal_mode_request` fires at LLC↔FCE boundary (LLC→FCE direction)"
postcondition = "FCE issues `Normal_mode_response` at FCE→LLC boundary; TEC and REC are reset to 0 internally; absence of `Error_passive_request` from FCE→MAC after reset confirms initial state — verifying requires tracking that no `Error_passive_request` is issued even under subsequent error injection that would otherwise have crossed the threshold given prior counter state"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: the Normal_mode_request originates from the LLC sub-layer. All four formats share the same reset mechanism."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] `Normal_mode_request` is a named LLC↔FCE primitive (input side observable), and `Normal_mode_response` at FCE→LLC is the acknowledgment. The postcondition (TEC=0, REC=0) references internal counters — verifying the reset requires constructing a prior error sequence to raise TEC/REC, then issuing `Normal_mode_request`, then injecting a new error sequence and confirming `Error_passive_request` fires only after the full new threshold is crossed — non-trivial multi-step protocol state tracking."

[[requirement]]
id = "REQ-FCE-005"
source_clause = "§8.1.4.2 rule a)"
original_wording = "When a receiver detects an error, the receive error counter shall be incremented by 1, except when the detected error is a bit error during the sending of an active error flag or an overload flag."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as receiver and fault confinement is active; MAC has issued `Error(type)` (type ≠ bit error during active error flag or overload flag) to FCE at MAC↔FCE boundary"
event = "MAC issues `Error(type)` to FCE at MAC↔FCE boundary where type is not a bit error during an active error flag or overload flag"
postcondition = "FCE increments REC by 1 internally; if REC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary — verifying the +1 increment requires correlating the number of `Error(type)` signals received with the number of errors needed to trigger `Error_passive_request`, per §8.1.4.2 rule a) counting rules"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: error detection signal originates from MAC sub-layer. The exception (bit error during active error flag/overload flag) is covered by rule e). All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] REC increment on `Error(type)` from MAC drives when `Error_passive_request` fires at FCE→MAC boundary. Verifying the +1 rule requires constructing an error sequence with a known starting REC and confirming `Error_passive_request` fires after exactly (128 - REC_start) errors — non-trivial multi-step counter state tracking per §8.1.4.2 rule a)."

[[requirement]]
id = "REQ-FCE-006"
source_clause = "§8.1.4.2 rule b)"
original_wording = "When a receiver detects a dominant bit as the first bit after sending an error flag, the receive error counter shall be incremented by 8."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as receiver and has just completed sending an error flag; MAC signals error flag completion at MAC↔FCE boundary; fault confinement is active"
event = "MAC signals to FCE (via `Error/Overload_flag` at MAC↔FCE boundary) that the first bit after the error flag is dominant"
postcondition = "FCE increments REC by 8 internally; if REC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary — verifying the +8 increment requires correlating the triggered dominant-after-error-flag events with the number required to cross the threshold, per §8.1.4.2 rule b) counting rules"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: bit detection and error flag completion signals originate from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] REC increment-by-8 on dominant bit after error flag drives when `Error_passive_request` fires at FCE→MAC boundary. Verifying the +8 rule requires constructing a sequence with known starting REC, triggering the dominant-after-error-flag condition, and confirming `Error_passive_request` fires after the correct number of events per §8.1.4.2 rule b) — non-trivial multi-step counter state tracking."

[[requirement]]
id = "REQ-FCE-007"
source_clause = "§8.1.4.2 rule c)"
original_wording = "When a transmitter sends an error flag, the transmit error counter shall be incremented by 8. ; Exception 1: If the transmitter is error-passive and detects an ACK error because of not detecting a dominant ACK and does not detect a dominant bit while sending its passive error flag. ; Exception 2: If the transmitter sends an error flag because a stuff error occurred before the arbitration is decided, whereby the stuff bit should have been recessive, and after it is sent recessive but is monitored to be dominant. ; In exception 1 and in exception 2, the transmit error counter remains unchanged."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as transmitter and fault confinement is active; MAC issues `Error/Overload_flag` to FCE at MAC↔FCE boundary indicating the transmitter sent an error flag"
event = "MAC issues `Error/Overload_flag` to FCE at MAC↔FCE boundary (transmitter sent an error flag); MAC also signals whether exception 1 or exception 2 conditions apply via `Counters_unchanged` or absence thereof"
postcondition = "TEC is incremented by 8 internally unless MAC signals `Counters_unchanged` (exception 1: error-passive ACK error with no dominant during passive error flag, or exception 2: stuff error during arbitration with recessive stuff bit monitored dominant); if TEC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary; if TEC crosses 255, FCE issues `Bus_off_request` to PCS — verifying requires tracking TEC across the error sequence per §8.1.4.2 rule c)"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: three sub-claims: (1) base rule TEC += 8, (2) exception 1 for error-passive ACK error, (3) exception 2 for stuff error during arbitration. EXTERNAL_DEP: error flag sending and error detection signals originate from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] TEC increment rules drive when `Error_passive_request` fires at FCE→MAC and `Bus_off_request` fires at FCE→PCS. Verifying the +8 rule and its exceptions requires constructing specific error sequences, applying `Counters_unchanged` conditions where applicable, and correlating the number of error flag events with the threshold crossing point — non-trivial multi-step counter state tracking per §8.1.4.2 rule c)."

[[requirement]]
id = "REQ-FCE-008"
source_clause = "§8.1.4.2 rule d)"
original_wording = "If a transmitter detects a bit error while sending an active error flag or an overload flag, the transmit error counter shall be incremented by 8."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is transmitting an active error flag or overload flag; fault confinement is active; MAC is monitoring the bus for bit errors during the flag"
event = "MAC issues `Error(bit)` to FCE at MAC↔FCE boundary while transmitting an active error flag or overload flag"
postcondition = "FCE increments TEC by 8 internally; if TEC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary; if TEC crosses 255, FCE issues `Bus_off_request` to PCS — verifying the +8 increment requires correlating bit error events during active error/overload flags with the threshold crossing point per §8.1.4.2 rule d)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: bit error detection during error/overload flag originates from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] TEC increment on `Error(bit)` from MAC during active error/overload flag drives `Error_passive_request` or `Bus_off_request` at FCE boundaries. Verifying the +8 rule requires constructing a sequence where a known number of bit errors during active error flags map to the observed threshold crossing — non-trivial multi-step error sequence construction per §8.1.4.2 rule d)."

[[requirement]]
id = "REQ-FCE-009"
source_clause = "§8.1.4.2 rule e)"
original_wording = "If a receiver detects a bit error while sending an active error flag or an overload flag, the receive error counter shall be incremented by 8."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as receiver and is sending an active error flag or overload flag; fault confinement is active; MAC is monitoring the bus for bit errors during the flag"
event = "MAC issues `Error(bit)` to FCE at MAC↔FCE boundary while the receiver is sending an active error flag or overload flag"
postcondition = "FCE increments REC by 8 internally; if REC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary — verifying the +8 increment requires correlating bit error events during active error/overload flags with the threshold crossing point per §8.1.4.2 rule e)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: bit error detection during error/overload flag originates from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] REC increment on `Error(bit)` from MAC during receiver's active error/overload flag drives `Error_passive_request` at FCE→MAC boundary. Verifying the +8 rule requires constructing a sequence with known starting REC where bit errors during the active error/overload flag map to the observed threshold crossing — non-trivial multi-step error sequence construction per §8.1.4.2 rule e)."

[[requirement]]
id = "REQ-FCE-010"
source_clause = "§8.1.4.2 rule f)"
original_wording = "Any node shall tolerate up to 7 consecutive dominant bits after sending an active error flag, passive error flag, or overload flag. After detecting 14 consecutive dominant bits (in case of an active error flag or an overload flag) or after detecting 8 consecutive dominant bits following a passive error flag, and after each sequence of additional 8 consecutive dominant bits, every transmitter shall increment its transmit error counter by 8 and every receiver shall increment its receive error counter by 8."
shape = "triggered"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node has sent an error flag or overload flag; MAC is monitoring the bus for subsequent dominant bits; fault confinement is active"
event = "MAC signals to FCE (at MAC↔FCE boundary) that 14 consecutive dominant bits are detected after an active error/overload flag, or 8 consecutive dominant bits after a passive error flag, or each subsequent sequence of 8 consecutive dominant bits thereafter"
postcondition = "FCE increments TEC by 8 (transmitter) and REC by 8 (receiver) internally per threshold crossing; if TEC or REC crosses 127, FCE issues `Error_passive_request` to MAC at FCE→MAC boundary; if TEC crosses 255, FCE issues `Bus_off_request` to PCS — verifying the specific +8 increment per threshold sequence requires correlating injected dominant-bit sequences with observed `Error_passive_request` or `Bus_off_request` primitives per §8.1.4.2 rule f)"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: three sub-claims: (1) tolerate up to 7 dominant bits, (2) after 14/8 threshold crossed increment by 8, (3) each additional 8-bit sequence increments by 8. EXTERNAL_DEP: dominant bit detection originates from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] TEC/REC increment-by-8 per dominant bit threshold crossing drives `Error_passive_request` at FCE→MAC and `Bus_off_request` at FCE→PCS. Verifying the 14/8-bit sequence thresholds requires correlating the number of injected dominant-bit sequences post-error-flag with the observed state transitions at FCE boundaries — non-trivial multi-step tracking involving both the dominant bit count and the error counter arithmetic per §8.1.4.2 rule f)."

[[requirement]]
id = "REQ-FCE-011"
source_clause = "§8.1.4.2 rule g)"
original_wording = "After the successful transmission of a frame (getting ACK and no error has been detected until EOF is finished), the transmit error counter shall be decremented by 1 unless it was already 0."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as transmitter and fault confinement is active; MAC has issued `Successful_transfer` to FCE at MAC↔FCE boundary"
event = "MAC issues `Successful_transfer` to FCE at MAC↔FCE boundary (ACK received, no error detected until EOF complete)"
postcondition = "FCE decrements TEC by 1 internally (saturates at 0); if TEC was previously above 127 and drops to ≤127 and REC is also ≤127, FCE issues `Error_active_response` to MAC at FCE→MAC boundary — verifying the -1 decrement requires correlating the number of `Successful_transfer` signals received with the recovery threshold crossing per §8.1.4.2 rule g)"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: successful_transfer signal originates from MAC sub-layer. All four formats share the same decrement rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] TEC decrement on `Successful_transfer` from MAC drives when `Error_active_response` fires at FCE→MAC boundary (recovery from error-passive). Verifying the -1 rule requires constructing a prior error sequence to raise TEC above 127, then issuing sufficient `Successful_transfer` signals and confirming `Error_active_response` fires after the expected number of successes — non-trivial multi-step protocol state tracking per §8.1.4.2 rule g)."

[[requirement]]
id = "REQ-FCE-012"
source_clause = "§8.1.4.2 rule h)"
original_wording = "After the successful reception of a frame (reception without error up to the ACK slot and the successful sending of the ACK bit), the receive error counter shall be decremented by 1 if it was between 1 and 127. If the receive error counter was 0, it shall stay at 0, and if it was greater than 127, then it shall be set to a value between 119 and 127."
shape = "triggered"
scope = "node"
side = "receiver"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is acting as receiver and fault confinement is active; MAC has issued `Successful_transfer` to FCE at MAC↔FCE boundary (reception without error up to ACK slot, ACK sent)"
event = "MAC issues `Successful_transfer` to FCE at MAC↔FCE boundary (successful frame reception confirmed)"
postcondition = "FCE adjusts REC internally per §8.1.4.2 rule h): if REC ∈ [1,127] decrement by 1; if REC = 0 keep at 0; if REC > 127 set to value in [119,127]; if both TEC and REC drop to ≤127, FCE issues `Error_active_response` to MAC at FCE→MAC boundary — verifying the range-dependent decrement rule requires constructing scenarios with REC in each range and correlating the observed `Error_active_response` with the expected crossing point"
flags = ["COMPOUND", "EXTERNAL_DEP"]
notes = "COMPOUND: three sub-claims depending on REC range: (1) REC in [1,127] → decrement by 1, (2) REC = 0 → stays 0, (3) REC > 127 → set to [119,127]. EXTERNAL_DEP: successful_transfer signal originates from MAC sub-layer. All four formats share the same rule."
label = ""
file = ""

# ── §8.1.4.3 Transition between error-active and error-passive states ──
observability = "derived"
observability_rationale = "[Rule 2] REC decrement/saturation on `Successful_transfer` from MAC drives when `Error_active_response` fires at FCE→MAC boundary. Verifying the three-branch rule (REC in [1,127] / REC=0 / REC>127) requires constructing scenarios with known starting REC in each branch and confirming `Error_active_response` fires at the expected point — non-trivial multi-step counter state tracking per §8.1.4.2 rule h)."

[[requirement]]
id = "REQ-FCE-013"
source_clause = "§8.1.4.3"
original_wording = "If the transmit error counter or the receive error counter of a node exceeds 127 (carry condition in case of a 7-bit receive error counter) then the supervisor shall request the MAC sub-layer to set the corresponding node into the error-passive state."
shape = "triggered"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is in error-active state and fault confinement is active; FCE has been accumulating TEC or REC increments from `Error(type)` signals at MAC↔FCE boundary"
event = "Internal TEC or REC counter crosses 127 following a MAC→FCE `Error(type)` signal at MAC↔FCE boundary"
postcondition = "FCE issues `Error_passive_request` to MAC at FCE→MAC boundary; verifying the exact threshold (>127) requires correlating the number of `Error(type)` signals received with the §8.1.4.2 counting rules to predict the precise error that triggers the transition"
flags = []
notes = "The carry condition note applies to implementations using a 7-bit receive error counter. All four formats share the same threshold and transition."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The counter threshold (TEC or REC > 127) is internal to the FCE. The transition to error-passive is observable at the MAC↔FCE boundary via `Error_passive_request`. Verifying the exact threshold requires correlating the injected `Error(type)` sequence count with the observed `Error_passive_request` firing point per §8.1.4.3 — non-trivial multi-step counter state tracking."

[[requirement]]
id = "REQ-FCE-014"
source_clause = "§8.1.4.3"
original_wording = "An error-passive node shall become error-active again when both the transmit error counter and the receive error counter are less than or equal to 127 (see Figure 43)."
shape = "triggered"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is in error-passive state; FCE has been receiving `Successful_transfer` signals from MAC at MAC↔FCE boundary, decrementing TEC and REC per §8.1.4.2 rules"
event = "Internal TEC and REC both drop to ≤127 following `Successful_transfer` signals from MAC at MAC↔FCE boundary"
postcondition = "FCE issues `Error_active_response` to MAC at FCE→MAC boundary; verifying the recovery threshold (both TEC ≤127 and REC ≤127) requires correlating the number of `Successful_transfer` signals received with the §8.1.4.2 decrement rules to predict the precise success that triggers the transition"
flags = []
notes = "Recovery from error-passive requires both counters below threshold simultaneously. All four formats share the same rule."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The recovery threshold (both TEC ≤127 and REC ≤127) is internal to the FCE. Recovery to error-active is observable at the MAC↔FCE boundary via `Error_active_response`. Verifying the exact recovery threshold requires correlating the `Successful_transfer` sequence count with the observed `Error_active_response` firing point per §8.1.4.3 — non-trivial multi-step counter state tracking."

[[requirement]]
id = "REQ-FCE-015"
source_clause = "§8.1.4.3"
original_wording = "When the receive error counter of a node exceeds the error-passive limit of 127, further increments of this receive error counter shall be limited by the width of the counter."
shape = "invariant"
scope = "node"
side = "receiver"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "REC > 127 and fault confinement is active"
postcondition = "Further REC increments are limited by the counter width (no overflow beyond maximum representable value)"
flags = []
notes = "Prevents REC overflow — the counter saturates at its maximum value (e.g. 255 for an 8-bit counter). All four formats share the same rule."
label = ""
file = ""
observability = "internal"
observability_rationale = "Counter saturation/overflow capping is purely about internal counter width. No state transition at any FCE boundary results from saturation itself — the node remains in error-passive regardless. [Rule 3 — no boundary effect]"

[[requirement]]
id = "REQ-FCE-016"
source_clause = "§8.1.4.4"
original_wording = "If the transmit error counter of a node is greater than 255 (carry condition in case of an 8-bit transmit error counter) then the supervisor shall request the PL to set the node into the bus-off state."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is in error-passive state and fault confinement is active; FCE has been accumulating TEC increments from `Error/Overload_flag` signals at MAC↔FCE boundary"
event = "Internal TEC counter crosses 255 following a MAC→FCE signal at MAC↔FCE boundary"
postcondition = "FCE issues `Bus_off_request` to PCS at FCE↔PCS boundary; FCE also issues `Bus_off` to LLC at LLC↔FCE boundary; verifying the exact threshold (TEC > 255) requires correlating the `Error/Overload_flag` signal count with the §8.1.4.2 counting rules to predict the precise error that triggers the bus-off transition"
flags = []
notes = "The carry condition note applies to implementations using an 8-bit TEC. All four formats share the same bus-off threshold."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] The TEC threshold (>255) is internal to the FCE. Bus-off entry is observable at the FCE↔PCS boundary via `Bus_off_request` and at the LLC↔FCE boundary via `Bus_off`. Verifying the exact threshold requires correlating the injected transmit error sequence count with the observed `Bus_off_request` firing point per §8.1.4.4 — non-trivial multi-step counter state tracking."

[[requirement]]
id = "REQ-FCE-017"
source_clause = "§8.1.4.4"
original_wording = "A node which is in the bus-off state shall have no influence on the bus."
shape = "invariant"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is in bus-off state; FCE has issued `Bus_off_request` to PCS at FCE↔PCS boundary and received `Bus_off_response` from PCS"
postcondition = "The node drives no bits (neither dominant nor recessive) on the bus; PCS ceases all `PCS_Data.Request(Output_Unit)` activity; the testbench observes no driven output on the bus while the node remains in bus-off state"
flags = []
notes = "Fundamental bus-off isolation rule. All four formats share the same bus-off behaviour."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] Directly observable at the PCS↔FCE boundary: after `Bus_off_request` from FCE and `Bus_off_response` from PCS, the node drives no bits via `PCS_Data.Request(Output_Unit)`. The testbench verifies bus-off isolation by monitoring for complete absence of any driven output on the bus while bus-off state persists."

[[requirement]]
id = "REQ-FCE-018"
source_clause = "§8.1.4.4"
original_wording = "Upon a restart request, a node which is in the bus-off state shall be re-integrating to the CAN communication (see 6.6.7.5) and may become error-active (no longer bus-off) with its error counters both set to zero after having monitored 128 occurrences of the idle condition (see 3.34) on the bus."
shape = "liveness"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Node is in bus-off state; PCS has issued `Bus_off_release_request` to FCE at PCS↔FCE boundary following a restart request"
postcondition = "After FCE receives `Bus_off_release_response` from PCS at PCS↔FCE boundary confirming 128 occurrences of the idle condition (11 consecutive recessive bits), FCE issues `Error_active_response` to MAC at FCE→MAC boundary with TEC = 0 and REC = 0; verifying the 128-idle-sequence count requires monitoring PCS_Data.Indicate(Input_Unit) at the MAC↔PCS boundary for 128 × 11 consecutive recessive bit sequences before `Error_active_response` fires"
flags = ["EXTERNAL_DEP"]
notes = "Liveness: the standard says the node 'shall be re-integrating' and 'may become error-active' — eventual recovery without a fixed cycle deadline. EXTERNAL_DEP: re-integration procedure references MAC §6.6.7.5 and idle condition definition §3.34. All four formats share the same bus-off recovery."
label = ""
file = ""

# ── §8.1.5 Node start-up ──
observability = "derived"
observability_rationale = "[Rule 2] Bus-off recovery (node resumes participation) is observable at the FCE→MAC boundary via `Error_active_response`, but verifying the 128-idle-sequence threshold requires counting 128 occurrences of 11 consecutive recessive bits on `PCS_Data.Indicate(Input_Unit)` before `Error_active_response` fires — non-trivial multi-step internal recovery counter tracking per §8.1.4.4."

[[requirement]]
id = "REQ-FCE-019"
source_clause = "§8.1.5"
original_wording = "If during network start-up only one node is online and if this node transmits any DF or RF, it does not get an ACK. In this case, it shall detect an error and repeat the frame. ; According to rule c) in 8.1.4.2, exception 1, it may become error-passive but shall not go bus-off."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "Only one node is online during network start-up; node transmits a DF or RF and receives no dominant ACK (no other node present); MAC issues `Error(ACK)` to FCE at MAC↔FCE boundary"
postcondition = "MAC detects ACK error and re-initiates the frame (observable via repeated `L_Data.Confirm(Transfer_Status=Disturbed)` then `L_Data.Confirm(Transfer_Status=Ongoing)` at LLC↔User boundary); FCE applies rule c) exception 1 (`Counters_unchanged`) so TEC does not increment; the node may become error-passive (TEC rises via other rules) but `Bus_off_request` is never issued at FCE↔PCS boundary — verifying requires tracking TEC trajectory across the repeated ACK error sequence and confirming the bus-off threshold is never crossed"
flags = ["COMPOUND"]
notes = "COMPOUND: two sub-claims: (1) the lone node detects error and repeats frame, (2) the node shall not go bus-off (protected by rule c exception 1). All four formats share the same start-up behaviour."
label = ""
file = ""
observability = "derived"
observability_rationale = "[Rule 2] Frame repetition is observable via `L_Data.Confirm(Transfer_Status=Disturbed then Ongoing)` at LLC↔User boundary; the bus-off prohibition requires deriving that TEC stays ≤255 despite repeated ACK errors, which depends on the internal rule c) exception 1 `Counters_unchanged` counter arithmetic — non-trivial multi-step protocol state tracking per §8.1.4.2 exception 1 and §8.1.5."

[[requirement]]
id = "REQ-FCE-020"
source_clause = "§8.1.5"
original_wording = "When a switched-off node is switched on again, it shall: synchronize with already available nodes to re-integrate into the bus communication (see 6.6.7.5) before starting to transmit. ; Synchronization is achieved when 11 recessive bits have been detected that are equivalent to ACK delimiter + EOF + intermission or Error/Overload delimiter + intermission."
shape = "triggered"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "A previously switched-off node has been switched on (power-up or reset released); the bus may already have active nodes transmitting frames"
event = "Node power-on or reset release; PCS begins monitoring `PCS_Data.Indicate(Input_Unit)` at PCS↔MAC boundary for the synchronization condition"
postcondition = "The node does not initiate any `PCS_Data.Request(Output_Unit)` until 11 consecutive recessive bits have been detected on `PCS_Data.Indicate(Input_Unit)` (equivalent to ACK delimiter + EOF + intermission or Error/Overload delimiter + intermission); after synchronisation, the node may begin transmitting"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: re-integration references MAC §6.6.7.5 bus synchronisation. The 11 recessive bits correspond to ACK delimiter + EOF + intermission. All four formats share the same start-up rule."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] Directly observable at the PCS boundary: the node does not issue any `PCS_Data.Request(Output_Unit)` until 11 consecutive recessive bits appear on `PCS_Data.Indicate(Input_Unit)`. The testbench verifies by monitoring bus activity and confirming the node remains silent until the synchronisation condition is met, then begins driving."

[[requirement]]
id = "REQ-FCE-021"
source_clause = "§8.1.5"
original_wording = "When a switched-off node is switched on again, it shall: wait for other nodes if there is no other node available at the moment without becoming bus-off."
shape = "invariant"
scope = "node"
side = "both"
layer = "FCE"
format_applicability = "CB, CE, FB, FE"
precondition = "A previously switched-off node has been switched on; no other nodes are present on the bus at the time of power-on"
postcondition = "The node does not initiate any `PCS_Data.Request(Output_Unit)` and does not issue `Bus_off_request` at FCE↔PCS boundary; the node remains idle (monitoring `PCS_Data.Indicate(Input_Unit)`) waiting for bus activity without entering bus-off state"
flags = []
notes = "Prevents bus-off during initial start-up when no other nodes are available. All four formats share the same start-up rule."
label = ""
file = ""

