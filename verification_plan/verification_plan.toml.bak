# CAN Verification Plan — ISO 11898-1:2024
# ISO-aligned shape/scope/layer taxonomy.

# SECTION: §6.4 + §6.5 — LLC sub-layer
# ============================================================
# ============================================================
# === SECTION INVENTORY: §6.4 + §6.5 — LLC sub-layer (layer = LLC) ===
# Subsections covered: §6.4.1, §6.4.2, §6.4.3, §6.4.4, §6.4.5.1, §6.4.5.2,
#   §6.4.5.3, §6.4.5.4, §6.4.5.5.1, §6.4.5.5.2, §6.4.5.5.3, §6.4.5.5.4,
#   §6.4.5.5.5, §6.5.1, §6.5.2, §6.5.3, §6.5.4, §6.5.5, §6.5.6, §6.5.7
# Requirement count lower bound: 30
# Cross-section dependencies noted:
#   - §6.5.6 Transfer_Status reporting references MAC sub-layer transmission outcomes
#   - §6.5.7 Time-stamping references MAC sub-layer time reference points (§6.6.3)
#   - §6.5.5 Overload notification references OF (defined in MAC §6.6.6)
#   - §6.5.2 Re-arbitration references bus arbitration (MAC §6.6.7)
# ===

# ── §6.4.1 Overview ──

[[requirement]]
id = "REQ-LLC-001"
source_clause = "§6.4.3"
original_wording = "The LLC frame structure shall contain all content needed for all CAN frame formats and types, including the selection of a specific CAN frame format. ; In the interaction between the LLC sub-layer and the MAC sub-layer, the content of that parts of the LLC frame that are not used for the selected CAN frame format shall be ignored."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An LLC frame is being constructed or transferred to MAC"
postcondition = "The LLC frame contains all fields from Table 4; unused fields for the selected format are ignored by the MAC sub-layer"
flags = ["DOC_ONLY", "COMPOUND"]
notes = "COMPOUND: (1) LLC frame shall contain all content for all formats; (2) unused fields shall be ignored. DOC_ONLY because compliance requires inspecting the frame data structure definition, not a runtime signal. All four in-scope formats are covered by the single LLC frame structure."
label = ""
file = ""

# ── §6.4.4 Limited LLC frames ──
observability = "internal"
observability_rationale = "Structural definition of LLC frame content. DOC_ONLY — defines what fields exist, not a testable behaviour. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-LLC-002"
source_clause = "§6.4.4"
original_wording = "If an LLC sub-layer is restricted to the use of a sub-range of identifiers (e.g. only 11-bit identifiers), then it shall be limited to LLC DFs and LLC RFs with identifiers of that sub-range."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is configured with a restricted identifier sub-range (e.g. only 11-bit base IDs); an LLC frame SDU + Handle is ready for transmission or a frame has been received"
postcondition = "For TX: `L_Data.Confirm(Transfer_Status=Disturbed, Handle)` is issued at LLC↔User boundary for frames with out-of-range identifiers (they are not passed to MAC); for RX: `L_Data.Indication` is not issued for frames with identifiers outside the configured sub-range"
flags = []
notes = "Assertable at the LLC acceptance filter boundary. If the node only supports 11-bit IDs, frames with IDE=1 shall not pass. All four formats may be affected depending on the restriction."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] Postcondition observable at LLC↔User boundary: absence of `L_Data.Indication` for filtered RX frames, and `L_Data.Confirm(Transfer_Status)` reporting rejection for out-of-range TX identifiers. Both are named primitive parameters at the LLC↔User boundary per §6.4.5."

[[requirement]]
id = "REQ-LLC-003"
source_clause = "§6.4.4"
original_wording = "If an LLC sub-layer is restricted to the use of less than the maximum number of data bytes, then it shall be limited to LLC DFs with several data bytes of that restricted range. ; If the DLC indicates a higher number of data bytes, the data bytes beyond the restricted range shall be replaced in the LLC DF by bytes with the value of CCHEX ('padding') both for received and for transmitted frames."
shape = "invariant"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "The LLC sub-layer is configured with a restricted maximum data byte count; an LLC frame SDU + Handle with DLC indicating more data bytes than the restricted range has been submitted via `L_Data.Request(Frame, Handle)` at LLC↔User boundary"
postcondition = "For TX: the Frame parameter in the MAC SDU has data bytes beyond the restriction replaced with 0xCC; `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` is issued at LLC↔User boundary after MAC completes the padded frame; for RX: `L_Data.Indication(Frame, Timestamp)` at LLC↔User boundary delivers the received frame with excess bytes replaced by 0xCC"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) LLC shall be limited to DFs within restricted data byte range; (2) excess bytes shall be padded with 0xCC. The padding behavior is independently assertable. All four formats may carry data payloads subject to this rule."
label = ""
file = ""

# ── §6.4.5.1 Service access points — no normative requirements ──
# ── §6.4.5.2 Types of connectionless-mode transmission services ──
observability = "external"
observability_rationale = "[Rule 1a] Padding behavior is observable at LLC↔User boundary via the Frame parameter in `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` for TX and in `L_Data.Indication(Frame, Timestamp)` for RX; excess bytes must contain 0xCC, which is directly inspectable as a named parameter of these primitives per §6.4.4."

[[requirement]]
id = "REQ-LLC-004"
source_clause = "§6.4.5.2"
original_wording = "The remote node shall serve the data request in the following two ways."
shape = "invariant"
scope = "bus"
side = "both"
layer = "LLC"
format_applicability = "CB, CE"
precondition = "A remote data request (LLC RF) has been received by a remote node"
postcondition = "The remote node serves the request either by preparing data for transmission or by transmitting upon reception of the request frame"
flags = ["DOC_ONLY", "AMBIGUOUS"]
notes = "AMBIGUOUS scope: assigned bus because the requirement describes interaction between two nodes (requester and remote). However, from a single-node perspective, this could be node-scope (the remote node's response to an RF). Assigned bus as the more conservative choice. DOC_ONLY because the two response modes are implementation choices, not independently assertable behaviors. Only CB and CE support remote frames."
label = ""
file = ""
observability = "internal"
observability_rationale = "Describes how a remote node serves data requests. DOC_ONLY, AMBIGUOUS — defines protocol behaviour conceptually, not a testable single-node postcondition. [Rule 3 — structural definition]"

[[requirement]]
id = "REQ-LLC-005"
source_clause = "§6.4.5.2"
original_wording = "In both cases, the LLC sub-layer shall notify the successful transmission or reception of a DF or RF to the LLC user."
shape = "triggered"
scope = "node"
side = "both"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A DF or RF transmission or reception has completed; MAC has signalled the outcome (via Transfer_Status + Timestamp + Handle for TX, or received LLC frame + Timestamp for RX) to LLC at the MAC↔LLC boundary"
event = "MAC delivers Transfer_Status=`Transmitted` + Timestamp + Handle to LLC (TX path), or MAC delivers received LLC frame + Timestamp to LLC (RX path)"
postcondition = "For TX: LLC issues `L_Data.Confirm(Transfer_Status=Transmitted, Timestamp, Handle)` to LLC User at LLC↔User boundary; for RX: LLC issues `L_Data.Indication(Frame, Timestamp)` to LLC User at LLC↔User boundary"
flags = ["EXTERNAL_DEP"]
notes = "The event (successful completion) originates from the MAC sub-layer. EXTERNAL_DEP because the trigger depends on MAC transfer status. All four in-scope formats require this notification. RF applies only to CB and CE, but DF notification applies to all four."
label = ""
file = ""

# ── §6.4.5.3 — Format description: no normative requirements (definitional) ──
# ── §6.4.5.4 — Types of services: no normative requirements (definitional) ──
# ── §6.4.5.5.1 — General: no normative requirements (cross-reference to Tables 6, 7) ──

# ── §6.4.5.5.2 L_Data.Request ──
observability = "external"
observability_rationale = "[Rule 1a] `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` and `L_Data.Indication(Frame, Timestamp)` are named primitives at the LLC↔User boundary with Transfer_Status and Timestamp as directly inspectable parameters per ISO §6.4.5."

[[requirement]]
id = "REQ-LLC-006"
source_clause = "§6.4.5.5.2"
original_wording = "Receipt of this service shall cause the LLC sub-layer to initiate the transfer of an LLC frame by use of the data transfer service provided by the MAC sub-layer (see 6.6)."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "LLC sub-layer is operational; a valid LLC frame SDU + Handle is available from LLC User for transmission"
event = "`L_Data.Request(Frame, Handle)` is issued by LLC User at LLC↔User boundary"
postcondition = "LLC passes the LLC frame SDU + Handle to MAC for encapsulation and transmission via the MAC data transfer service (§6.6); MAC eventually returns Transfer_Status + Timestamp + Handle to LLC, which then issues `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` to LLC User at LLC↔User boundary"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: postcondition involves invoking the MAC sub-layer service (§6.6). The initiation of transfer is assertable as a handshake to the MAC layer. All four formats use the same initiation path."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] `L_Data.Request(Frame, Handle)` is a named primitive at the LLC↔User boundary; MAC frame transfer initiation is observable as `PCS_Data.Request(Output_Unit)` at MAC↔PCS boundary; the eventual `L_Data.Confirm(Transfer_Status, Timestamp, Handle)` at LLC↔User boundary confirms the handoff was completed per ISO §6.4.5.5.2."

[[requirement]]
id = "REQ-LLC-007"
source_clause = "§6.4.5.5.2"
original_wording = "Any L_Data.Request shall be processed not later than the second SOF after the request when there are no EFs present during this time."
shape = "liveness"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.Request has been received by the LLC sub-layer and no error frames occur between request and processing"
postcondition = "The request is processed (transfer initiated or queued) before the second SOF following the request"
flags = []
notes = "Liveness with a practical bound: 'not later than the second SOF'. This is not a fixed cycle count — the SOF timing depends on bus activity. Testbench can impose a timeout based on worst-case inter-frame spacing. All four formats share the same timing obligation."
label = ""
file = ""

# ── §6.4.5.5.3 L_Data.AbortRequest ──
observability = "derived"
observability_rationale = "SOF timing observable at MAC↔PCS boundary (PCS_Data.Request). But verifying the 2-SOF deadline requires understanding bus idle timing and inter-frame spacing — multi-step protocol state tracking. [Rule 2]"

[[requirement]]
id = "REQ-LLC-008"
source_clause = "§6.4.5.5.3"
original_wording = "Receipt of this service shall cause the LLC sub-layer to abort the transfer of an LLC frame in the specified LLC storage unit."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A pending or active LLC frame transmission exists for the specified Handle; the LLC frame SDU + Handle has been submitted via `L_Data.Request(Frame, Handle)` at LLC↔User boundary"
event = "`L_Data.AbortRequest(Handle)` is issued by LLC User at LLC↔User boundary"
postcondition = "LLC sub-layer marks the specified transmission for abortion; eventually `L_Data.Confirm(Transfer_Status=Aborted, Timestamp, Handle)` is issued at LLC↔User boundary (subject to deferral rules per REQ-LLC-009)"
flags = []
notes = "The actual abortion may be deferred per REQ-LLC-009; this requirement covers the immediate effect of receiving the abort primitive. All four formats use the same abort mechanism."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] `L_Data.AbortRequest(Handle)` is a named primitive at LLC↔User boundary; the effect is observable via `L_Data.Confirm(Transfer_Status=Aborted, Timestamp, Handle)` at LLC↔User boundary, where Transfer_Status=Aborted is a directly inspectable named parameter per ISO §6.4.5.5.3."

[[requirement]]
id = "REQ-LLC-009"
source_clause = "§6.4.5.5.3"
original_wording = "Pending transmissions, which are already passed to the MAC sub-layer, shall only be aborted if: an error in the MAC sub-layer during transmission occurs, or arbitration was lost in the MAC sub-layer, which causes the LLC frame to wait for another transmission attempt. ; This means that an abortion request shall be kept pending in the LLC layer until either one of the above situations occur, or until the transmission was completed."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An `L_Data.AbortRequest(Handle)` has been received at LLC↔User boundary for a transmission that has already been passed to the MAC sub-layer (MAC is actively transmitting or pending arbitration)"
postcondition = "The abort is deferred: `L_Data.Confirm(Transfer_Status=Aborted, Timestamp, Handle)` is issued at LLC↔User boundary only after (a) MAC reports an error (Transfer_Status=Disturbed), (b) MAC reports arbitration loss (Transfer_Status=Lost_Arbitration), or (c) MAC reports successful completion (Transfer_Status=Transmitted); the abort request remains pending in LLC until one of these Transfer_Status values is delivered from MAC"
flags = ["EXTERNAL_DEP", "COMPOUND"]
notes = "COMPOUND: (1) abort only on MAC error or arbitration loss; (2) abort request kept pending until condition met. EXTERNAL_DEP: depends on MAC sub-layer error/arbitration status. All four formats share the same abort deferral logic."
label = ""
file = ""
observability = "external"
observability_rationale = "[Rule 1a] Deferred abort timing is observable via the sequence of `L_Data.Confirm(Transfer_Status)` values at LLC↔User boundary: the abort does not produce Transfer_Status=Aborted immediately; it waits for Transfer_Status=Disturbed, Lost_Arbitration, or Transmitted first. All Transfer_Status values are named parameters of `L_Data.Confirm` at the LLC↔User boundary per ISO §6.4.5.5.3."

[[requirement]]
id = "REQ-LLC-010"
source_clause = "§6.4.5.5.3"
original_wording = "Any L_Data.AbortRequest shall be processed prior to the second SOF after the request when there are no EFs present during this time. ; Any L_Data.AbortRequest shall be processed prior to the third SOF after the request when there are EFs present during this time."
shape = "liveness"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "An L_Data.AbortRequest has been received by the LLC sub-layer"
postcondition = "The abort request is processed prior to the second SOF (no EFs) or the third SOF (with EFs) after the request"
flags = ["COMPOUND"]
notes = "COMPOUND: two distinct timing bounds depending on whether error frames are present. Liveness with SOF-based practical bounds. Testbench imposes timeout based on worst-case inter-frame spacing. All four formats share the same timing obligation."
label = ""
file = ""

# ── §6.4.5.5.4 L_Data.Confirm ──
observability = "derived"
observability_rationale = "SOF timing observable at MAC↔PCS boundary, but verifying the 2-SOF deadline with/without error frames requires multi-step protocol state tracking. [Rule 2]"

[[requirement]]
id = "REQ-LLC-011"
source_clause = "§6.5.2"
original_wording = "The transmission of frames losing bus arbitration shall be restarted by the LLC entity unless the transmission of that frame is aborted by the LLC user."
shape = "triggered"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame transmission is in progress; LLC User has not issued `L_Data.AbortRequest(Handle)` for this frame; LLC has received `L_Data.Confirm(Transfer_Status=Lost_Arbitration, Handle)` back from MAC at MAC↔LLC boundary"
event = "MAC delivers Transfer_Status=`Lost_Arbitration` + Handle to LLC at MAC↔LLC boundary"
postcondition = "LLC re-submits the LLC frame SDU + Handle to MAC for re-arbitration (re-transmission); `L_Data.Confirm(Transfer_Status=Lost_Arbitration, Timestamp, Handle)` is issued to LLC User at LLC↔User boundary to report the loss, followed by `L_Data.Confirm(Transfer_Status=Ongoing, ...)` when the re-transmission begins"
flags = ["EXTERNAL_DEP"]
notes = "EXTERNAL_DEP: the arbitration loss event originates from the MAC sub-layer. The restart is called 're-arbitration'. All four formats participate in bus arbitration and are subject to this rule."
label = ""
file = ""

# ── §6.5.3 Flow control on retransmission ──
observability = "external"
observability_rationale = "[Rule 1a] Re-arbitration is observable via the Transfer_Status sequence at LLC↔User boundary: `L_Data.Confirm(Transfer_Status=Lost_Arbitration)` followed by `L_Data.Confirm(Transfer_Status=Ongoing)` when re-transmission begins. Transfer_Status is a named parameter of `L_Data.Confirm` at LLC↔User boundary per ISO §6.5.2."

[[requirement]]
id = "REQ-LLC-012"
source_clause = "§6.5.3"
original_wording = "The retransmission of frames that are not aborted by the LLC user shall be attempted for the configured specific number of times. ; Retransmission attempts shall be counted in the retransmission counter."
shape = "invariant"
scope = "node"
side = "transmitter"
layer = "LLC"
format_applicability = "CB, CE, FB, FE"
precondition = "A frame transmission has failed (for reasons other than arbitration loss) and the frame is not aborted by the LLC user"
postcondition = "Retransmission is attempted up to the configured number of times, with each attempt counted in the retransmission counter"
flags = ["COMPOUND"]
notes = "COMPOUND: (1) retransmission attempted for configured number of times; (2) attempts counted in retransmission counter. The configured range is 0 (no retransmission) to at least 6, with optional unlimited. All four formats share the same retransmission logic."
label = ""
file = ""

